    activate                    true
    cameraFrame                 "head_camera"
    fx                          611.864502
    fy                          611.478271
    cx                          638.961182
    cy                          363.642456
    width                       1280
    height                      720
    horizontalDeadbandDeg       10.0
    verticalDeadbandDeg         10.0
    muAlignmentHorizontal       1.0
    muAlignmentVertical         0.0
    muFront                     1.0
    minDepth                    0.3
}
