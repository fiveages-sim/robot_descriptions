<?xml version="1.0"?>
<!-- =================================================================================== -->
<!-- |    Ai2 Bot2 Full Robot (visualization)                                           | -->
<!-- |    Used by robot_common_launch manipulator.launch.py (xacro_filename=robot.xacro)| -->
<!-- |    Structure : base_link (chassis) -> body ->                                    | -->
<!-- |    body_link4; arm_base / ego / arms attach to body_link4; head after arms.      | -->
<!-- |    topology:=dual : split-body planning tree rooted at arm_base.                 | -->
<!-- =================================================================================== -->
<robot name="Ai2_Bot2" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="type" default=""/>
  <xacro:arg name="topology" default="full"/>
  <xacro:arg name="isaac" default="false"/>
  <xacro:arg name="eef_fixed_joints" default="false"/>
  <xacro:arg name="left_tcp_offset_xyz" default="0 0 0"/>
  <xacro:arg name="left_tcp_offset_rpy" default="0 0 0"/>
  <xacro:arg name="right_tcp_offset_xyz" default="0 0 0"/>
  <xacro:arg name="right_tcp_offset_rpy" default="0 0 0"/>
  <xacro:property name="type_arg" value="$(arg type)"/>
  <xacro:property name="topology_arg" value="$(arg topology)"/>
  <xacro:property name="selected_gripper_type" value=""/>
  <xacro:property name="arm_add_eef" value="true"/>

  <xacro:if value="${type_arg == 'inspire'}">
    <xacro:property name="selected_gripper_type" value="inspire_eg2"/>
    <xacro:property name="arm_add_eef" value="false"/>
  </xacro:if>

  <xacro:include filename="$(find ai2_bot2_description)/xacro/components/arm.xacro"/>

  <xacro:macro name="Ai2Bot2ArmsAndGrippers" params="parent_link">
    <xacro:Ai2Bot2Arm name="left" parent_link="${parent_link}" direction="1"
        add_eef="${arm_add_eef}"
        isaac="$(arg isaac)"
        tcp_offset_xyz="$(arg left_tcp_offset_xyz)"
        tcp_offset_rpy="$(arg left_tcp_offset_rpy)"/>
    <xacro:Ai2Bot2Arm name="right" parent_link="${parent_link}" direction="-1"
        add_eef="${arm_add_eef}"
        isaac="$(arg isaac)"
        tcp_offset_xyz="$(arg right_tcp_offset_xyz)"
        tcp_offset_rpy="$(arg right_tcp_offset_rpy)"/>

    <xacro:if value="${selected_gripper_type == 'inspire_eg2'}">
      <xacro:include filename="$(find inspire_description)/xacro/EG2-4C2.xacro"/>

      <xacro:Gripper name="left"/>
      <joint name="left_gripper_mount" type="fixed">
        <parent link="left_tcp"/>
        <child link="left_gripper_base"/>
        <origin xyz="0 0 0" rpy="0 0 1.5708"/>
      </joint>

      <xacro:Gripper name="right"/>
      <joint name="right_gripper_mount" type="fixed">
        <parent link="right_tcp"/>
        <child link="right_gripper_base"/>
        <origin xyz="0 0 0" rpy="0 0 1.5708"/>
      </joint>
    </xacro:if>
  </xacro:macro>

  <!-- Split-body OCS2: dual-arm tree, root coinciding with arm_base (same mount as body_link4). -->
  <xacro:if value="${topology_arg == 'dual'}">
    <link name="base_link"/>
    <link name="arm_base"/>
    <joint name="arm_base_joint" type="fixed">
      <parent link="base_link"/>
      <child link="arm_base"/>
    </joint>
    <xacro:Ai2Bot2ArmsAndGrippers parent_link="arm_base"/>
  </xacro:if>

  <xacro:unless value="${topology_arg == 'dual'}">
    <xacro:include filename="$(find ai2_bot2_description)/xacro/components/chassis.xacro"/>
    <xacro:include filename="$(find ai2_bot2_description)/xacro/components/body.xacro"/>

    <xacro:Ai2Bot2Chassis/>
    <xacro:Ai2Bot2Body parent_link="base_link" isaac="$(arg isaac)"/>

    <!-- coinciding with body_link4 so split FK in arm_base matches the live torso TF -->
    <link name="arm_base"/>
    <joint name="arm_base_joint" type="fixed">
      <parent link="body_link4"/>
      <child link="arm_base"/>
    </joint>

    <link name="ego"/>
    <joint name="ego_joint" type="fixed">
      <origin xyz="-0.061 0 0.3255" rpy="0 0 0"/>
      <parent link="body_link4"/>
      <child link="ego"/>
    </joint>

    <xacro:Ai2Bot2ArmsAndGrippers parent_link="arm_base"/>
    <xacro:Ai2Bot2Head parent_link="body_link4" isaac="$(arg isaac)"/>
  </xacro:unless>

</robot>
