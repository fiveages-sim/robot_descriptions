            (5,0)  1.07         ; left_joint2
            (6,0)  1.07         ; left_joint3
            (7,0)  1.07         ; left_joint4
            (8,0)  1.07         ; left_joint5
            (9,0)  1.07         ; left_joint6
            (10,0) 1.07         ; left_joint7
            (11,0) 1.07         ; right_joint1
            (12,0) 1.07         ; right_joint2
            (13,0) 1.07         ; right_joint3
            (14,0) 1.07         ; right_joint4
            (15,0) 1.07         ; right_joint5
            (16,0) 1.07         ; right_joint6
            (17,0) 1.07         ; right_joint7
            (18,0) 1.5          ; head_joint1
