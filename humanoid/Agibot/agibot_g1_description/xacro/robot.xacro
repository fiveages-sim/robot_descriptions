<?xml version="1.0" ?>
<!-- =================================================================================== -->
<!-- |    Complete Robot Description for Agibot G1                                     | -->
<!-- |    This file includes the base robot structure and both arms                    | -->
<!-- =================================================================================== -->
<robot name="Agibot G1" xmlns:xacro="http://www.ros.org/wiki/xacro">

	<xacro:arg name="type" default="AG2F120S"/>
	<!-- false: ros2_control / 可视化默认可驱动夹爪；OCS2 planning 由 robot_common_launch 注入 eef_fixed_joints:=true -->
	<xacro:arg name="eef_fixed_joints" default="false"/>
	<xacro:property name="eef_fixed" value="$(arg eef_fixed_joints)"/>

	<!-- Include the base robot structure -->
	<xacro:include filename="$(find agibot_g1_description)/xacro/g1_base.xacro"/>

	<!-- Include arm macro -->
	<xacro:include filename="$(find agibot_g1_description)/xacro/g1_arm.xacro"/>

	<!-- Generate left and right arms using macro -->
	<xacro:G1Arm name="left"/>
	<xacro:G1Arm name="right" direction="-1"/>

	<!-- Arm base links -->
	<link name="arm_base"/>

	<!-- Arm base joints -->
	<joint name="arm_base_joint" type="fixed">
		<parent link="body_link2"/>
		<child link="arm_base"/>
		<origin rpy="1.5707963267948966 0.0 0.0" xyz="0.0 -0.305 0.0"/>
	</joint>

	<joint name="left_base_joint" type="fixed">
		<parent link="arm_base"/>
		<child link="left_base_link"/>
		<origin rpy="-1.5707963267948966 0.0 0.0" xyz="0.0 0.025 0.0"/>
	</joint>

	<joint name="right_base_joint" type="fixed">
		<parent link="arm_base"/>
		<child link="right_base_link"/>
		<origin rpy="-1.5707963267948966 0.0 3.141592653589793" xyz="0.0 -0.025 0.0"/>
	</joint>

	<xacro:if value="${'$(arg type)' == 'AG2F120S'}">
		<!-- Include gripper -->
		<xacro:include filename="$(find changingtek_description)/xacro/AG2F120S.xacro"/>
		<xacro:AG2F120S name="left" kinematic_only="${eef_fixed}"/>
		<xacro:AG2F120S name="right" kinematic_only="${eef_fixed}"/>

		<!-- Gripper joints -->
		<joint name="ee_left_joint" type="fixed">
			<origin xyz="0 0 0.027727" rpy="0 0 3.1415"/>
			<parent link="left_end_link"/>
			<child link="left_gripper_base"/>
		</joint>

		<joint name="ee_right_joint" type="fixed">
			<origin xyz="0 0 0.027727" rpy="0 0 3.1415"/>
			<parent link="right_end_link"/>
			<child link="right_gripper_base"/>
		</joint>

		<xacro:include filename="$(find agibot_g1_description)/xacro/120s_camera_stand.xacro"/>
		<xacro:Camera name="left"/>
		<xacro:Camera name="right"/>
	</xacro:if>

	<xacro:if value="${'$(arg type)' == 'omni-picker'}">
		<xacro:include filename="$(find agibot_omni_description)/xacro/omni_picker.xacro"/>
		<xacro:omni-picker name="left" kinematic_only="${eef_fixed}"/>
		<xacro:omni-picker name="right" kinematic_only="${eef_fixed}"/>

		<!-- Gripper joints -->
		<joint name="ee_left_joint" type="fixed">
			<origin xyz="0 0 0.0052" rpy="0 0 1.5708"/>
			<parent link="left_end_link"/>
			<child link="left_gripper_base"/>
		</joint>

		<joint name="ee_right_joint" type="fixed">
			<origin xyz="0 0 0.0052" rpy="0 0 -1.5708"/>
			<parent link="right_end_link"/>
			<child link="right_gripper_base"/>
		</joint>

		<xacro:include filename="$(find agibot_g1_description)/xacro/omnipicker_camera_stand.xacro"/>
		<xacro:Camera name="left"/>
		<xacro:Camera name="right"/>
	</xacro:if>
</robot>
