      (2,0)  1.07
      (3,0)  1.07
      (4,0)  1.07
      (5,0)  1.07
      (6,0)  1.07
      (7,0)  1.07
      (8,0)  1.07
      (9,0)  1.07
      (10,0) 1.07
      (11,0) 1.07
      (12,0) 1.07
      (13,0) 1.07
    }
  }
}
