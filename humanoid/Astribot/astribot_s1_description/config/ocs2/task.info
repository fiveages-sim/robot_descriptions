; OCS2 Wheel Humanoid Configuration - Astribot S1 (Omni Mobile Base)
; ==============================================================
; manipulatorModelType=4: state = [x, y, yaw] + arm (20)
; arm / ros2_control joints: [body_joint1~4 | left x7 | right x7 | head_joint1~2]
; input: [vx, vy, omega | waist(4) | left(7) | right(7) | head(2)]
; Pinocchio 顺序跟随 URDF（头在双臂之后）。
; ==============================================================

;=============================================================================
; Model Information
;=============================================================================

model_information
{
    ; 0 = DefaultManipulator
    ; 1 = WheelBasedMobileManipulator (v, omega)
    ; 4 = OmniWheelBasedMobileManipulator (vx, vy, omega)
    manipulatorModelType    4

    baseFrame               "base_footprint"
    eeFrame                 "left_eef"
    eeFrame1                "right_eef"
    bodyFrame               "torso_link_4"
    headFrame               "head_link2"

    ; 四轮仅可视化；夹爪不进规划
    removeJoints
    {
        [0]   "wheel1_joint"
        [1]   "wheel2_joint"
        [2]   "wheel3_joint"
        [3]   "wheel4_joint"
        [4]   "left_gripper_joint"
        [5]   "right_gripper_joint"
    }
}

model_settings
{
    usePreComputation       true
    recompileLibraries      true
}

; 总维度 = 3（底盘 x,y,yaw）+ 20（4腰+7左+7右+2头）= 23
initialState
{
    base
    {
        omniWheelBasedMobileManipulator
        {
            (0,0)  0.0
            (1,0)  0.0
            (2,0)  0.0
        }
    }

    arm
    {
        (0,0)   0.0     ; body_joint1
        (1,0)   0.0     ; body_joint2
        (2,0)   0.0     ; body_joint3
        (3,0)   0.0     ; body_joint4
        (4,0)   0.0     ; left_joint1
        (5,0)   0.0     ; left_joint2
        (6,0)   0.0     ; left_joint3
        (7,0)   0.0     ; left_joint4
        (8,0)   0.0     ; left_joint5
        (9,0)   0.0     ; left_joint6
        (10,0)  0.0     ; left_joint7
        (11,0)  0.0     ; right_joint1
        (12,0)  0.0     ; right_joint2
        (13,0)  0.0     ; right_joint3
        (14,0)  0.0     ; right_joint4
        (15,0)  0.0     ; right_joint5
        (16,0)  0.0     ; right_joint6
        (17,0)  0.0     ; right_joint7
        (18,0)  0.0     ; head_joint1
        (19,0)  0.0     ; head_joint2
    }
}

initialModeSchedule
{
    eventTimes
    {
    }

    modeSequence
    {
        [0]
        {
            bodyMode "HM_DUAL_RELATIVE_MOBILE_BASE"
            headMode "HEAD_DISABLE"
        }
    }
}

ddp
{
    algorithm                       SLQ
    nThreads                        3
    threadPriority                  50
    maxNumIterations                1
    minRelCost                      0.1
    constraintTolerance             1e-3
    displayInfo                     false
    displayShortSummary             false
    checkNumericalStability         false
    debugPrintRollout               false
    debugCaching                    false
    AbsTolODE                       1e-5
    RelTolODE                       1e-3
    maxNumStepsPerSecond            100000
    timeStep                        1e-3
    backwardPassIntegratorType      ODE45
    constraintPenaltyInitialValue   20.0
    constraintPenaltyIncreaseRate   2.0
    preComputeRiccatiTerms          true
    useFeedbackPolicy               false
    strategy                        LINE_SEARCH
    lineSearch
    {
        minStepLength                   1e-2
        maxStepLength                   1.0
        hessianCorrectionStrategy       DIAGONAL_SHIFT
        hessianCorrectionMultiple       1e-3
    }
}

mpc
{
    timeHorizon                     1.0
    solutionTimeWindow              0.2
    coldStart                       false
    debugPrint                      false
    mpcDesiredFrequency             100
    mrtDesiredFrequency             400
}

rollout
{
    AbsTolODE                       1e-5
    RelTolODE                       1e-3
    timeStep                        1e-2
    integratorType                  ODE45
    maxNumStepsPerSecond            100000
    checkNumericalStability         false
}

; 输入布局：[底盘(3) | 腰部(4) | 左臂(7) | 右臂(7) | 头部(2)]
; body_joint1~4=3..6, left=7..13, right=14..20, head=21..22
