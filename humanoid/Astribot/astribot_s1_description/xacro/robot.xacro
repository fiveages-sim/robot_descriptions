<?xml version="1.0" ?>
<!-- =================================================================================== -->
<!-- |    Complete Robot Description for Astribot S1                                   | -->
<!-- |    OCS2 planning: eef_fixed_joints + chassis_joints_movable (robot_common_launch)| -->
<!-- =================================================================================== -->
<robot name="Astribot S1" xmlns:xacro="http://www.ros.org/wiki/xacro">

	<xacro:arg name="eef_fixed_joints" default="false"/>
	<xacro:arg name="chassis_joints_movable" default="false"/>
	<xacro:arg name="type" default="gripper"/>

	<!-- Include the base robot structure (chassis, torso and head) -->
	<xacro:include filename="$(find astribot_s1_description)/xacro/components/base.xacro"/>

	<!-- Include the arm macro -->
	<xacro:include filename="$(find astribot_s1_description)/xacro/components/s1_arm.xacro"/>

	<xacro:Base enable_wheel_joints="$(arg chassis_joints_movable)"/>

	<!-- =================================================================================== -->
	<!-- Generate Left and Right Arms Using Macro                                          -->
	<!-- =================================================================================== -->
	<xacro:S1Arm name="left"/>
	<xacro:S1Arm name="right" direction="-1"/>

	<!-- =================================================================================== -->
	<!-- Arms Connection to Torso                                                          -->
	<!-- =================================================================================== -->
	<joint name="left_base_fixed_joint" type="fixed">
		<parent link="torso_end_effector"/>
		<child link="left_base_link"/>
		<origin rpy="0 -1.22173 -1.5707963" xyz="0 0.06449 0.02348"/>
	</joint>

	<joint name="right_base_fixed_joint" type="fixed">
		<parent link="torso_end_effector"/>
		<child link="right_base_link"/>
		<origin rpy="0 -1.22173 1.5707963" xyz="0 -0.06449 0.02348"/>
	</joint>

	<xacro:property name="type_arg" value="$(arg type)"/>
	<xacro:property name="eef_fixed" value="$(arg eef_fixed_joints)"/>

	<!-- OCS2 planning: freeze EEF actuation in URDF (eeFrame = left/right_link7 in .info) -->
	<xacro:if value="${type_arg == 'gripper'}">
		<xacro:include filename="$(find astribot_s1_description)/xacro/components/s1_gripper.xacro"/>
		<xacro:Gripper name="left" kinematic_only="${eef_fixed}"/>
		<xacro:Gripper name="right" kinematic_only="${eef_fixed}"/>

		<joint name="left_gripper_fixed_joint" type="fixed">
			<origin xyz="0 -0.045 0" rpy="1.5708 0 0"/>
			<parent link="left_link7"/>
			<child link="left_gripper_base"/>
		</joint>

		<joint name="right_gripper_fixed_joint" type="fixed">
			<origin xyz="0 -0.045 0" rpy="1.5708 0 0"/>
			<parent link="right_link7"/>
			<child link="right_gripper_base"/>
		</joint>
	</xacro:if>

	<xacro:if value="${type_arg == 'revo2'}">
		<xacro:include filename="$(find brainco_description)/xacro/revo2.xacro"/>
		<xacro:BrainCoHand name="left_hand" direction="1" fixed_joints="${eef_fixed}"/>
		<xacro:BrainCoHand name="right_hand" direction="-1"  fixed_joints="${eef_fixed}"/>

		<joint name="left_gripper_fixed_joint" type="fixed">
			<origin xyz="0 -0.048 0" rpy="1.5708 3.1416 0"/>
			<parent link="left_link7"/>
			<child link="left_hand_hand_base"/>
		</joint>

		<joint name="right_gripper_fixed_joint" type="fixed">
			<origin xyz="0 -0.048 0" rpy="1.5708 0 0"/>
			<parent link="right_link7"/>
			<child link="right_hand_hand_base"/>
		</joint>
	</xacro:if>
</robot>
