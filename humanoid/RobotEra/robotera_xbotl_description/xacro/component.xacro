<?xml version="1.0"?>
<!-- =================================================================================== -->
<!-- |    Component visualization for RobotEra Xbot-L                                  | -->
<!-- =================================================================================== -->
<robot name="RobotEraXbotLComponent" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="type" default="left"/>
  <xacro:arg name="isaac" default="false"/>

  <xacro:include filename="$(find robotera_xbotl_description)/xacro/body.xacro"/>
  <xacro:include filename="$(find robotera_xbotl_description)/xacro/arm.xacro"/>
  <xacro:include filename="$(find robotera_xbotl_description)/xacro/leg.xacro"/>
  <xacro:include filename="$(find robotera_xbotl_description)/xacro/hand.xacro"/>

  <xacro:if value="${'$(arg type)' == 'base'}">
    <xacro:XbotlBody isaac="$(arg isaac)"/>
  </xacro:if>

  <xacro:if value="${'$(arg type)' == 'left'}">
    <link name="base_link"/>
    <xacro:XbotlArm name="left" direction="1"/>
  </xacro:if>

  <xacro:if value="${'$(arg type)' == 'right'}">
    <link name="base_link"/>
    <xacro:XbotlArm name="right" direction="-1"/>
  </xacro:if>

  <xacro:if value="${'$(arg type)' == 'left_hand'}">
    <link name="base_link"/>
    <link name="left_wrist_yaw_link"/>
    <joint name="left_wrist_yaw_fixed" type="fixed">
      <parent link="base_link"/>
      <child link="left_wrist_yaw_link"/>
    </joint>
    <xacro:XbotlLeftHand parent_link="left_wrist_yaw_link" fixed_joints="false"/>
  </xacro:if>

  <xacro:if value="${'$(arg type)' == 'right_hand'}">
    <link name="base_link"/>
    <link name="right_wrist_yaw_link"/>
    <joint name="right_wrist_yaw_fixed" type="fixed">
      <parent link="base_link"/>
      <child link="right_wrist_yaw_link"/>
    </joint>
    <xacro:XbotlRightHand parent_link="right_wrist_yaw_link" fixed_joints="false"/>
  </xacro:if>

  <xacro:if value="${'$(arg type)' == 'left_leg'}">
    <link name="base_link"/>
    <link name="waist_yaw_link"/>
    <joint name="waist_yaw_fixed" type="fixed">
      <parent link="base_link"/>
      <child link="waist_yaw_link"/>
    </joint>
    <link name="waist_roll_link"/>
    <joint name="waist_roll_fixed" type="fixed">
      <origin xyz="0 0 0" rpy="1.5708 0 1.5708"/>
      <parent link="waist_yaw_link"/>
      <child link="waist_roll_link"/>
    </joint>
    <xacro:XbotlLeg name="left" direction="1"/>
  </xacro:if>

  <xacro:if value="${'$(arg type)' == 'right_leg'}">
    <link name="base_link"/>
    <link name="waist_yaw_link"/>
    <joint name="waist_yaw_fixed" type="fixed">
      <parent link="base_link"/>
      <child link="waist_yaw_link"/>
    </joint>
    <link name="waist_roll_link"/>
    <joint name="waist_roll_fixed" type="fixed">
      <origin xyz="0 0 0" rpy="1.5708 0 1.5708"/>
      <parent link="waist_yaw_link"/>
      <child link="waist_roll_link"/>
    </joint>
    <xacro:XbotlLeg name="right" direction="-1"/>
  </xacro:if>
</robot>
