<?xml version="1.0"?>
<!-- =================================================================================== -->
<!-- |    RobotEra Xbot-L hands — reuse common xhand1_description                      | -->
<!-- =================================================================================== -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find xhand1_description)/xacro/xhand1.xacro"/>

  <!-- wrist_yaw +Z is distal / XHand1 fingers +Z. ±90° about distal axis; L/R mesh via direction. -->
  <xacro:macro name="XbotlLeftHand" params="parent_link:=left_wrist_yaw_link fixed_joints:=false">
    <xacro:XHand1 name="left_hand" direction="1" use_flange="false" fixed_joints="${fixed_joints}"/>
    <joint name="left_hand_base_joint" type="fixed">
      <origin xyz="0 0 0.1135" rpy="0 0 1.5708"/>
      <parent link="${parent_link}"/>
      <child link="left_hand_hand_base"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="XbotlRightHand" params="parent_link:=right_wrist_yaw_link fixed_joints:=false">
    <xacro:XHand1 name="right_hand" direction="-1" use_flange="false" fixed_joints="${fixed_joints}"/>
    <joint name="right_hand_base_joint" type="fixed">
      <origin xyz="0 0 0.1135" rpy="0 0 -1.5708"/>
      <parent link="${parent_link}"/>
      <child link="right_hand_hand_base"/>
    </joint>
  </xacro:macro>
</robot>
