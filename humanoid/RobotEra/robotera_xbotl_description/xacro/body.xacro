<?xml version="1.0"?>
<!-- =================================================================================== -->
<!-- |    RobotEra Xbot-L body (ROS Z-up hip root, waist → torso, neck, camera)        | -->
<!-- |    base_link = ROS X-forward Z-up; CAD hip mesh on waist_roll_link (fixed)       | -->
<!-- |    collider:=simple: boxes from glTF node-world AABB (inset for selfCollision). | -->
<!-- |    collider:=convex: same GLB as visual. Head/neck stay mesh-only for simple.   | -->
<!-- =================================================================================== -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="xbotl_body_collision"
               params="collider mesh xyz:='0 0 0' size:='0 0 0'">
    <xacro:if value="${collider == 'convex'}">
      <collision>
        <geometry>
          <mesh filename="${mesh}"/>
        </geometry>
      </collision>
    </xacro:if>
    <xacro:if value="${collider == 'simple'}">
      <collision>
        <origin xyz="${xyz}"/>
        <geometry>
          <box size="${size}"/>
        </geometry>
      </collision>
    </xacro:if>
  </xacro:macro>

  <xacro:macro name="XbotlBody" params="isaac:=false collider:='simple'">
    <link name="base">
      <visual>
        <geometry>
          <box size="0.001 0.001 0.001"/>
        </geometry>
      </visual>
    </link>
    <joint name="floating_base" type="fixed">
      <parent link="base"/>
      <child link="base_link"/>
    </joint>

    <!-- ROS Z-up hip root for OCS2 fixed-base WBC. -->
    <link name="base_link">
      <inertial>
        <origin xyz="0 0 0"/>
        <mass value="0.01"/>
        <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
      </inertial>
    </link>

    <!-- CAD hip mesh (former waist_roll frame: Y-up). Legs attach here. -->
    <link name="waist_roll_link">
      <inertial>
        <origin xyz="-8.7577E-07 -0.020553 -0.088247"/>
        <mass value="5.1053"/>
        <inertia ixx="0.0067829" ixy="-2.98E-09" ixz="-2.5393E-07"
                 iyy="0.011425" iyz="-1.2239E-05" izz="0.014655"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="file://$(find robotera_xbotl_description)/meshes/body/waist_roll_link.glb"/>
        </geometry>
      </visual>
      <!-- Hip shell; not used in upper-body selfCollision pairs. -->
      <xacro:xbotl_body_collision collider="${collider}"
        mesh="file://$(find robotera_xbotl_description)/meshes/body/waist_roll_link.glb"
        xyz="0 -0.015 -0.096" size="0.30 0.12 0.07"/>
    </link>
    <joint name="waist_roll_fixed_joint" type="fixed">
      <origin xyz="0 0 0" rpy="1.5708 0 1.5708"/>
      <parent link="base_link"/>
      <child link="waist_roll_link"/>
    </joint>

    <!-- Waist DOFs in ROS axes: roll about X, yaw about Z → torso. -->
    <link name="waist_yaw_link">
      <inertial>
        <origin xyz="0.0018236 3.106E-08 0.015461"/>
        <mass value="1.9214"/>
        <inertia ixx="0.0032668" ixy="-2.5545E-08" ixz="-4.7672E-05"
                 iyy="0.0027745" iyz="3.1696E-09" izz="0.0043665"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="file://$(find robotera_xbotl_description)/meshes/body/waist_yaw_link.glb"/>
        </geometry>
      </visual>
      <xacro:xbotl_body_collision collider="${collider}"
        mesh="file://$(find robotera_xbotl_description)/meshes/body/waist_yaw_link.glb"
        xyz="0.01 0 0" size="0.12 0.22 0.09"/>
    </link>
    <joint name="waist_roll_joint" type="revolute">
      <origin xyz="0 0 0"/>
      <parent link="base_link"/>
      <child link="waist_yaw_link"/>
      <axis xyz="1 0 0"/>
      <limit lower="-0.26" upper="0.26" effort="100" velocity="12"/>
    </joint>

    <link name="torso_base_link">
      <inertial>
        <origin xyz="-0.0033599 -0.00084664 0.1336"/>
        <mass value="9.9576"/>
        <inertia ixx="0.089966" ixy="-1.1578E-05" ixz="-0.00027182"
                 iyy="0.060002" iyz="-2.1263E-05" izz="0.056135"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="file://$(find robotera_xbotl_description)/meshes/body/base_link.glb"/>
        </geometry>
      </visual>
      <!-- Chest core inset from shoulder pods (AABB Y≈0.39 → 0.26). -->
      <xacro:xbotl_body_collision collider="${collider}"
        mesh="file://$(find robotera_xbotl_description)/meshes/body/base_link.glb"
        xyz="0.01 0 0.18" size="0.22 0.26 0.36"/>
    </link>
    <joint name="waist_yaw_joint" type="revolute">
      <origin xyz="0 0 0.0975"/>
      <parent link="waist_yaw_link"/>
      <child link="torso_base_link"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.57" upper="1.57" effort="100" velocity="12"/>
    </joint>

    <!-- neck -->
    <link name="neck_base_link">
      <inertial>
        <origin xyz="3.5639E-05 4.7576E-05 -0.031296"/>
        <mass value="0.61964"/>
        <inertia ixx="0.00027591" ixy="4.4922E-07" ixz="4.4668E-07"
                 iyy="0.00029054" iyz="3.5279E-07" izz="0.00047326"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="file://$(find robotera_xbotl_description)/meshes/body/neck_base_link.glb"/>
        </geometry>
      </visual>
      <!-- Head/neck not in selfCollision pairs; mesh only for convex. -->
      <xacro:if value="${collider == 'convex'}">
        <collision>
          <geometry>
            <mesh filename="file://$(find robotera_xbotl_description)/meshes/body/neck_base_link.glb"/>
          </geometry>
        </collision>
      </xacro:if>
    </link>
    <!-- Joint name sorts after left_/right_ under Pinocchio 4 sibling DFS → head after arms. -->
    <joint name="torso_neck_base_joint" type="fixed">
      <origin xyz="0 0 0.4"/>
      <parent link="torso_base_link"/>
      <child link="neck_base_link"/>
    </joint>

    <link name="neck_yaw_link">
      <inertial>
        <origin xyz="0.023237 0.004247 0.035877"/>
        <mass value="0.64979"/>
        <inertia ixx="0.00033722" ixy="7.322E-07" ixz="1.9679E-05"
                 iyy="0.00056036" iyz="2.7926E-07" izz="0.0003788"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="file://$(find robotera_xbotl_description)/meshes/body/neck_yaw_link.glb"/>
        </geometry>
      </visual>
      <xacro:if value="${collider == 'convex'}">
        <collision>
          <geometry>
            <mesh filename="file://$(find robotera_xbotl_description)/meshes/body/neck_yaw_link.glb"/>
          </geometry>
        </collision>
      </xacro:if>
    </link>
    <joint name="neck_yaw_joint" type="revolute">
      <parent link="neck_base_link"/>
      <child link="neck_yaw_link"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.57" upper="1.57" effort="50" velocity="7"/>
    </joint>

    <link name="neck_pitch_link">
      <inertial>
        <origin xyz="-0.0021819 -0.087991 0.00035708"/>
        <mass value="1.3216"/>
        <inertia ixx="0.0064217" ixy="-0.0010336" ixz="-1.3429E-07"
                 iyy="0.0051542" iyz="3.6968E-07" izz="0.0050103"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="file://$(find robotera_xbotl_description)/meshes/body/head.glb"/>
        </geometry>
      </visual>
      <xacro:if value="${collider == 'convex'}">
        <collision>
          <geometry>
            <mesh filename="file://$(find robotera_xbotl_description)/meshes/body/head.glb"/>
          </geometry>
        </collision>
      </xacro:if>
    </link>
    <joint name="neck_pitch_joint" type="revolute">
      <origin xyz="0.032 0 0.044" rpy="-1.5708 0 0"/>
      <parent link="neck_yaw_link"/>
      <child link="neck_pitch_link"/>
      <axis xyz="0 0 1"/>
      <limit lower="-0.44" upper="0.44" effort="50" velocity="7"/>
    </joint>

    <!-- realsense -->
    <link name="realsense_link">
      <inertial>
        <origin xyz="0.047424 0.00014285 -0.0082421"/>
        <mass value="0.076907"/>
        <inertia ixx="8.6659E-06" ixy="9.2766E-08" ixz="-9.1747E-08"
                 iyy="9.4298E-05" iyz="9.0199E-08" izz="9.4996E-05"/>
      </inertial>
      <xacro:unless value="${isaac}">
        <visual>
          <geometry>
            <mesh filename="file://$(find sensor_models)/meshes/realsense/d455.glb"/>
          </geometry>
        </visual>
      </xacro:unless>
    </link>
    <joint name="realsense_joint" type="fixed">
      <origin xyz="0.066371 -0.12536 0.0475" rpy="-0.34907 1.5708 0"/>
      <parent link="neck_pitch_link"/>
      <child link="realsense_link"/>
    </joint>
    <!-- CAD realsense_link is already ROS optical (+Z forward, +X right, +Y down).
         Do not apply the usual camera_link→optical rpy(-π/2,0,-π/2) or gaze looks sideways. -->
    <link name="realsense_optical_frame"/>
    <joint name="realsense_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="realsense_link"/>
      <child link="realsense_optical_frame"/>
    </joint>
  </xacro:macro>
</robot>
