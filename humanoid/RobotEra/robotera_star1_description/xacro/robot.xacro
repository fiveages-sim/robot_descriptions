<?xml version="1.0"?>
<!-- =================================================================================== -->
<!-- |    Complete Robot Description for RobotEra STAR1                                | -->
<!-- =================================================================================== -->
<robot name="robotera_star1" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- variant: upper (default) = waist + base + arms + head; full = whole body with legs. -->
  <xacro:arg name="variant" default="upper"/>
  <!-- Default EEF: XHand1 (type:=xhand1; alias type:=xhand). Per-side: left_type / right_type. -->
  <xacro:arg name="type" default="xhand1"/>
  <xacro:arg name="left_type" default=""/>
  <xacro:arg name="right_type" default=""/>
  <xacro:arg name="isaac" default="false"/>
  <!-- simple = box/cylinder for OCS2 selfCollision; convex = visual GLB. -->
  <xacro:arg name="collider" default="simple"/>
  <!-- OCS2 / planning injects eef_fixed_joints:=true to freeze finger DOFs. -->
  <xacro:arg name="eef_fixed_joints" default="false"/>
  <xacro:property name="eef_fixed"
                  value="${'$(arg eef_fixed_joints)'.lower() in ['1', 'true', 'yes', 'on']}"/>
  <xacro:property name="include_legs"
                  value="${'$(arg variant)' not in ['upper']}"/>

  <!-- Resolve EEF keys → left_hand_type / right_hand_type (W2-style). -->
  <xacro:property name="type_arg" value="$(arg type)"/>
  <xacro:property name="left_type_arg" value="$(arg left_type)"/>
  <xacro:property name="right_type_arg" value="$(arg right_type)"/>
  <xacro:property name="effective_left_type"
                  value="${left_type_arg if left_type_arg != '' else type_arg}"/>
  <xacro:property name="effective_right_type"
                  value="${right_type_arg if right_type_arg != '' else type_arg}"/>
  <xacro:property name="left_hand_type"
                  value="${'xhand1' if effective_left_type in ('xhand1', 'xhand') else ''}"/>
  <xacro:property name="right_hand_type"
                  value="${'xhand1' if effective_right_type in ('xhand1', 'xhand') else ''}"/>

  <xacro:include filename="$(find robotera_star1_description)/xacro/body.xacro"/>
  <xacro:include filename="$(find robotera_star1_description)/xacro/arm.xacro"/>
  <xacro:include filename="$(find robotera_star1_description)/xacro/leg.xacro"/>
  <xacro:include filename="$(find robotera_star1_description)/xacro/hand.xacro"/>

  <xacro:Star1Body isaac="$(arg isaac)" collider="$(arg collider)"/>
  <xacro:if value="${include_legs}">
    <xacro:Star1Leg name="left" direction="1"/>
    <xacro:Star1Leg name="right" direction="-1"/>
  </xacro:if>
  <xacro:Star1Arm name="left" direction="1" collider="$(arg collider)"/>
  <xacro:Star1Arm name="right" direction="-1" collider="$(arg collider)"/>
  <xacro:if value="${left_hand_type == 'xhand1'}">
    <xacro:Star1LeftHand parent_link="left_wrist_roll_link" fixed_joints="${eef_fixed}"/>
  </xacro:if>
  <xacro:if value="${right_hand_type == 'xhand1'}">
    <xacro:Star1RightHand parent_link="right_wrist_roll_link" fixed_joints="${eef_fixed}"/>
  </xacro:if>
</robot>
