<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find xhand1_description)/xacro/ros2_control/side_systems.xacro"/>

  <!-- iface_mode: mix = pos/vel/effort (mock/gz); position = pos only (Isaac). -->
  <xacro:macro name="Star1JointInterfaces" params="jname iface_mode:=mix">
    <joint name="${jname}">
      <command_interface name="position"/>
      <xacro:if value="${iface_mode == 'mix'}">
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
      </xacro:if>
      <state_interface name="position"/>
      <xacro:if value="${iface_mode == 'mix'}">
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </xacro:if>
    </joint>
  </xacro:macro>

  <xacro:macro name="Star1WaistInterfaces" params="iface_mode:=mix">
    <xacro:Star1JointInterfaces jname="waist_yaw_joint" iface_mode="${iface_mode}"/>
    <xacro:Star1JointInterfaces jname="waist_roll_joint" iface_mode="${iface_mode}"/>
    <xacro:Star1JointInterfaces jname="waist_pitch_joint" iface_mode="${iface_mode}"/>
  </xacro:macro>

  <xacro:macro name="Star1HeadInterfaces" params="iface_mode:=mix">
    <xacro:Star1JointInterfaces jname="neck_yaw_joint" iface_mode="${iface_mode}"/>
    <xacro:Star1JointInterfaces jname="neck_pitch_joint" iface_mode="${iface_mode}"/>
  </xacro:macro>

  <xacro:macro name="Star1ArmInterfaces" params="name iface_mode:=mix">
    <xacro:property name="prefix" value="${name + '_' if name else ''}"/>
    <xacro:Star1JointInterfaces jname="${prefix}shoulder_pitch_joint" iface_mode="${iface_mode}"/>
    <xacro:Star1JointInterfaces jname="${prefix}shoulder_roll_joint" iface_mode="${iface_mode}"/>
    <xacro:Star1JointInterfaces jname="${prefix}arm_yaw_joint" iface_mode="${iface_mode}"/>
    <xacro:Star1JointInterfaces jname="${prefix}elbow_pitch_joint" iface_mode="${iface_mode}"/>
    <xacro:Star1JointInterfaces jname="${prefix}elbow_yaw_joint" iface_mode="${iface_mode}"/>
    <xacro:Star1JointInterfaces jname="${prefix}wrist_pitch_joint" iface_mode="${iface_mode}"/>
    <xacro:Star1JointInterfaces jname="${prefix}wrist_roll_joint" iface_mode="${iface_mode}"/>
  </xacro:macro>

  <xacro:macro name="Star1SideHandInterfaces" params="side hand_type">
    <xacro:if value="${hand_type == 'xhand1'}">
      <xacro:xhand1_interfaces name="${side}_hand"/>
    </xacro:if>
  </xacro:macro>

  <!--
    mode=sim  → finger joints in the main mock/gz/isaac system.
    mode=real → xhand1 uses a separate USB RS485 system; do not declare fingers here.
  -->
  <xacro:macro name="Star1HandInterfacesBlock" params="mode">
    <xacro:if value="${mode == 'sim'}">
      <xacro:if value="${left_hand_type != ''}">
        <xacro:Star1SideHandInterfaces side="left" hand_type="${left_hand_type}"/>
      </xacro:if>
      <xacro:if value="${right_hand_type != ''}">
        <xacro:Star1SideHandInterfaces side="right" hand_type="${right_hand_type}"/>
      </xacro:if>
    </xacro:if>
  </xacro:macro>
</robot>
