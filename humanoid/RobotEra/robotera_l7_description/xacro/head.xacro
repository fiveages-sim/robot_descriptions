<?xml version="1.0"?>
<!-- =================================================================================== -->
<!-- |    RobotEra L7 head (neck + sensors)                                     | -->
<!-- =================================================================================== -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="L7Head">
  <link name="neck_flange_link">
  </link>
  <joint name="neck_flange_joint" type="fixed">
    <origin xyz="0 0 0.303" rpy="0 0 0" />
    <parent link="torso_base_link" />
    <child link="neck_flange_link" />
    <axis xyz="0 0 0" />
  </joint>
  <!--   head part    -->
  <joint name="neck_base_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="neck_flange_link" />
    <child link="neck_base_link" />
    <axis xyz="0 0 1" />
    <limit
      lower="0"
      upper="0"
      effort="0"
      velocity="0" />
  </joint>
 <link name="neck_base_link">
    <inertial>
      <origin xyz="0.00044058 -3.1316E-05 0.020437" rpy="0 0 0" />
      <mass value="0.54879" />
      <inertia
        ixx="0.000336"
        ixy="1E-06"
        ixz="-1E-06"
        iyy="0.000311"
        iyz="2.377E-07"
        izz="0.000379" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find robotera_l7_description)/meshes/body/neck_base_link.glb" />
      </geometry>
    </visual>
    <xacro:if value="${'$(arg collider)' == 'convex'}">
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find robotera_l7_description)/meshes/body/neck_base_link.glb" />
        </geometry>
      </collision>
    </xacro:if>
  </link>
  <link name="neck_yaw_link">
    <inertial>
      <origin
        xyz="0.033363 0.00038788 0.085731"
        rpy="0 0 0" />
      <mass value="0.57738" />
      <inertia
        ixx="0.000363"
        ixy="1E-06"
        ixz="-9E-05"
        iyy="0.000478"
        iyz="1E-06"
        izz="0.000427" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find robotera_l7_description)/meshes/body/neck_yaw_link.glb" />
      </geometry>
    </visual>
    <xacro:if value="${'$(arg collider)' == 'convex'}">
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find robotera_l7_description)/meshes/body/neck_yaw_link.glb" />
        </geometry>
      </collision>
    </xacro:if>
    <!-- <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="file://$(find robotera_l7_description)/meshes/body/neck_yaw_link.glb" />
      </geometry>
    </collision> -->
  </link>
  <joint name="neck_yaw_joint" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="neck_base_link" />
    <child link="neck_yaw_link" />
    <axis xyz="0 0 1" />
    <limit lower="-1.05" upper="1.05" effort="35" velocity="4.19" />
  </joint>
  <link name="neck_pitch_link">
    <inertial>
      <origin xyz="-0.018182 0.00091372 0.11159" rpy="0 0 0" />
      <mass value="1.4643" />
      <inertia
        ixx="0.00728"
        ixy="0.0"
        ixz="0.000915"
        iyy="0.008753"
        iyz="0.0"
        izz="0.006659" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find robotera_l7_description)/meshes/body/neck_pitch_link.glb" />
      </geometry>
    </visual>
    <xacro:if value="${'$(arg collider)' == 'convex'}">
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find robotera_l7_description)/meshes/body/neck_pitch_link.glb" />
        </geometry>
      </collision>
    </xacro:if>
  <xacro:if value="${'$(arg collider)' == 'simple'}">
    <collision>
      <origin xyz="-0.02 0 0.09500003" rpy="0 0 0"/>
      <geometry><box size="0.17 0.16 0.2"/></geometry>
    </collision>
  </xacro:if>
  </link>
  <joint name="neck_pitch_joint" type="revolute">
    <origin xyz="0.04 0 0.0905" rpy="0 0 0" />
    <parent link="neck_yaw_link" />
    <child link="neck_pitch_link" />
    <axis xyz="0 1 0" />
    <limit
      lower="-0.17"
      upper="0.48"
      effort="35"
      velocity="4.19" />
  </joint>
  <link name="lidar_link">
  </link>
  <joint name="lidar_joint" type="fixed">
    <origin xyz="-0.014255 0 0.10675" rpy="0 0 0" />
    <parent link="neck_pitch_link" />
    <child link="lidar_link" />
    <axis xyz="0 0 0" />
  </joint>

  <link name="mic_link">
  </link>
  <joint name="mic_joint" type="fixed">
    <origin xyz="-0.014255 0 0.18884" rpy="0 0 0" />
    <parent link="neck_pitch_link" />
    <child link="mic_link" />
    <axis xyz="0 0 0" />
  </joint>

  <link name="stereo_link">
    <!-- D455 inertia and CoM in its optical frame, as used by XbotL. -->
    <inertial>
      <origin xyz="0.0082579 0.00003745 -0.00014285" rpy="-1.5707963267948966 0 -1.5707963267948966"/>
      <mass value="0.076907"/>
      <inertia ixx="8.6659E-06" ixy="9.2766E-08" ixz="-9.1747E-08"
               iyy="9.4298E-05" iyz="9.0199E-08" izz="9.4996E-05"/>
    </inertial>
    <xacro:unless value="$(arg isaac)">
      <visual>
        <origin xyz="0.0165 0.04746145 0" rpy="-1.5707963267948966 0 -1.5707963267948966"/>
        <geometry><mesh filename="file://$(find sensor_models)/meshes/realsense/d455.glb"/></geometry>
      </visual>
    </xacro:unless>
  </link>
  <joint name="stereo_joint" type="fixed">
    <origin xyz="0.059712 0 0.13282" rpy="0 0.5236 0" />
    <parent link="neck_pitch_link" />
    <child link="stereo_link" />
    <axis xyz="0 0 0" />
  </joint>
  <!-- D455 optical frame: +Z forward, +X right, +Y down. -->
  <link name="stereo_optical_frame"/>
  <joint name="stereo_optical_joint" type="fixed">
    <origin xyz="0.0165 0.04746145 0" rpy="-1.5707963267948966 0 -1.5707963267948966"/>
    <parent link="stereo_link"/>
    <child link="stereo_optical_frame"/>
  </joint>
  </xacro:macro>
</robot>
