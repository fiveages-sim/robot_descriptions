<?xml version="1.0"?>
<!-- =================================================================================== -->
<!-- |    RobotEra L7 hands — reuse common xhand1_description                          | -->
<!-- =================================================================================== -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find xhand1_description)/xacro/xhand1.xacro"/>

  <!-- hand_flange +Z is distal (fingers). ±90° about distal axis so palms face the body. -->
  <xacro:macro name="L7LeftHand" params="parent_link:=left_hand_flange_link fixed_joints:=false">
    <xacro:XHand1 name="left_hand" direction="1" use_flange="false" fixed_joints="${fixed_joints}"/>
    <joint name="left_hand_base_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 1.5708"/>
      <parent link="${parent_link}"/>
      <child link="left_hand_hand_base"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="L7RightHand" params="parent_link:=right_hand_flange_link fixed_joints:=false">
    <xacro:XHand1 name="right_hand" direction="-1" use_flange="false" fixed_joints="${fixed_joints}"/>
    <joint name="right_hand_base_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 -1.5708"/>
      <parent link="${parent_link}"/>
      <child link="right_hand_hand_base"/>
    </joint>
  </xacro:macro>
</robot>
