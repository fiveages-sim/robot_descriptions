<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="galbot_one_arm_interfaces" params="name">
    <xacro:property name="prefix" value="${name + '_' if name else ''}"/>

    <joint name="${prefix}arm_joint1"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="${prefix}arm_joint2"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="${prefix}arm_joint3"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="${prefix}arm_joint4"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="${prefix}arm_joint5"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="${prefix}arm_joint6"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="${prefix}arm_joint7"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
  </xacro:macro>

</robot>

