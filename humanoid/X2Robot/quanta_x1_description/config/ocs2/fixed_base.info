        (5,5)  5.0
      }
      wheelBasedMobileManipulator
      {
        scaling 1e-2
        (0,0)  1.5
        (1,1)  1.5
      }
    }

    arm
    {
      scaling 1e-3
      (0,0)    1.0      ; lift_joint
      (1,1)    0.2      ; left_joint1
      (2,2)    0.2      ; left_joint2
