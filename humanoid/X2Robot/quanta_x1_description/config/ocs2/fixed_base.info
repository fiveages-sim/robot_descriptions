      (11,11)  0.2      ; right_joint5
      (12,12)  0.2      ; right_joint6
    }
  }
}

endEffector
{
  dualArmMode      true
  muPosition       10.0
  muOrientation    5.0
  leftArm
  {
    muPosition      10.0
    muOrientation    5.0
  }
  rightArm
  {
    muPosition      10.0
    muOrientation    5.0
  }
}

finalEndEffector
{
  dualArmMode      true
  muPosition       5.0
  muOrientation    2.5
  leftArm
  {
    muPosition      5.0
    muOrientation   2.5
  }
  rightArm
  {
    muPosition      5.0
    muOrientation   2.5
  }
}

bodyRelative
{
  activate                   false
}

selfCollision
{
  activate                   false
}

