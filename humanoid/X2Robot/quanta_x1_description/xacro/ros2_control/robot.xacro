<?xml version="1.0"?>
<robot name="quanta_x1" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="ros2_control_hardware_type" default="mock_components"/>
  <xacro:arg name="gazebo" default="false"/>

  <xacro:include filename="$(find quanta_x1_description)/xacro/robot.xacro"/>

  <xacro:macro name="quanta_joint_interfaces" params="joint initial_value:=0.0">
    <joint name="${joint}">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <command_interface name="mit_kp"/>
      <command_interface name="mit_kd"/>
      <command_interface name="ctrl_mode"/>
      <state_interface name="position">
        <param name="initial_value">${initial_value}</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="quanta_passive_joint_state" params="joint initial_value:=0.0">
    <joint name="${joint}">
      <state_interface name="position">
        <param name="initial_value">${initial_value}</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <ros2_control name="quanta_x1_system" type="system">
    <hardware>
      <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'gz'}">
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </xacro:if>
      <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'mock_components'}">
        <plugin>mock_components/GenericSystem</plugin>
      </xacro:if>
      <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'isaac'}">
        <plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
        <param name="joint_commands_topic">/isaac/joint_command</param>
        <param name="joint_states_topic">/isaac/joint_states</param>
        <param name="sum_wrapped_joint_states">false</param>
        <param name="initialize_commands_from_state">true</param>
      </xacro:if>
    </hardware>

    <xacro:quanta_joint_interfaces joint="lift_joint" initial_value="0.10"/>
    <xacro:quanta_joint_interfaces joint="head_yaw_joint"/>
    <xacro:quanta_joint_interfaces joint="head_pitch_joint" initial_value="0.20"/>

    <xacro:quanta_joint_interfaces joint="left_joint1"/>
    <xacro:quanta_joint_interfaces joint="left_joint2" initial_value="0.30"/>
    <xacro:quanta_joint_interfaces joint="left_joint3" initial_value="-0.30"/>
    <xacro:quanta_joint_interfaces joint="left_joint4"/>
    <xacro:quanta_joint_interfaces joint="left_joint5"/>
    <xacro:quanta_joint_interfaces joint="left_joint6"/>

    <xacro:quanta_joint_interfaces joint="right_joint1"/>
    <xacro:quanta_joint_interfaces joint="right_joint2" initial_value="0.30"/>
    <xacro:quanta_joint_interfaces joint="right_joint3" initial_value="-0.30"/>
    <xacro:quanta_joint_interfaces joint="right_joint4"/>
    <xacro:quanta_joint_interfaces joint="right_joint5"/>
    <xacro:quanta_joint_interfaces joint="right_joint6"/>

    <xacro:quanta_joint_interfaces joint="left_gripper_joint"/>
    <xacro:quanta_joint_interfaces joint="right_gripper_joint"/>

    <xacro:quanta_passive_joint_state joint="right_wheel_joint"/>
    <xacro:quanta_passive_joint_state joint="left_wheel_joint"/>

    <xacro:quanta_passive_joint_state joint="fl_swivel_yaw"/>
    <xacro:quanta_passive_joint_state joint="fl_swivel_roller_1"/>
    <xacro:quanta_passive_joint_state joint="fl_swivel_roller_2"/>
    <xacro:quanta_passive_joint_state joint="fl_swivel_roller_3"/>
    <xacro:quanta_passive_joint_state joint="fl_swivel_roller_4"/>

    <xacro:quanta_passive_joint_state joint="fr_swivel_yaw"/>
    <xacro:quanta_passive_joint_state joint="fr_swivel_roller_1"/>
    <xacro:quanta_passive_joint_state joint="fr_swivel_roller_2"/>
    <xacro:quanta_passive_joint_state joint="fr_swivel_roller_3"/>
    <xacro:quanta_passive_joint_state joint="fr_swivel_roller_4"/>

    <xacro:quanta_passive_joint_state joint="rl_swivel_yaw"/>
    <xacro:quanta_passive_joint_state joint="rl_swivel_roller_1"/>
    <xacro:quanta_passive_joint_state joint="rl_swivel_roller_2"/>
    <xacro:quanta_passive_joint_state joint="rl_swivel_roller_3"/>
    <xacro:quanta_passive_joint_state joint="rl_swivel_roller_4"/>

    <xacro:quanta_passive_joint_state joint="rr_swivel_yaw"/>
    <xacro:quanta_passive_joint_state joint="rr_swivel_roller_1"/>
    <xacro:quanta_passive_joint_state joint="rr_swivel_roller_2"/>
    <xacro:quanta_passive_joint_state joint="rr_swivel_roller_3"/>
    <xacro:quanta_passive_joint_state joint="rr_swivel_roller_4"/>
  </ros2_control>

  <xacro:if value="$(arg gazebo)">
    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find quanta_x1_description)/config/ros2_control/ros2_controllers.yaml</parameters>
      </plugin>
    </gazebo>
  </xacro:if>
</robot>
