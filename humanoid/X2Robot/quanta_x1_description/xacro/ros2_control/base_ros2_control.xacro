<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Quanta X1 base: lift + head; optional drive wheels. -->
  <xacro:macro name="quanta_x1_wheel_interfaces">
    <joint name="left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10.0</param>
        <param name="max">10.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10.0</param>
        <param name="max">10.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="quanta_x1_base_interfaces" params="iface_mode:=mix">
    <joint name="lift_joint">
      <command_interface name="position"/>
      <xacro:if value="${iface_mode == 'mix'}">
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
      </xacro:if>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <xacro:if value="${iface_mode == 'mix'}">
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </xacro:if>
    </joint>

    <joint name="head_yaw_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <xacro:if value="${iface_mode == 'mix'}">
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </xacro:if>
    </joint>

    <joint name="head_pitch_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <xacro:if value="${iface_mode == 'mix'}">
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </xacro:if>
    </joint>
  </xacro:macro>
</robot>
