<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:property name="PI" value="3.1415926535897931"/>

    <xacro:macro name="Chassis">

        <!-- Base Link -->
        <link name="base_link">
            <inertial>
                <origin xyz="-0.0024126 -8.9626E-05 0.13736"/>
                <mass value="47.63"/>
                <inertia ixx="1.578" ixy="-1.2021E-05" ixz="0.053642" iyy="1.462" iyz="7.297E-06" izz="2.8318"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find galaxea_r1_description)/meshes/chassis.glb"/>
                </geometry>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="file://$(find galaxea_r1_description)/meshes/chassis.glb"/>
                </geometry>
            </collision>
        </link>

        <!-- Steer Motor Link 1 -->
        <link name="steer_motor_link1">
            <inertial>
                <origin xyz="0.00098921 -0.034312 -0.034597"/>
                <mass value="1.2"/>
                <inertia ixx="8.8522E-05" ixy="-3.7755E-06" ixz="4.5456E-09" iyy="7.5352E-05" iyz="-7.0316E-07"
                         izz="0.00010165"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find galaxea_r1_description)/meshes/steer_motor.obj"/>
                </geometry>
            </visual>
        </link>

        <!-- Steer Motor Joint 1: Base to Steer Motor 1 -->
        <joint name="steer_joint1" type="revolute">
            <origin xyz="0.21516 0.28 0.12375"/>
            <parent link="base_link"/>
            <child link="steer_motor_link1"/>
            <axis xyz="0 0 1"/>
            <limit lower="${-PI/2}" upper="${PI/2}" effort="44" velocity="${PI}"/>
        </joint>

        <!-- Wheel Motor Link 1 -->
        <link name="wheel_motor_link1">
            <inertial>
                <origin xyz="-2.6184E-06 0.0015607 1.6575E-07"/>
                <mass value="5"/>
                <inertia ixx="0.00089952" ixy="6.916E-08" ixz="7.5501E-10" iyy="0.0015854" iyz="7.6011E-12"
                         izz="0.00089958"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find galaxea_r1_description)/meshes/wheel_motor.obj"/>
                </geometry>
            </visual>
            <collision>
                <origin rpy="${PI/2} 0 0"/>
                <geometry>
                    <cylinder radius="0.07" length="0.048"/>
                </geometry>
            </collision>
        </link>

        <!-- Wheel Motor Joint 1: Steer Motor 1 to Wheel Motor 1 -->
        <joint name="wheel_joint1" type="continuous">
            <origin xyz="0 0 -0.09525" rpy="0 0 ${PI}"/>
            <parent link="steer_motor_link1"/>
            <child link="wheel_motor_link1"/>
            <axis xyz="0 -1 0"/>
        </joint>

        <!-- Steer Motor Link 2 -->
        <link name="steer_motor_link2">
            <inertial>
                <origin xyz="0.00098879 0.034317 -0.034601"/>
                <mass value="1.2"/>
                <inertia ixx="8.8509E-05" ixy="3.7728E-06" ixz="4.584E-09" iyy="7.5337E-05" iyz="7.0145E-07"
                         izz="0.00010162"/>
            </inertial>
            <visual>
                <origin rpy="0 0 ${PI}"/>
                <geometry>
                    <mesh filename="file://$(find galaxea_r1_description)/meshes/steer_motor.obj"/>
                </geometry>
            </visual>
            <collision>
                <origin rpy="0 0 ${PI}"/>
                <geometry>
                    <mesh filename="file://$(find galaxea_r1_description)/meshes/steer_motor.obj"/>
                </geometry>
            </collision>
        </link>

        <!-- Steer Motor Joint 2: Base to Steer Motor 2 -->
        <joint name="steer_joint2" type="revolute">
            <origin xyz="0.21516 -0.28 0.12375"/>
            <parent link="base_link"/>
            <child link="steer_motor_link2"/>
            <axis xyz="0 0 1"/>
            <limit lower="${-PI/2}" upper="${PI/2}" effort="44" velocity="${PI}"/>
        </joint>

        <!-- Wheel Motor Link 2 -->
        <link name="wheel_motor_link2">
            <inertial>
                <origin xyz="2.6199E-06 -0.0015607 1.6573E-07"/>
                <mass value="5"/>
                <inertia ixx="0.00089952" ixy="6.9163E-08" ixz="-7.5368E-10" iyy="0.0015854" iyz="-7.6749E-12"
                         izz="0.00089958"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find galaxea_r1_description)/meshes/wheel_motor.obj"/>
                </geometry>
            </visual>
            <collision>
                <origin rpy="${PI/2} 0 0"/>
                <geometry>
                    <cylinder radius="0.07" length="0.048"/>
                </geometry>
            </collision>
        </link>

        <!-- Wheel Motor Joint 2: Steer Motor 2 to Wheel Motor 2 -->
        <joint name="wheel_joint2" type="continuous">
            <origin xyz="0 0 -0.09525"/>
            <parent link="steer_motor_link2"/>
            <child link="wheel_motor_link2"/>
            <axis xyz="0 1 0"/>
        </joint>

        <!-- Steer Motor Link 3 -->
        <link name="steer_motor_link3">
            <inertial>
                <origin xyz="-0.00098879 -0.034317 -0.034601"/>
                <mass value="1.2"/>
                <inertia ixx="8.8509E-05" ixy="3.7728E-06" ixz="-4.584E-09" iyy="7.5337E-05" iyz="-7.0145E-07"
                         izz="0.00010162"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find galaxea_r1_description)/meshes/steer_motor.obj"/>
                </geometry>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="file://$(find galaxea_r1_description)/meshes/steer_motor.obj"/>
                </geometry>
            </collision>
        </link>

        <!-- Steer Motor Joint 3: Base to Steer Motor 3 -->
        <joint name="steer_joint3" type="revolute">
            <origin xyz="-0.28084 0 0.12375"/>
            <parent link="base_link"/>
            <child link="steer_motor_link3"/>
            <axis xyz="0 0 1"/>
            <limit lower="${-PI/2}" upper="${PI/2}" effort="44" velocity="${PI}"/>
        </joint>

        <!-- Wheel Motor Link 3 -->
        <link name="wheel_motor_link3">
            <inertial>
                <origin xyz="2.6203E-06 0.0015607 -1.6564E-07"/>
                <mass value="5"/>
                <inertia ixx="0.00089952" ixy="-6.9072E-08" ixz="7.5036E-10" iyy="0.0015854" iyz="-7.845E-12"
                         izz="0.00089958"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find galaxea_r1_description)/meshes/wheel_motor.obj"/>
                </geometry>
            </visual>
            <collision>
                <origin rpy="${PI/2} 0 0"/>
                <geometry>
                    <cylinder radius="0.07" length="0.048"/>
                </geometry>
            </collision>
        </link>

        <!-- Wheel Motor Joint 3: Steer Motor 3 to Wheel Motor 3 -->
        <joint name="wheel_joint3" type="continuous">
            <origin xyz="0 0 -0.09525" rpy="0 0 ${PI}"/>
            <parent link="steer_motor_link3"/>
            <child link="wheel_motor_link3"/>
            <axis xyz="0 -1 0"/>
        </joint>

        <link name="left_lidar">
            <visual>
                <geometry>
                    <mesh filename="file://$(find sensor_models)/meshes/livox/mid360.glb"/>
                </geometry>
            </visual>
        </link>

        <joint name="left_lidar_joint" type="fixed">
            <origin xyz="0.203297 0.26215 0.233685 "/>
            <parent link="base_link"/>
            <child link="left_lidar"/>
        </joint>

        <link name="right_lidar">
            <visual>
                <geometry>
                    <mesh filename="file://$(find sensor_models)/meshes/livox/mid360.glb"/>
                </geometry>
            </visual>
        </link>

        <joint name="right_lidar_joint" type="fixed">
            <origin xyz="0.203297 -0.26215 0.233685 "/>
            <parent link="base_link"/>
            <child link="right_lidar"/>
        </joint>

        <link name="chassis_fl_camera">
            <visual>
                <geometry>
                    <mesh filename="file://$(find sensor_models)/meshes/usb_camera/camera_02.glb"/>
                </geometry>
            </visual>
        </link>

        <joint name="chassis_fl_camera_joint" type="fixed">
            <origin xyz="0.25625 0.132735 0.205 "/>
            <parent link="base_link"/>
            <child link="chassis_fl_camera"/>
        </joint>

        <link name="chassis_fr_camera">
            <visual>
                <geometry>
                    <mesh filename="file://$(find sensor_models)/meshes/usb_camera/camera_02.glb"/>
                </geometry>
            </visual>
        </link>

        <joint name="chassis_fr_camera_joint" type="fixed">
            <origin xyz="0.25625 -0.132735 0.205 "/>
            <parent link="base_link"/>
            <child link="chassis_fr_camera"/>
        </joint>

        <link name="chassis_right_camera">
            <visual>
                <geometry>
                    <mesh filename="file://$(find sensor_models)/meshes/usb_camera/camera_02.glb"/>
                </geometry>
            </visual>
        </link>

        <joint name="chassis_right_camera_joint" type="fixed">
            <origin xyz="0.02865 -0.32245 0.205 " rpy=" 0 0 ${-PI/2}"/>
            <parent link="base_link"/>
            <child link="chassis_right_camera"/>
        </joint>

        <link name="chassis_left_camera">
            <visual>
                <geometry>
                    <mesh filename="file://$(find sensor_models)/meshes/usb_camera/camera_02.glb"/>
                </geometry>
            </visual>
        </link>

        <joint name="chassis_left_camera_joint" type="fixed">
            <origin xyz="0.02865 0.32245 0.205 " rpy=" 0 0 ${PI/2}"/>
            <parent link="base_link"/>
            <child link="chassis_left_camera"/>
        </joint>

        <link name="chassis_back_camera">
            <visual>
                <geometry>
                    <mesh filename="file://$(find sensor_models)/meshes/usb_camera/camera_02.glb"/>
                </geometry>
            </visual>
        </link>

        <joint name="chassis_back_camera_joint" type="fixed">
            <origin xyz="-0.314835 0 0.217 " rpy=" 0 0 ${PI}"/>
            <parent link="base_link"/>
            <child link="chassis_back_camera"/>
        </joint>

    </xacro:macro>
</robot>
