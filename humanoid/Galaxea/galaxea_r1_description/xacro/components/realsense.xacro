<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
	<xacro:property name="PI" value="3.1415926535897931"/>

	<xacro:macro name="RealSense" params="side">
    <xacro:property name="side_prefix" value="${side + '_' if side else ''}"/>

    <!-- Hand camera stand link -->
    <link name="${side_prefix}hand_camera_stand_link">
      <inertial>
        <origin xyz="0.022169 0.0060171 -0.017353"/>
        <mass value="0.175"/>
        <inertia ixx="6.965E-06" ixy="2.6612E-06" ixz="1.2797E-06" iyy="2.3281E-05" iyz="-1.4268E-06" izz="2.5513E-05"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="file://$(find galaxea_r1_description)/meshes/hand_camera_stand.glb"/>
        </geometry>
      </visual>
    </link>

    <!-- Hand camera link -->
    <link name="${side_prefix}hand_camera_link">
      <visual>
        <geometry>
          <mesh filename="file://$(find sensor_models)/meshes/realsense/d435.glb"/>
        </geometry>
      </visual>
    </link>

    <joint name="${side_prefix}hand_camera_joint" type="fixed">
      <origin xyz="0.0325 0 0"/>
      <parent link="${side_prefix}hand_camera_stand_link"/>
      <child link="${side_prefix}hand_camera_link"/>
    </joint>

    <!-- Hand camera stand joint: Arm 6 to camera stand -->
    <joint name="${side_prefix}hand_camera_stand_joint" type="fixed">
      <xacro:if value="${side == 'left'}">
        <origin xyz="0.098768 0.0021071 0.05055" rpy="-2.0071 0.0077831 ${-PI/2}"/>
        <parent link="left_link6"/>
      </xacro:if>
      <xacro:if value="${side == 'right'}">
        <origin xyz="0.098762 0.0021071 -0.05055" rpy="1.1344 -0.0077831 ${PI/2}"/>
        <parent link="right_link6"/>
      </xacro:if>
      <child link="${side_prefix}hand_camera_stand_link"/>
    </joint>
  </xacro:macro>
</robot>
