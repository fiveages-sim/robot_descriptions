;=============================================================================
; Self Collision
;=============================================================================

selfCollision
{
    activate                        false
    mu                              1e-2
    delta                           1e-3
    minimumDistance                  0.02

    collisionLinkPairs
    {
    }

    collisionObjectPairs
    {
          [0] "torso_link4, left_link3",
          [1] "torso_link4, left_link4",
          [2] "torso_link4, left_link5",
          [3] "torso_link4, left_link7",
          [4] "torso_link4, right_link3",
          [5] "torso_link4, right_link4",
          [6] "torso_link4, right_link5",
          [7] "torso_link4, right_link7",
    }
}
