    upperBound
    {
        base
        {
            wheelBasedMobileManipulator
            {
                (0,0)   0.2     ; linear velocity
                (1,0)   0.2     ; angular velocity (yaw rate)
            }
        }

        arm
        {
            (0,0)  0.013        ; torso_joint1 [rad/s]
            (1,0)  2.088        ; torso_joint2 [rad/s]
            (2,0)  2.082        ; torso_joint3 [rad/s]
            (3,0)  3.270        ; torso_joint4 [rad/s]
            (4,0)  7.1209       ; left_joint1 [rad/s]
            (5,0)  7.1209       ; left_joint2 [rad/s]
