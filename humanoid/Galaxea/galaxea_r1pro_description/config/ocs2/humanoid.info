            (14,0) -8.3776      ; right_joint4 [rad/s]
            (15,0) -10.4720     ; right_joint5 [rad/s]
            (16,0) -10.4720     ; right_joint6 [rad/s]
            (17,0) -10.4720     ; right_joint7 [rad/s]
        }
