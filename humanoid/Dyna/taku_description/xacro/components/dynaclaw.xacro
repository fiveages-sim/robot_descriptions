<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="PI" value="3.141592653589793"/>
  <!-- INFERRED, NOT AN OFFICIAL DYNA SPEC. Dynaclaw = two prismatic jaws (front/rear).
       No separate gripper base link exists in dvt1_kin.json; jaws mount on the wrist_roll.
       One jaw mesh (grippera_link.glb), shared by both sides. gripperb is that mesh
       rotated 180 deg about z. Actuated joint is ${prefix}gripper_joint (0=closed,
       0.0345=open); the opposite jaw is ${prefix}gripper_mimic_joint with multiplier -1.
       See doc/taku_params.md. -->

  <!-- Astribot-style name-prefixed macro. name:="left"|"right"|"" ; parent_link defaults to ${prefix}wrist_roll_link. -->
  <xacro:macro name="TakuDynaclaw" params="name:='' parent_link:='' collider:='simple'">
    <xacro:property name="prefix" value="${name + '_' if name else ''}"/>
    <xacro:property name="parent" value="${parent_link if parent_link else prefix + 'wrist_roll_link'}"/>

    <!-- Driven jaw (rear / gripperb): +Y opens. Standard name: left_/right_gripper_joint. -->
    <link name="${prefix}gripperb_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 ${PI}"/>
        <geometry>
          <mesh filename="file://$(find taku_description)/meshes/dynaclaw/grippera_link.glb"/>
        </geometry>
      </visual>
      <xacro:if value="${collider == 'convex'}">
        <collision>
          <origin xyz="0 0 0" rpy="0 0 ${PI}"/>
          <geometry>
            <mesh filename="file://$(find taku_description)/meshes/dynaclaw/grippera_link.glb"/>
          </geometry>
        </collision>
      </xacro:if>
      <xacro:if value="${collider == 'simple'}">
        <!-- Jaw AABB in link frame (mesh center ≈ -0.001 0.002 -0.023). -->
        <collision>
          <origin xyz="-0.0013 0.0016 -0.023" rpy="0 0 ${PI}"/>
          <geometry>
            <box size="0.040 0.040 0.100"/>
          </geometry>
        </collision>
      </xacro:if>
    </link>
    <joint name="${prefix}gripper_joint" type="prismatic">
      <origin xyz="-0.028088 0.023048 -0.166971"/>
      <parent link="${parent}"/>
      <child link="${prefix}gripperb_link"/>
      <axis xyz="0.0 1.0 0.0"/>
      <limit lower="0.0" upper="0.0345" effort="100" velocity="0.25"/>
    </joint>

    <link name="${prefix}gripper_tip_B"/>
    <joint name="${prefix}gripper_tip_B_frame" type="fixed">
      <origin xyz="-0.000432 -0.023068 -0.080556"/>
      <parent link="${prefix}gripperb_link"/>
      <child link="${prefix}gripper_tip_B"/>
    </joint>

    <!-- Opposite jaw (front / grippera): mimics gripper_joint with q_front = -q_gripper. -->
    <link name="${prefix}grippera_link">
      <visual>
        <geometry>
          <mesh filename="file://$(find taku_description)/meshes/dynaclaw/grippera_link.glb"/>
        </geometry>
      </visual>
      <xacro:if value="${collider == 'convex'}">
        <collision>
          <geometry>
            <mesh filename="file://$(find taku_description)/meshes/dynaclaw/grippera_link.glb"/>
          </geometry>
        </collision>
      </xacro:if>
      <xacro:if value="${collider == 'simple'}">
        <collision>
          <origin xyz="-0.0013 0.0016 -0.023"/>
          <geometry>
            <box size="0.040 0.040 0.100"/>
          </geometry>
        </collision>
      </xacro:if>
    </link>
    <joint name="${prefix}gripper_mimic_joint" type="prismatic">
      <origin xyz="-0.028953 -0.023048 -0.166971"/>
      <parent link="${parent}"/>
      <child link="${prefix}grippera_link"/>
      <axis xyz="0.0 1.0 0.0"/>
      <limit lower="-0.0345" upper="0.0" effort="100" velocity="0.25"/>
      <mimic joint="${prefix}gripper_joint" multiplier="-1" offset="0"/>
    </joint>

    <link name="${prefix}gripper_tip_A"/>
    <joint name="${prefix}gripper_tip_A_frame" type="fixed">
      <origin xyz="0.000433 0.023068 -0.080556"/>
      <parent link="${prefix}grippera_link"/>
      <child link="${prefix}gripper_tip_A"/>
    </joint>
  </xacro:macro>

  <!-- Back-compat alias used by older includes. -->
  <xacro:macro name="TakuGripper" params="side:=left collider:='simple'">
    <xacro:TakuDynaclaw name="${side}" collider="${collider}"/>
  </xacro:macro>
</robot>
