; OCS2 fixed-base TCP config for Dyna Taku / DVT1 (INFERRED description).
; Adapted from FiveAges W2 / Ai2 Bot2 wheel-humanoid layout.
; State / input follows Pinocchio DFS on the planning URDF:
;   [folding(2)+waist(2) | left arm(7) | right arm(7) | head(3)] = 21
; Head limits: yaw ±90°, pitch ±20°, roll ±15° (calibrated). No official Dyna dynamics —
; arm jointVelocityLimits ±1.57 rad/s; folding/waist/head stay conservative.
; selfCollision uses collider:=simple chest box + arm cylinders (skill
; split-chassis-glb §8); do not pair against visual GLB collision meshes.

model_information
{
    manipulatorModelType    0

    baseFrame               "base_footprint"
    eeFrame                 "left_tcp"
    eeFrame1                "right_tcp"
    bodyFrame               "torso_tracking_frame"
    headFrame               "head_roll_link"

    removeJoints
    {
        [0]   "agv_right_front_steering_joint"
        [1]   "agv_right_front_rotate_joint"
        [2]   "agv_right_back_steering_joint"
        [3]   "agv_right_back_rotate_joint"
        [4]   "agv_left_front_steering_joint"
        [5]   "agv_left_front_rotate_joint"
        [6]   "agv_left_back_steering_joint"
        [7]   "agv_left_back_rotate_joint"
        [8]   "left_gripper_joint"
        [9]   "left_gripper_mimic_joint"
        [10]  "right_gripper_joint"
        [11]  "right_gripper_mimic_joint"
    }
}

model_settings
{
    usePreComputation       true
    recompileLibraries      true
}

; State dim = 21: body(4)+left(7)+right(7)+head(3).
; Arm zeros use URDF-baked shoulder roll/yaw (+90 deg in both arms' joint origins).
initialState
{
    arm
    {
        (0,0)   0.0     ; folding_low_joint
        (1,0)   0.0     ; folding_high_joint
        (2,0)   0.0     ; waist_pitch_joint
        (3,0)   0.0     ; waist_yaw_joint
        (4,0)   0.0     ; left_shoulder_pitch_joint
        (5,0)   0.0     ; left_shoulder_roll_joint (URDF origin +90 deg)
        (6,0)   0.0     ; left_shoulder_yaw_joint (URDF origin +90 deg)
        (7,0)   0.0     ; left_elbow_joint
        (8,0)   0.0     ; left_wrist_yaw_joint
        (9,0)   0.0     ; left_wrist_pitch_joint
        (10,0)  0.0     ; left_wrist_roll_joint
        (11,0)  0.0     ; right_shoulder_pitch_joint
        (12,0)  0.0     ; right_shoulder_roll_joint (URDF origin +90 deg)
        (13,0)  0.0     ; right_shoulder_yaw_joint (URDF origin +90 deg)
        (14,0)  0.0     ; right_elbow_joint
        (15,0)  0.0     ; right_wrist_yaw_joint
        (16,0)  0.0     ; right_wrist_pitch_joint
        (17,0)  0.0     ; right_wrist_roll_joint
        (18,0)  0.0     ; head_yaw_joint
        (19,0)  0.0     ; head_pitch_joint
        (20,0)  0.0     ; head_roll_joint
    }
}

initialModeSchedule
{
    eventTimes
    {
    }
    modeSequence
    {
        [0]
        {
            bodyMode "HM_DUAL_RELATIVE_FIXED_BASE"
            headMode "HEAD_GAZE"
        }
    }
}

ddp
{
    algorithm                       SLQ
    nThreads                        3
    threadPriority                  50
    maxNumIterations                1
    minRelCost                      0.1
    constraintTolerance             1e-3
    displayInfo                     false
    displayShortSummary             false
    checkNumericalStability         false
    debugPrintRollout               false
    debugCaching                    false
    AbsTolODE                       1e-5
    RelTolODE                       1e-3
    maxNumStepsPerSecond            100000
    timeStep                        1e-3
    backwardPassIntegratorType      ODE45
    constraintPenaltyInitialValue   20.0
    constraintPenaltyIncreaseRate   2.0
    preComputeRiccatiTerms          true
    useFeedbackPolicy               false
    strategy                        LINE_SEARCH
    lineSearch
    {
        minStepLength                   1e-2
        maxStepLength                   1.0
        hessianCorrectionStrategy       DIAGONAL_SHIFT
        hessianCorrectionMultiple       1e-3
    }
}

mpc
{
    timeHorizon                     1.0
    solutionTimeWindow              0.2
    coldStart                       false
    debugPrint                      false
    mpcDesiredFrequency             100
    mrtDesiredFrequency             500
}

rollout
{
    AbsTolODE                       1e-5
    RelTolODE                       1e-3
    timeStep                        1e-2
    integratorType                  ODE45
    maxNumStepsPerSecond            100000
    checkNumericalStability         false
}

bodyTrackingEE
{
    activate  true
    muPosition 5.0
    muOrientation 5.0
}

headTrackingEE
{
    activate  true
    muPosition 5.0
    muOrientation 5.0
}

; Input layout: [body(4) | left(7) | right(7) | head(3)]
inputCost
{
    R
    {
        arm
        {
            scaling 1e-3
            (0,0)   5.0     ; folding_low
            (1,1)   5.0     ; folding_high
            (2,2)   3.0     ; waist_pitch
            (3,3)   2.0     ; waist_yaw
            (4,4)   1.5     ; left_shoulder_pitch
            (5,5)   1.5     ; left_shoulder_roll
            (6,6)   1.5     ; left_shoulder_yaw
            (7,7)   1.5     ; left_elbow
            (8,8)   1.1     ; left_wrist_yaw
            (9,9)   1.1     ; left_wrist_pitch
            (10,10) 1.1     ; left_wrist_roll
            (11,11) 1.5     ; right_shoulder_pitch
            (12,12) 1.5     ; right_shoulder_roll
            (13,13) 1.5     ; right_shoulder_yaw
            (14,14) 1.5     ; right_elbow
            (15,15) 1.1     ; right_wrist_yaw
            (16,16) 1.1     ; right_wrist_pitch
            (17,17) 1.1     ; right_wrist_roll
            (18,18) 0.1     ; head_yaw
            (19,19) 0.1     ; head_pitch
            (20,20) 0.1     ; head_roll
        }
    }
}

endEffector
{
    muPosition                      10.0
    muOrientation                   5.0
}

finalEndEffector
{
    muPosition                      20.0
    muOrientation                   10.0
}

bodyRelative
{
    activate                        true
    ; Zero-pose torso_tracking_frame is x≈-0.21 in base_link (folding zigzag),
    ; not Bot2's forward [0, 0.25]. Band around rest so RELATIVE/vertical
    ; does not yank the torso forward/up.
    xLowerBound                     -0.35
    xUpperBound                     -0.05
    muPosition                      5.0
    muOrientation                   5.0
}

bimanualCoupling
{
    activate                        true
    muPosition                      10.0
    muOrientation                   1.25
}

; Head starts after both arms (URDF declares arms before head under torso / arm_base).
headInputStart                          18

waistLock
{
    activate                        true
    numJoints                       4
}

; Couple waist_yaw (3) with head_yaw (18) when body mode is HEAD_COUPLED.
headCoupling
{
    activate                        true
    waistJointIndex                 3
    headJointIndex                  18
    alpha                           1.0
    lockedWaistJoints
    {
        [0] 0
        [1] 1
        [2] 2
    }
}

customJointLock
{
    activate                        true
    lockedJointIndices
    {
        [0] 0                       ; folding_low_joint
        [1] 1                       ; folding_high_joint
    }
}

headMidpointGaze
{
    activate                    true
    cameraFrame                 "head_camera_mid_optical_frame"
    fx                          611.864502
    fy                          611.478271
    cx                          638.961182
    cy                          363.642456
    width                       1280
    height                      720
    horizontalDeadbandDeg       10.0
    verticalDeadbandDeg         10.0
    muAlignmentHorizontal       1.0
    muAlignmentVertical         1.0
    muFront                     1.0
    muUpright                   1.0     ; 3-DoF: keep camera +X world-horizontal (gravity-level head)
    uprightDeadbandDeg          2.0     ; roll deadband; inside the band upright does not act
    minDepth                    0.3
}

; Soft pull toward controller HOME (exclude folding_low/high under custom lock).
homeJointReference
{
    activate                        true
    activateDefault                 true
    mu                              1e-3
    excludeJointIndices
    {
        [0] 0
        [1] 1
    }
}

armLock
{
    activate                        true
    leftNumJoints                   7
    rightNumJoints                  7
}

jointPositionLimits
{
    activate                        true
    mu                              1e-3
    delta                           1e-3
}

; Soft velocity barriers. Arms ±1.57 rad/s; folding/waist ±0.5; head ±1.0.
jointVelocityLimits
{
    mu                              1e-2
    delta                           1e-3
    lowerBound
    {
        arm
        {
            (0,0)  -0.5
            (1,0)  -0.5
            (2,0)  -0.5
            (3,0)  -0.5
            (4,0)  -1.57
            (5,0)  -1.57
            (6,0)  -1.57
            (7,0)  -1.57
            (8,0)  -1.57
            (9,0)  -1.57
            (10,0) -1.57
            (11,0) -1.57
            (12,0) -1.57
            (13,0) -1.57
            (14,0) -1.57
            (15,0) -1.57
            (16,0) -1.57
            (17,0) -1.57
            (18,0) -1.0     ; head_yaw
            (19,0) -1.0     ; head_pitch
            (20,0) -1.0     ; head_roll
        }
    }
    upperBound
    {
        arm
        {
            (0,0)  0.5
            (1,0)  0.5
            (2,0)  0.5
            (3,0)  0.5
            (4,0)  1.57
            (5,0)  1.57
            (6,0)  1.57
            (7,0)  1.57
            (8,0)  1.57
            (9,0)  1.57
            (10,0) 1.57
            (11,0) 1.57
            (12,0) 1.57
            (13,0) 1.57
            (14,0) 1.57
            (15,0) 1.57
            (16,0) 1.57
            (17,0) 1.57
            (18,0) 1.0
            (19,0) 1.0
            (20,0) 1.0
        }
    }
}

; Chest box + arm cylinders (collider:=simple default). Do not use collider:=convex
; with activate true — GLB hpp-fcl stalls WBC (skill split-chassis-glb §8).
selfCollision
{
    activate                        false
    mu                              1e-3
    delta                           1e-2
    minimumDistance                 0.01
    collisionObjectPairs
    {
    }
    collisionLinkPairs
    {
        [0] "torso_body_link, left_elbow_link",
        [1] "torso_body_link, left_wrist_yaw_link",
        [2] "torso_body_link, left_wrist_roll_link",
        [3] "torso_body_link, right_elbow_link",
        [4] "torso_body_link, right_wrist_yaw_link",
        [5] "torso_body_link, right_wrist_roll_link",
    }
}
