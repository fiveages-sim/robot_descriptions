<?xml version="1.0" encoding="utf-8"?>
<robot name="mmk2" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Lift column + slide + head. Athena2 chassis (base_link) is in components/athena2.xacro. -->
  <xacro:arg name="isaac" default="false"/>
  <xacro:property name="PI" value="3.1415926535897931"/>

  <!-- Inertia is a uniform vertex estimate from base.glb (33.0267 kg - 22 kg chassis). -->
  <link name="column_link">
    <inertial>
      <origin xyz="0.02770384 -0.01752595 0.92371276"/>
      <mass value="11.0267456398628"/>
      <inertia ixx="1.67600101" ixy="7.14865869e-03" ixz="6.99424988e-02"
               iyy="1.71496731" iyz="-8.18474324e-03" izz="0.10425998"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="file://$(find airbot_mmk2_description)/meshes/base.glb"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="file://$(find airbot_mmk2_description)/meshes/base.glb"/>
      </geometry>
    </collision>
  </link>
  <joint name="column_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="column_link"/>
  </joint>

  <link name="slide_link">
    <inertial>
      <origin xyz="-7.90494393625066E-05 0.067355217450789 0.10519083626064"/>
      <mass value="2.87043102920673"/>
      <inertia ixx="0.00899755064402379" ixy="6.09937870252811E-07" ixz="2.90775161414524E-06" iyy="0.0119634133355932"
               iyz="-0.000250919444280722" izz="0.00864817587777869"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="file://$(find airbot_mmk2_description)/meshes/slide.glb"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="file://$(find airbot_mmk2_description)/meshes/slide.glb"/>
      </geometry>
    </collision>
  </link>

  <joint name="body_joint" type="prismatic">
    <origin xyz="0.033942 -0.00025 1.406" rpy="3.1416 0 1.5708"/>
    <parent link="column_link"/>
    <child link="slide_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.04" upper="0.87" effort="500" velocity="0.3"/>
  </joint>

  <!-- ROS-aligned (X forward, Y left, Z up) torso frame for OCS2 bodyFrame: slide_link is flipped
       (rpy π 0 π/2); this fixed rpy is its own inverse, so the frame coincides with base_link axes. -->
  <link name="torso_tracking_frame"/>
  <joint name="torso_tracking_joint" type="fixed">
    <origin xyz="0 0 0" rpy="3.1416 0 1.5708"/>
    <parent link="slide_link"/>
    <child link="torso_tracking_frame"/>
  </joint>

  <link name="head_yaw_link">
    <inertial>
      <origin xyz="0.0118490941462296 0.000491254783341499 0.0390231494943873"/>
      <mass value="0.263127360420809"/>
      <inertia ixx="0.000185798854547827" ixy="2.64309797822853E-07" ixz="-2.93582511724902E-05"
               iyy="0.000173833362201622" iyz="-2.8054841555532E-06" izz="9.38655776831082E-05"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="file://$(find airbot_mmk2_description)/meshes/head_yaw.glb"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="file://$(find airbot_mmk2_description)/meshes/head_yaw.glb"/>
      </geometry>
    </collision>
  </link>

  <joint name="head_joint1" type="revolute">
    <origin xyz="0 0.1735 0.07242" rpy="3.1416 0 0"/>
    <parent link="slide_link"/>
    <child link="head_yaw_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.5" upper="0.5" effort="2" velocity="0.2"/>
  </joint>

  <link name="head_pitch_link">
    <inertial>
      <origin xyz="0.0244659096221799 -0.108421751901101 -0.00311687659834824"/>
      <mass value="0.500765947013434"/>
      <inertia ixx="0.00157924187002826" ixy="2.16781765858799E-05" ixz="-1.02638171835218E-06"
               iyy="0.000804096450222595" iyz="1.48815549401623E-05" izz="0.00113048749298996"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="file://$(find airbot_mmk2_description)/meshes/head_pitch.glb"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="file://$(find airbot_mmk2_description)/meshes/head_pitch.glb"/>
      </geometry>
    </collision>
  </link>

  <joint name="head_joint2" type="revolute">
    <origin xyz="0.00099952 3.1059E-05 0.058" rpy="-1.5708 0 -1.5397"/>
    <parent link="head_yaw_link"/>
    <child link="head_pitch_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.16" upper="1.18" effort="2" velocity="0.2"/>
  </joint>

  <!-- head_camera: D435i on head_pitch_link, ROS optical (+Z forward, +X right, +Y down).
       Mount: xyz 0.078533 -0.18391 0. Orientation is 90 deg about Y (forward optical)
       plus 18 deg about Z (PI/10). Used by OCS2 headMidpointGaze (HEAD_GAZE).
       d435.glb is already optical-aligned; hidden when isaac:=true. -->
  <link name="head_camera">
    <xacro:unless value="$(arg isaac)">
      <visual>
        <geometry>
          <mesh filename="file://$(find sensor_models)/meshes/realsense/d435.glb"/>
        </geometry>
      </visual>
    </xacro:unless>
  </link>
  <joint name="head_camera_joint" type="fixed">
    <origin xyz="0.078533 -0.18391 0" rpy="0 ${PI/2} ${PI/10}"/>
    <parent link="head_pitch_link"/>
    <child link="head_camera"/>
  </joint>
</robot>
