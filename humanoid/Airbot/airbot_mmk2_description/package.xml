<package format="2">
  <name>airbot_mmk2_description</name>
  <version>1.0.0</version>
  <description>
    <p>URDF Description package for Airbot MMK2 wheeled dual-arm robot</p>
    <p>This package contains xacro, meshes and OCS2 / ros2_control configuration
      for the Airbot MMK2 (slide + head + dual Airbot Play arms)
    </p>
  </description>
  <author>TODO</author>
  <maintainer email="TODO@email.com"/>
  <license>BSD</license>

  <depend>airbot_play_description</depend>
  <exec_depend>sensor_models</exec_depend>
  <exec_depend>component_models</exec_depend>
  <exec_depend>robot_common_launch</exec_depend>
  <exec_depend>xhand1_description</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>