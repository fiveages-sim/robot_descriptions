; DexForce W1 — dual 7-DOF arms (ocs2_arm_controller / demo / split_body)
; Arms only. Body / head via basic_joint controllers; grippers via adaptive_gripper.
; Planning URDF: topology:=dual rooted at `waist` (torso mount of both arm bases); the
; body/head/wheel entries below are only a fallback when the full tree is used.
; PGC_140_50 jaws are listed; Revo1 fingers are fixed by xacro (eef_fixed_joints:=true).
; State / input = 14: [left(7) | right(7)]
model_information
{
    manipulatorModelType    0

    baseFrame               "waist"
    eeFrame                 "left_eef"
    eeFrame1                "right_eef"

    removeJoints
    {
    [0]   "body_joint1"
    [1]   "body_joint2"
    [2]   "body_joint3"
    [3]   "body_joint4"
    [4]   "head_joint1"
    [5]   "head_joint2"
    [6]   "WHEEL_LEFT"
    [7]   "WHEEL_RIGHT"
    [8]   "left_gripper_joint"
    [9]   "left_finger2_joint"
    [10]   "right_gripper_joint"
    [11]   "right_finger2_joint"
    }
}

model_settings
{
    usePreComputation       true
    recompileLibraries      true
}

ddp
{
    algorithm                       SLQ
    nThreads                        3
    threadPriority                  50
    maxNumIterations                1
    minRelCost                      0.1
    constraintTolerance             1e-3
    displayInfo                     false
    displayShortSummary             false
    checkNumericalStability         false
    debugPrintRollout               false
    debugCaching                    false
    AbsTolODE                       1e-5
    RelTolODE                       1e-3
    maxNumStepsPerSecond            100000
    timeStep                        1e-3
    backwardPassIntegratorType      ODE45
    constraintPenaltyInitialValue   20.0
    constraintPenaltyIncreaseRate   2.0
    preComputeRiccatiTerms          true
    useFeedbackPolicy               false
    strategy                        LINE_SEARCH
    lineSearch
    {
        minStepLength                   1e-2
        maxStepLength                   1.0
        hessianCorrectionStrategy       DIAGONAL_SHIFT
        hessianCorrectionMultiple       1e-3
    }
}

rollout
{
    AbsTolODE                       1e-5
    RelTolODE                       1e-3
    timeStep                        1e-2
    integratorType                  ODE45
    maxNumStepsPerSecond            100000
    checkNumericalStability         false
}

mpc
{
    timeHorizon                     1.0
    solutionTimeWindow              0.2
    coldStart                       false
    debugPrint                      false
    mpcDesiredFrequency             100
    mrtDesiredFrequency             400
}

