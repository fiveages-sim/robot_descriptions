<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>moz1_description</name>
  <version>0.1.0</version>
  <description>URDF/xacro description for Spirit AI MOZ1 humanoid (omni chassis, dual 7-DOF arms, OmniPicker gripper).</description>
  <maintainer email="gekeyu@spirit-ai.com">spiritai</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>agibot_omni_description</exec_depend>
  <exec_depend>component_models</exec_depend>
  <exec_depend>sensor_models</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
