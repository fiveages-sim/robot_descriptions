            <mesh filename="file://$(find moz1_description)/meshes/left02.STL" />
          </geometry>
        </collision>
      </link>

      <joint name="LeftArm-1" type="revolute">
        <origin xyz="0.079 0 0" rpy="0 0 0" />
        <parent link="left01" />
        <child link="left02" />
        <axis xyz="0 1 0" />
        <limit lower="-2.967059728" upper="0.157079633" effort="0" velocity="0" />
      </joint>

