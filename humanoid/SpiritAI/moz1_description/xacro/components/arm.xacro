<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="moz1_arm" params="direction:=1">
    <xacro:if value="${direction == 1}">

      <link name="left01">
        <visual>
          <geometry>
            <mesh filename="file://$(find moz1_description)/meshes/left01.STL" />
          </geometry>
          <material name="">
            <color rgba="0.8 0.8 0.8 1.0" />
          </material>
        </visual>
        <collision>
          <geometry>
            <mesh filename="file://$(find moz1_description)/meshes/left01.STL" />
          </geometry>
        </collision>
      </link>

      <link name="left02">
