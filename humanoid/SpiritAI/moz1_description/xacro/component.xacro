<?xml version="1.0"?>
<robot name="MOZ1" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="type" default="chassis"/>
  <!-- Isaac asset import: hide sensor_models meshes that Isaac already provides. -->
  <xacro:arg name="isaac" default="false"/>
  <xacro:include filename="$(find moz1_description)/xacro/components/chassis.xacro"/>
  <xacro:include filename="$(find moz1_description)/xacro/components/body.xacro"/>
  <xacro:include filename="$(find moz1_description)/xacro/components/arm.xacro"/>
  <xacro:include filename="$(find moz1_description)/xacro/components/head.xacro"/>
  <xacro:include filename="$(find moz1_description)/xacro/components/omni_gripper.xacro"/>

  <xacro:if value="${'$(arg type)' == 'wheel'}">
    <xacro:include filename="$(find component_models)/xacro/angellun_200.xacro"/>
    <xacro:wheel wheel_name="wheel" enable_passive_wheels="true"/>
  </xacro:if>

  <!-- Chassis module: drive joints only (empty wheel links), no wheel mesh. -->
  <xacro:if value="${'$(arg type)' == 'chassis'}">
    <xacro:Moz1Chassis enable_wheel_joints="true"/>
  </xacro:if>

  <xacro:if value="${'$(arg type)' == 'body'}">
    <link name="base_link"/>
    <xacro:Moz1Body parent_link="base_link"/>
  </xacro:if>

  <!-- Upper body: 6-DoF torso + head + dual arms (no chassis/gripper). -->
  <xacro:if value="${'$(arg type)' == 'upper_body'}">
    <link name="base_link"/>
    <xacro:Moz1Body parent_link="base_link"/>
    <xacro:Moz1Head parent_link="waist03" isaac="$(arg isaac)"/>
    <xacro:Moz1Arm parent_link="waist03" direction="1" enable_gripper="false"/>
    <xacro:Moz1Arm parent_link="waist03" direction="-1" enable_gripper="false"/>
  </xacro:if>

  <xacro:if value="${'$(arg type)' == 'left_arm'}">
    <link name="waist03"/>
    <xacro:Moz1Arm parent_link="waist03" direction="1"/>
  </xacro:if>

  <xacro:if value="${'$(arg type)' == 'right_arm'}">
    <link name="waist03"/>
    <xacro:Moz1Arm parent_link="waist03" direction="-1"/>
  </xacro:if>

  <xacro:if value="${'$(arg type)' == 'arm'}">
    <link name="waist03"/>
    <xacro:Moz1Arm parent_link="waist03" direction="1"/>
    <xacro:Moz1Arm parent_link="waist03" direction="-1"/>
  </xacro:if>

  <xacro:if value="${'$(arg type)' == 'head'}">
    <link name="waist03"/>
    <xacro:Moz1Head parent_link="waist03" isaac="$(arg isaac)"/>
  </xacro:if>

  <xacro:if value="${'$(arg type)' == 'gripper'}">
    <link name="left07"/>
    <xacro:Moz1OmniGripper side="left"/>
    <link name="right07"/>
    <xacro:Moz1OmniGripper side="right"/>
  </xacro:if>
</robot>
