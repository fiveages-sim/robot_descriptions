<?xml version="1.0"?>
<robot name="MOZ1" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="ros2_control_hardware_type" default="mock_components"/>
  <xacro:arg name="enable_wheel_joints" default="false"/>
  <xacro:arg name="eef_fixed_joints" default="false"/>
  <xacro:arg name="gazebo" default="false"/>

  <xacro:include filename="$(find moz1_description)/xacro/robot.xacro"/>
  <xacro:include filename="$(find moz1_description)/xacro/ros2_control/body_interfaces.xacro"/>
  <xacro:include filename="$(find moz1_description)/xacro/ros2_control/head_interfaces.xacro"/>
  <xacro:include filename="$(find moz1_description)/xacro/ros2_control/arm_interfaces.xacro"/>
  <xacro:include filename="$(find agibot_omni_description)/xacro/ros2_control/omni_picker.xacro"/>

  <ros2_control name="moz1_system" type="system">
    <hardware>
      <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'gz'}">
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </xacro:if>
      <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'mock_components'}">
        <plugin>mock_components/GenericSystem</plugin>
      </xacro:if>
      <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'isaac'}">
        <plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
        <param name="joint_commands_topic">/isaac/joint_command</param>
        <param name="joint_states_topic">/isaac/joint_states</param>
        <param name="sum_wrapped_joint_states">false</param>
        <param name="initialize_commands_from_state">true</param>
      </xacro:if>
    </hardware>

    <xacro:moz1_body_interfaces/>
    <xacro:moz1_head_interfaces/>
    <xacro:moz1_arm_interfaces direction="1"/>
    <xacro:moz1_arm_interfaces direction="-1"/>
    <xacro:omni_picker_interfaces name="left"/>
    <xacro:omni_picker_interfaces name="right"/>
  </ros2_control>

  <xacro:if value="$(arg gazebo)">
    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find moz1_description)/config/ros2_control/ros2_controllers.yaml</parameters>
      </plugin>
    </gazebo>
  </xacro:if>

</robot>
