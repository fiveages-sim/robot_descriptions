;=============================================================================
; Self Collision
;=============================================================================

selfCollision
{
    activate                        false
    mu                              1e-2
    delta                           1e-3
    minimumDistance                 0.02

    ; Collision link pairs to check
    collisionLinkPairs
    {
    }

    ; Collision object pairs (by index)
    collisionObjectPairs
    {
          [0] "waist03, left04",
          [1] "waist03, left05",
          [2] "waist03, left07",
          [3] "waist03, right04",
          [4] "waist03, right05",
          [5] "waist03, right07",
          [6] "waist03, right03",
          [7] "waist03, left03",
    }
}

