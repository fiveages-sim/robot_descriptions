            (14,0) -3.665      ; RightArm-1  210 deg/s
            (15,0) -4.189      ; RightArm-2  240 deg/s
            (16,0) -4.189      ; RightArm-3  240 deg/s
            (17,0) -5.236      ; RightArm-4  300 deg/s
            (18,0) -5.236      ; RightArm-5  300 deg/s
            (19,0) -5.236      ; RightArm-6  300 deg/s
