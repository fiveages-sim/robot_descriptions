; Zerith H1 — full-body WBC with differential chassis (ocs2_wbc_controller)
; ========================================================================
; manipulatorModelType 1 = WheelBasedMobileManipulator (virtual unicycle).
; Physical drive wheels + casters stay locked (chassis_joints_movable:=false /
; removeJoints). Chassis motion is planned as base vx / omega only; WBC publishes
; /cmd_vel when world→base_footprint TF is available and BASE_UNLOCK.
; Arm state after removeJoints (Pinocchio 4 name-order under body_yaw_link):
;   [body×3 | head×2 | left×7 | right×7] = 19
; Full state = 3 (x,y,yaw) + 19 = 22; full input = 2 (vx,omega) + 19 = 21.
; headInputStart / customJointLock use FULL input indices (+2 base).
; homeJointReference.excludeJointIndices stay arm-segment indices (no base offset).
; bodyRelative band kept from fixed_base_tcp (zero-pose body_yaw_link x≈0.15 in base).
; Peers: W2 mobile_base_tcp (type 1) + Taku (RELATIVE_MOBILE_BASE + HEAD_GAZE).

model_information
{
    manipulatorModelType    1

    baseFrame               "base_footprint"
    eeFrame                 "left_eef"
    eeFrame1                "right_eef"
    bodyFrame               "body_yaw_link"
    headFrame               "neck_pitch_link"

    ; Grippers + mimics; chassis wheels listed for movable URDF fallback
    removeJoints
    {
        [0]   "left_gripper_joint"
        [1]   "right_gripper_joint"
        [2]   "left_jaw_right_finger_joint"
        [3]   "right_jaw_right_finger_joint"
        [4]   "left_wheel_joint"
        [5]   "right_wheel_joint"
        [6]   "left_front_caster_swivel_joint"
        [7]   "left_front_wheel_joint"
        [8]   "left_rear_caster_swivel_joint"
        [9]   "left_rear_wheel_joint"
        [10]  "right_front_caster_swivel_joint"
        [11]  "right_front_wheel_joint"
        [12]  "right_rear_caster_swivel_joint"
        [13]  "right_rear_wheel_joint"
    }
}

model_settings
{
    usePreComputation       true
    recompileLibraries      true
}

initialState
{
    base
    {
        wheelBasedMobileManipulator
        {
            (0,0)  0.0   ; x [m]
            (1,0)  0.0   ; y [m]
            (2,0)  0.0   ; yaw [rad]
        }
    }

    arm
    {
        (0,0)   0.0     ; body_joint1 lift [m]
        (1,0)   0.0     ; body_joint2 pitch
        (2,0)   0.0     ; body_joint3 yaw
        (3,0)   0.0     ; head_joint1 yaw
        (4,0)   0.0     ; head_joint2 pitch
        (5,0)   0.0     ; left_joint1
        (6,0)   0.0     ; left_joint2
        (7,0)   0.0     ; left_joint3
        (8,0)   0.0     ; left_joint4
        (9,0)   0.0     ; left_joint5
        (10,0)  0.0     ; left_joint6
        (11,0)  0.0     ; left_joint7
        (12,0)  0.0     ; right_joint1
        (13,0)  0.0     ; right_joint2
        (14,0)  0.0     ; right_joint3
        (15,0)  0.0     ; right_joint4
        (16,0)  0.0     ; right_joint5
        (17,0)  0.0     ; right_joint6
        (18,0)  0.0     ; right_joint7
    }
}

initialModeSchedule
{
    eventTimes
    {
    }

    ; Chassis planned (BASE_UNLOCK) + bodyRelative band; HEAD_GAZE on head_camera.
    modeSequence
    {
        [0]
        {
            bodyMode "HM_DUAL_RELATIVE_MOBILE_BASE"
            headMode "HEAD_GAZE"
        }
    }
}

ddp
{
    algorithm                       SLQ
    nThreads                        3
    threadPriority                  50
    maxNumIterations                1
    minRelCost                      0.1
    constraintTolerance             1e-3
    displayInfo                     false
    displayShortSummary             false
    checkNumericalStability         false
    debugPrintRollout               false
    debugCaching                    false
    AbsTolODE                       1e-5
    RelTolODE                       1e-3
    maxNumStepsPerSecond            100000
    timeStep                        1e-3
    backwardPassIntegratorType      ODE45
    constraintPenaltyInitialValue   20.0
    constraintPenaltyIncreaseRate   2.0
    preComputeRiccatiTerms          true
    useFeedbackPolicy               false
    strategy                        LINE_SEARCH
    lineSearch
    {
        minStepLength                   1e-2
        maxStepLength                   1.0
        hessianCorrectionStrategy       DIAGONAL_SHIFT
        hessianCorrectionMultiple       1e-3
    }
}

mpc
{
    ; Peer mobile_base_tcp (W2/WCE3/Taku) uses 0.4 s; 1.0 encouraged early base slides.
    timeHorizon                     0.4
    solutionTimeWindow              0.2
    coldStart                       false
    debugPrint                      false
    mpcDesiredFrequency             100
    mrtDesiredFrequency             400
}

rollout
{
    AbsTolODE                       1e-5
    RelTolODE                       1e-3
    timeStep                        1e-2
    integratorType                  ODE45
    maxNumStepsPerSecond            100000
    checkNumericalStability         false
}

bodyTrackingEE
{
    activate  true
    muPosition 5.0
    muOrientation 5.0
}

headTrackingEE
{
    activate  true
    muPosition 5.0
    muOrientation 5.0
}

; Input dim = 2 (vx, omega) + 19 joints = 21
inputCost
{
    R
    {
        base
        {
            wheelBasedMobileManipulator
            {
                scaling 1e-1
                (0,0)   0.8     ; vx [m/s]
                (1,1)   0.8     ; omega [rad/s]
            }
        }
        arm
        {
            scaling 1e-2
            (0,0)   1.0    ; body_joint1 lift
            (1,1)   1.0     ; body_joint2 pitch
            (2,2)   1.0     ; body_joint3 yaw
            (3,3)   0.1     ; head_joint1
            (4,4)   0.1     ; head_joint2
            (5,5)   1.0     ; left_joint1
            (6,6)   1.0
            (7,7)   1.0
            (8,8)   1.0
            (9,9)   0.5     ; left wrist
            (10,10) 0.5
            (11,11) 0.5
            (12,12) 1.0     ; right_joint1
            (13,13) 1.0
            (14,14) 1.0
            (15,15) 1.0
            (16,16) 0.5     ; right wrist
            (17,17) 0.5
            (18,18) 0.5
        }
    }
}

endEffector
{
    muPosition                      10.0
    muOrientation                   5.0
}

finalEndEffector
{
    muPosition                      20.0
    muOrientation                   10.0
}

; Torso has pitch + yaw relative to base (unlike Quanta single prismatic)
bodyRelative
{
    activate                        true
    xLowerBound                     0.00
    xUpperBound                     0.25
    muPosition                      5.0
    muOrientation                   5.0
}

bimanualCoupling
{
    activate                        true
    muPosition                      50.0
    muOrientation                   25.0
}

; Layout: [base(2) | body(3) | head(2) | left(7) | right(7)] → head starts at 5
headInputStart                          5

waistLock
{
    activate                        true
    numJoints                       3
}

headCoupling
{
    activate                        false
}

; Head gaze (headMode HEAD_GAZE): head_camera looks at the midpoint of both hands.
; cameraFrame = head_camera (ROS optical: +Z forward, +X right; mounted on neck_pitch_link
; via neck_camera_link, same convention as W2). Intrinsics are nominal RealSense D435
; RGB 1280x720 (HFOV 69.4 / VFOV 42.5 deg) — only affect the deadband / alignment angles.
headMidpointGaze
{
    activate                    true
    cameraFrame                 "head_camera"
    fx                          923.0
    fy                          925.0
    cx                          640.0
    cy                          360.0
    width                       1280
    height                      720
    horizontalDeadbandDeg       10.0
    verticalDeadbandDeg         10.0
    muAlignmentHorizontal       1.0
    muAlignmentVertical         1.0
    muFront                     1.0
    minDepth                    0.3
}

customJointLock
{
    activate                        true
    ; Empty: CUSTOM_LOCKED capability without hard-locking torso/lift
    ; Full input indices if filled (body_joint1 = 2 after vx/omega).
    lockedJointIndices
    {
    }
}

; HOME joint reference: excludeJointIndices are arm-segment indices (no base offset).
homeJointReference
{
    activate                        true
    activateDefault                 true
    mu                              1e-3
    excludeJointIndices
    {
    }
}

armLock
{
    activate                        true
    leftNumJoints                   7
    rightNumJoints                  7
}

jointPositionLimits
{
    activate                        true
    mu                              1e-3
    delta                           1e-3
}

; Soft velocity barriers. Base ±0.5 (W2-class); arm same as fixed_base_tcp.
jointVelocityLimits
{
    mu                              1e-2
    delta                           1e-2

    lowerBound
    {
        base
        {
            wheelBasedMobileManipulator
            {
                (0,0)  -0.5     ; vx [m/s]
                (1,0)  -1.5     ; omega [rad/s]
            }
        }
        arm
        {
            (0,0)  -0.2     ; body_joint1 lift [m/s]
            (1,0)  -1.5     ; body_joint2
            (2,0)  -1.5     ; body_joint3
            (3,0)  -1.5     ; head_joint1
            (4,0)  -1.5     ; head_joint2
            (5,0)  -4.0     ; left 1-4
            (6,0)  -4.0
            (7,0)  -3.5
            (8,0)  -3.5
            (9,0)  -8.0     ; left wrist
            (10,0) -8.0
            (11,0) -8.0
            (12,0) -4.0     ; right 1-4
            (13,0) -4.0
            (14,0) -3.5
            (15,0) -3.5
            (16,0) -8.0     ; right wrist
            (17,0) -8.0
            (18,0) -8.0
        }
    }

    upperBound
    {
        base
        {
            wheelBasedMobileManipulator
            {
                (0,0)  0.5
                (1,0)  1.5
            }
        }
        arm
        {
            (0,0)  0.2
            (1,0)  1.5
            (2,0)  1.5
            (3,0)  1.5
            (4,0)  1.5
            (5,0)  3.14
            (6,0)  3.14
            (7,0)  3.14
            (8,0)  3.14
            (9,0)  3.14
            (10,0) 3.14
            (11,0) 3.14
            (12,0) 3.14
            (13,0) 3.14
            (14,0) 3.14
            (15,0) 3.14
            (16,0) 3.14
            (17,0) 3.14
            (18,0) 3.14
        }
    }
}

; Chest box + arm cylinders (collider:=simple). Do not set activate true with collider:=convex.
; Pairs match W2 body_link4 ↔ link{3,4,5,7}: torso vs shoulder-yaw / elbow / wrist-roll / wrist-pitch.
selfCollision
{
    activate                        true
    mu                              1e-3
    delta                           1e-2
    minimumDistance                 0.01
    collisionObjectPairs
    {
    }
    collisionLinkPairs
    {
        [0] "body_yaw_link, left_shoulder_yaw_link",
        [1] "body_yaw_link, left_elbow_link",
        [2] "body_yaw_link, left_wrist_roll_link",
        [3] "body_yaw_link, left_wrist_pitch_link",
        [4] "body_yaw_link, right_shoulder_yaw_link",
        [5] "body_yaw_link, right_elbow_link",
        [6] "body_yaw_link, right_wrist_roll_link",
        [7] "body_yaw_link, right_wrist_pitch_link",
    }
}
