<?xml version="1.0"?>
<!-- =================================================================================== -->
<!-- |    Chassis Description for Zerith H1                                            | -->
<!-- |    Parameterized macro: joints_movable:=false (default) locks drive wheels       | -->
<!-- =================================================================================== -->
<robot name="zerith_h1_chassis" xmlns:xacro="http://www.ros.org/wiki/xacro">

	<xacro:arg name="collider" default="simple"/>

	<!-- Passive support caster (Quanta X1 swivel / Realman RS01 caster convention):
	     base_link -> {prefix}_caster_swivel_joint (yaw, axis Z, vertical through the mount)
	     -> {prefix}_caster_link (fork; no separate mesh in the vendor CAD)
	     -> {prefix}_wheel_joint (rolling, axis Y through the wheel center) -> {prefix}_wheel_link.
	     support_wheel.glb is the wheel only (r=0.025, width 0.049, axle along Y, origin at center).
	     Swivel origin = chassis plate underside (z=-0.148) right above the wheel; the CAD wheel
	     sits centered under its pocket, so caster_trail defaults to 0 (no visible offset).
	     Fixed by default; continuous only with chassis_joints_movable:=true. Not in ros2_control. -->
	<xacro:macro name="H1Caster" params="prefix x y mass ixx iyy izz movable:=false mount_z:=-0.148 wheel_z:=-0.156 caster_trail:=0.0">
		<xacro:property name="caster_joint_type" value="${'continuous' if movable else 'fixed'}"/>
		<link name="${prefix}_caster_link">
			<inertial>
				<origin xyz="0 0 0"/>
				<mass value="0.02"/>
				<inertia ixx="1e-06" ixy="0" ixz="0" iyy="1e-06" iyz="0" izz="1e-06"/>
			</inertial>
		</link>
		<joint name="${prefix}_caster_swivel_joint" type="${caster_joint_type}">
			<origin xyz="${x} ${y} ${mount_z}"/>
			<parent link="base_link"/>
			<child link="${prefix}_caster_link"/>
			<axis xyz="0 0 1"/>
		</joint>

		<link name="${prefix}_wheel_link">
			<inertial>
				<origin xyz="0.0 0.0 0.0"/>
				<mass value="${mass}"/>
				<inertia ixx="${ixx}" ixy="0" ixz="0" iyy="${iyy}" iyz="0" izz="${izz}"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find zerith_h1_description)/meshes/base/support_wheel.glb"/>
				</geometry>
			</visual>
			<collision>
				<geometry>
					<sphere radius="0.025"/>
				</geometry>
			</collision>
		</link>
		<joint name="${prefix}_wheel_joint" type="${caster_joint_type}">
			<origin xyz="${-caster_trail} 0 ${wheel_z - mount_z}"/>
			<parent link="${prefix}_caster_link"/>
			<child link="${prefix}_wheel_link"/>
			<axis xyz="0 1 0"/>
		</joint>
	</xacro:macro>

	<!-- joints_movable:=false → drive wheels + casters fixed (W2/Bot2/Quanta). -->
	<xacro:macro name="H1Chassis" params="joints_movable:=false collider:='simple'">
		<xacro:property name="chassis_movable" value="${str(joints_movable).lower() in ['true', '1', 'yes', 'on']}"/>
		<xacro:property name="wheel_joint_type" value="${'continuous' if chassis_movable else 'fixed'}"/>

		<!-- Root frames: base_footprint identity to base_link (W2 / Taku / Bot2). -->
		<link name="base_footprint"/>
		<joint name="base_footprint_joint" type="fixed">
			<parent link="base_footprint"/>
			<child link="base_link"/>
		</joint>

		<link name="base_link">
			<inertial>
				<origin xyz="0.00021947 -0.00045719 0.08921288"/>
				<mass value="92.40985888"/>
				<inertia ixx="12.0810981" ixy="-0.00505423" ixz="1.25403037"
						iyy="12.71175466" iyz="-0.00705268" izz="2.84527064"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find zerith_h1_description)/meshes/base/base_link.glb"/>
				</geometry>
			</visual>
			<xacro:if value="${collider == 'convex'}">
				<collision>
					<geometry>
						<mesh filename="file://$(find zerith_h1_description)/meshes/base/base_link.glb"/>
					</geometry>
				</collision>
			</xacro:if>
			<xacro:if value="${collider == 'simple'}">
				<!-- Deck. Wheels keep their own cylinders. -->
				<collision>
					<origin xyz="0.05 0 -0.06"/>
					<geometry>
						<box size="0.56 0.40 0.16"/>
					</geometry>
				</collision>
				<!-- Rear mast: shell is about 0.20 x 0.21 from z 0.14 to 1.14. Inset so it sits inside the housing. -->
				<collision>
					<origin xyz="-0.076 0 0.64"/>
					<geometry>
						<box size="0.150 0.155 0.90"/>
					</geometry>
				</collision>
			</xacro:if>
		</link>

		<xacro:H1Caster prefix="left_front" x="0.184" y="0.148" mass="0.16" ixx="6.766e-05" iyy="7.514e-05" izz="6.766e-05" movable="${chassis_movable}"/>

		<!-- =============================================================================== -->
		<!-- Left Middle Wheel (drive)                                                       -->
		<!-- =============================================================================== -->
		<link name="left_middle_wheel_link">
			<inertial>
				<origin xyz="0.0 0.00140713 0.0"/>
				<mass value="2.0"/>
				<inertia ixx="0.00516956" ixy="-0.0" ixz="-0.0"
						iyy="0.00976607" iyz="-0.0" izz="0.00516956"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find zerith_h1_description)/meshes/base/drive_wheel.glb"/>
				</geometry>
			</visual>
			<collision>
				<geometry>
					<cylinder radius="0.0835" length="0.04"/>
				</geometry>
				<origin rpy="1.5707963267949 0 0"/>
			</collision>
		</link>
		<joint name="left_wheel_joint" type="${wheel_joint_type}">
			<origin xyz="0.0544 0.1895 -0.0965"/>
			<parent link="base_link"/>
			<child link="left_middle_wheel_link"/>
			<axis xyz="0 1 0"/>
			<limit effort="60" velocity="2.3"/>
		</joint>

		<xacro:H1Caster prefix="left_rear" x="-0.1465" y="0.151" mass="0.12" ixx="4.893e-05" iyy="4.906e-05" izz="4.938e-05" wheel_z="-0.155" movable="${chassis_movable}"/>

		<xacro:H1Caster prefix="right_front" x="0.184" y="-0.148" mass="0.16" ixx="6.766e-05" iyy="7.514e-05" izz="6.766e-05" movable="${chassis_movable}"/>

		<!-- =============================================================================== -->
		<!-- Right Middle Wheel (drive)                                                      -->
		<!-- =============================================================================== -->
		<link name="right_middle_wheel_link">
			<inertial>
				<origin xyz="0.0 -0.00140713 0.0"/>
				<mass value="2.0"/>
				<inertia ixx="0.00516956" ixy="-0.0" ixz="-0.0"
						iyy="0.00976607" iyz="-0.0" izz="0.00516956"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find zerith_h1_description)/meshes/base/drive_wheel.glb" scale="1 -1 1"/>
				</geometry>
			</visual>
			<collision>
				<geometry>
					<cylinder radius="0.0835" length="0.04"/>
				</geometry>
				<origin rpy="1.5707963267949 0 0"/>
			</collision>
		</link>
		<joint name="right_wheel_joint" type="${wheel_joint_type}">
			<origin xyz="0.0544 -0.1895 -0.0965"/>
			<parent link="base_link"/>
			<child link="right_middle_wheel_link"/>
			<axis xyz="0 -1 0"/>
			<limit effort="60" velocity="2.3"/>
		</joint>

		<xacro:H1Caster prefix="right_rear" x="-0.1465" y="-0.151" mass="0.12" ixx="4.893e-05" iyy="4.906e-05" izz="4.938e-05" wheel_z="-0.155" movable="${chassis_movable}"/>

	</xacro:macro>

</robot>
