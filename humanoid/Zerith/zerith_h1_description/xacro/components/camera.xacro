<?xml version="1.0"?>
<!-- =================================================================================== -->
<!-- |    Wrist camera stand for Zerith H1                                             | -->
<!-- |    camera: none | d405 (stand mesh + RealSense)                                 | -->
<!-- =================================================================================== -->
<robot name="zerith_h1_camera" xmlns:xacro="http://www.ros.org/wiki/xacro">

	<xacro:arg name="isaac" default="false"/>

	<xacro:macro name="H1WristCamera" params="prefix parent_link camera:=d405">
		<xacro:if value="${camera == 'd405'}">
			<link name="${prefix}camera_support">
				<visual>
					<geometry>
						<mesh filename="file://$(find zerith_h1_description)/meshes/arm/d405_flange.glb"/>
					</geometry>
				</visual>
				<collision>
					<geometry>
						<mesh filename="file://$(find zerith_h1_description)/meshes/arm/d405_flange.glb"/>
					</geometry>
				</collision>
			</link>
			<joint name="${prefix}camera_support_joint" type="fixed">
				<parent link="${parent_link}"/>
				<child link="${prefix}camera_support"/>
			</joint>

			<link name="${prefix}jaw_camera_link">
				<inertial>
					<origin xyz="0.0 0.005 -0.01561719"/>
					<mass value="0.05789"/>
					<inertia ixx="1.081e-05" ixy="-0.0" ixz="-0.0"
									 iyy="1.08e-05" iyz="-0.0" izz="1.658e-05"/>
				</inertial>
				<xacro:unless value="$(arg isaac)">
					<visual>
						<geometry>
							<mesh filename="file://$(find sensor_models)/meshes/realsense/d405.glb"/>
						</geometry>
					</visual>
				</xacro:unless>
			</link>
			<joint name="${prefix}jaw_camera_joint" type="fixed">
				<origin xyz="0.07675 0.000 0.05878" rpy="-2.0071 0 -1.5708"/>
				<parent link="${prefix}camera_support"/>
				<child link="${prefix}jaw_camera_link"/>
			</joint>
		</xacro:if>
	</xacro:macro>

</robot>
