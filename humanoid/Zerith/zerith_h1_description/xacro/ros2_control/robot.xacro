<?xml version="1.0"?>
<robot name="zerith_h1" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="ros2_control_hardware_type" default="mock_components"/>
  <xacro:arg name="gazebo" default="false"/>
  <xacro:arg name="chassis_joints_movable" default="false"/>

  <xacro:include filename="$(find zerith_h1_description)/xacro/robot.xacro"/>
  <xacro:include filename="$(find zerith_h1_description)/xacro/ros2_control/body_ros2_control.xacro"/>
  <xacro:include filename="$(find zerith_h1_description)/xacro/ros2_control/arm_ros2_control.xacro"/>
  <xacro:include filename="$(find robot_common_launch)/xacro/ros2_control/simulation_hardware.xacro"/>

  <xacro:property name="is_real_hardware" value="${'$(arg ros2_control_hardware_type)' == 'real'}"/>
  <!-- Topic bridge (isaac) is position-only. isaac_sim / gz / mock export position+velocity+effort. -->
  <xacro:property name="sim_iface_mode"
    value="${'position' if '$(arg ros2_control_hardware_type)' == 'isaac' else 'mix'}"/>

  <ros2_control name="zerith_h1_system" type="system">
    <hardware>
      <xacro:if value="${is_real_hardware}">
        <plugin>mock_components/GenericSystem</plugin>
      </xacro:if>
      <xacro:unless value="${is_real_hardware}">
        <xacro:simulation_hardware_plugin hardware_type="$(arg ros2_control_hardware_type)"/>
      </xacro:unless>
    </hardware>

    <xacro:zerith_h1_body_interfaces iface_mode="${sim_iface_mode}"/>
    <xacro:zerith_h1_arm_interfaces name="left" iface_mode="${sim_iface_mode}" ee_type="${left_ee_type}"/>
    <xacro:zerith_h1_arm_interfaces name="right" iface_mode="${sim_iface_mode}" ee_type="${right_ee_type}"/>

    <xacro:if value="${left_ee_type == 'revo1' or right_ee_type == 'revo1'}">
      <xacro:include filename="$(find brainco_description)/xacro/ros2_control/revo1.xacro"/>
    </xacro:if>
    <xacro:if value="${left_ee_type == 'revo1'}">
      <xacro:revo1_interfaces name="left_hand"/>
    </xacro:if>
    <xacro:if value="${right_ee_type == 'revo1'}">
      <xacro:revo1_interfaces name="right_hand"/>
    </xacro:if>
    <xacro:if value="${left_ee_type == 'revo2' or right_ee_type == 'revo2'}">
      <xacro:include filename="$(find brainco_description)/xacro/ros2_control/revo2.xacro"/>
    </xacro:if>
    <xacro:if value="${left_ee_type == 'revo2'}">
      <xacro:revo2_interfaces name="left_hand"/>
    </xacro:if>
    <xacro:if value="${right_ee_type == 'revo2'}">
      <xacro:revo2_interfaces name="right_hand"/>
    </xacro:if>
  </ros2_control>

  <xacro:if value="$(arg gazebo)">
    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find zerith_h1_description)/config/ros2_control/ros2_controllers.yaml</parameters>
      </plugin>
    </gazebo>
  </xacro:if>
</robot>
