<?xml version="1.0"?>
<robot name="openarm_v10" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="ros2_control_hardware_type" default="mock_components"/>
	
  <link name="world"/>

	<joint name="world_fixed" type="fixed">
		<parent link="world"/>
		<child link="base_link"/>
	</joint>

  <xacro:arg name="type" default="bimanual"/>


  <!-- 直接include robot.xacro并根据type参数传递 -->
  <xacro:include filename="$(find openarm_description)/xacro/robot.xacro" type="$(arg type)"/>



  <!-- 根据type参数决定ros2_control类型 -->
  <xacro:if value="${'$(arg type)' == 'bimanual'}">
    <xacro:include filename="$(find openarm_description)/xacro/ros2_control/openarm_bimanual.ros2_control.xacro"/>
    <xacro:openarm_v10_system name="" ros2_control_hardware_type="$(arg ros2_control_hardware_type)"/>
  </xacro:if>

  <xacro:if value="${'$(arg type)' == 'left'}">
    <xacro:include filename="$(find openarm_description)/xacro/ros2_control/openarm_single.ros2_control.xacro"/>
    <xacro:openarm_v10_system name="" ros2_control_hardware_type="$(arg ros2_control_hardware_type)"/>
  </xacro:if>

  <xacro:if value="${'$(arg type)' == 'right'}">
    <xacro:include filename="$(find openarm_description)/xacro/ros2_control/openarm_single.ros2_control.xacro"/>
    <xacro:openarm_v10_system name="" ros2_control_hardware_type="$(arg ros2_control_hardware_type)"/>
  </xacro:if>

  <!-- Gazebo plugin configuration -->
  <xacro:arg name="gazebo" default="false" />
  <xacro:if value="$(arg gazebo)">
    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <xacro:if value="${'$(arg type)' == 'bimanual'}">
          <parameters>$(find openarm_description)/config/ros2_control/openarm_bimanual.yaml</parameters>
        </xacro:if>
        <xacro:if value="${'$(arg type)' == 'left'}">
          <parameters>$(find openarm_description)/config/ros2_control/openarm_single.yaml</parameters>
        </xacro:if>
        <xacro:if value="${'$(arg type)' == 'right'}">
          <parameters>$(find openarm_description)/config/ros2_control/openarm_single.yaml</parameters>
        </xacro:if>
      </plugin>
    </gazebo>
  </xacro:if>
</robot>
