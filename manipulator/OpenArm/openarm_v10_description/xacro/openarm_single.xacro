<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="OpenArm" params="name direction:=normal">
    <xacro:property name="prefix" value="${name + '_' if name else ''}"/>
    <!-- Is the robot being simulated in gazebo? -->
    <!-- <xacro:arg name="gazebo" default="false" /> -->
    <link name="${prefix}link0">
      <visual name="${prefix}link0_visual">
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="file://$(find openarm_v10_description/meshes/arm/v10/visual/link0.dae" scale="0.001 -0.001 0.001"/>
        </geometry>
      </visual>
      <collision name="${prefix}link0_collision">
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="file://$(find openarm_v10_description/meshes/arm/v10/collision/link0_symp.stl" scale="0.001 -0.001 0.001"/>
          <!-- <mesh filename="file://$(find openarm_v10_description/meshes/arm/${arm_type}/collision/${name}.stl" scale="0.001 0.001 0.001" /> -->
        </geometry>
      </collision>
      <inertial>
        <origin rpy="0.0 0.0 0.0" xyz="-0.0009483362816297526 -0.0001580207020448382 0.03076860287587199"/>
        <mass value="1.1432284943239561"/>
        <inertia ixx="0.001128" ixy="-4e-06" ixz="-3.3e-05" iyy="0.000962" iyz="-7e-06" izz="0.00147"/>
      </inertial>
    </link>
    <link name="${prefix}link1">
      <visual name="${prefix}link1_visual">
        <origin rpy="0.0 0.0 0.0" xyz="-0.0 0.0 -0.0625"/>
        <geometry>
          <mesh filename="file://$(find openarm_v10_description/meshes/arm/v10/visual/link1.dae" scale="0.001 -0.001 0.001"/>
        </geometry>
      </visual>
      <collision name="${prefix}link1_collision">
        <origin rpy="0.0 0.0 0.0" xyz="-0.0 0.0 -0.0625"/>
        <geometry>
          <mesh filename="file://$(find openarm_v10_description/meshes/arm/v10/collision/link1_symp.stl" scale="0.001 -0.001 0.001"/>
          <!-- <mesh filename="file://$(find openarm_v10_description/meshes/arm/${arm_type}/collision/${name}.stl" scale="0.001 0.001 0.001" /> -->
        </geometry>
      </collision>
      <inertial>
        <origin rpy="0.0 0.0 0.0" xyz="0.0011467657911800769 -3.319987657026362e-05 0.05395284380736254"/>
        <mass value="1.1416684646202298"/>
        <inertia ixx="0.001567" ixy="-1e-06" ixz="-2.9e-05" iyy="0.001273" iyz="1e-06" izz="0.001016"/>
      </inertial>
    </link>
    <joint name="${prefix}joint1" type="revolute">
      <origin rpy="0 0 0" xyz="0.0 0.0 0.0625"/>
      <parent link="${prefix}link0"/>
      <child link="${prefix}link1"/>
      <axis xyz="0 0 1"/>
      <limit effort="40" lower="-1.396263" upper="3.490659" velocity="16.754666"/>
    </joint>
    <link name="${prefix}link2">
      <visual name="${prefix}link2_visual">
        <origin rpy="0.0 0.0 0.0" xyz="0.0301 0.0 -0.1225"/>
        <geometry>
          <mesh filename="file://$(find openarm_v10_description/meshes/arm/v10/visual/link2.dae" scale="0.001 -0.001 0.001"/>
        </geometry>
      </visual>
      <collision name="${prefix}link2_collision">
        <origin rpy="0.0 0.0 0.0" xyz="0.0301 0.0 -0.1225"/>
        <geometry>
          <mesh filename="file://$(find openarm_v10_description/meshes/arm/v10/collision/link2_symp.stl" scale="0.001 -0.001 0.001"/>
          <!-- <mesh filename="file://$(find openarm_v10_description/meshes/arm/${arm_type}/collision/${name}.stl" scale="0.001 0.001 0.001" /> -->
        </geometry>
      </collision>
      <inertial>
        <origin rpy="0.0 0.0 0.0" xyz="0.00839629182351943 2.0145102027597523e-08 0.03256649300522363"/>
        <mass value="0.2775092746011571"/>
        <inertia ixx="0.000359" ixy="1e-06" ixz="-0.000109" iyy="0.000376" iyz="1e-06" izz="0.000232"/>
      </inertial>
    </link>
    <joint name="${prefix}joint2" type="revolute">
      <origin rpy="0 0 0" xyz="-0.0301 0.0 0.06"/>
      <parent link="${prefix}link1"/>
      <child link="${prefix}link2"/>
      <axis xyz="-1 0 0"/>
      <limit effort="40" lower="-1.745329" upper="1.745329" velocity="16.754666"/>
    </joint>
    <link name="${prefix}link3">
      <visual name="${prefix}link3_visual">
        <origin rpy="0.0 0.0 0.0" xyz="-0.0 -0.0 -0.18875"/>
        <geometry>
          <mesh filename="file://$(find openarm_v10_description/meshes/arm/v10/visual/link3.dae" scale="0.001 -0.001 0.001"/>
        </geometry>
      </visual>
      <collision name="${prefix}link3_collision">
        <origin rpy="0.0 0.0 0.0" xyz="-0.0 -0.0 -0.18875"/>
        <geometry>
          <mesh filename="file://$(find openarm_v10_description/meshes/arm/v10/collision/link3_symp.stl" scale="0.001 -0.001 0.001"/>
          <!-- <mesh filename="file://$(find openarm_v10_description/meshes/arm/${arm_type}/collision/${name}.stl" scale="0.001 0.001 0.001" /> -->
        </geometry>
      </collision>
      <inertial>
        <origin rpy="0.0 0.0 0.0" xyz="-0.002104752099628911 -0.0005549085042607548 0.09047470545721961"/>
        <mass value="1.073863338202347"/>
        <inertia ixx="0.004372" ixy="1e-06" ixz="1.1e-05" iyy="0.004319" iyz="-3.6e-05" izz="0.000661"/>
      </inertial>
    </link>
    <joint name="${prefix}joint3" type="revolute">
      <origin rpy="0 0 0" xyz="0.0301 0.0 0.06625"/>
      <parent link="${prefix}link2"/>
      <child link="${prefix}link3"/>
      <axis xyz="0 0 1"/>
      <limit effort="27" lower="-1.570796" upper="1.570796" velocity="5.445426"/>
    </joint>
    <link name="${prefix}link4">
      <visual name="${prefix}link4_visual">
        <origin rpy="0.0 0.0 0.0" xyz="0.0 -0.0315 -0.3425"/>
        <geometry>
          <mesh filename="file://$(find openarm_v10_description/meshes/arm/v10/visual/link4.dae" scale="0.001 0.001 0.001"/>
        </geometry>
      </visual>
      <collision name="${prefix}link4_collision">
        <origin rpy="0.0 0.0 0.0" xyz="0.0 -0.0315 -0.3425"/>
        <geometry>
          <mesh filename="file://$(find openarm_v10_description/meshes/arm/v10/collision/link4_symp.stl" scale="0.001 0.001 0.001"/>
          <!-- <mesh filename="file://$(find openarm_v10_description/meshes/arm/${arm_type}/collision/${name}.stl" scale="0.001 0.001 0.001" /> -->
        </geometry>
      </collision>
      <inertial>
        <origin rpy="0.0 0.0 0.0" xyz="-0.0029006831074562967 -0.03030575826634669 0.06339637422196209"/>
        <mass value="0.6348534566833373"/>
        <inertia ixx="0.000623" ixy="-1e-06" ixz="-1.9e-05" iyy="0.000511" iyz="3.8e-05" izz="0.000334"/>
      </inertial>
    </link>
    <joint name="${prefix}joint4" type="revolute">
      <origin rpy="0 0 0" xyz="-0.0 0.0315 0.15375"/>
      <parent link="${prefix}link3"/>
      <child link="${prefix}link4"/>
      <axis xyz="0 1 0"/>
      <limit effort="27" lower="0.0" upper="2.443461" velocity="5.445426"/>
    </joint>
    <link name="${prefix}link5">
      <visual name="${prefix}link5_visual">
        <origin rpy="0.0 0.0 0.0" xyz="-0.0 -0.0 -0.438"/>
        <geometry>
          <mesh filename="file://$(find openarm_v10_description/meshes/arm/v10/visual/link5.dae" scale="0.001 -0.001 0.001"/>
        </geometry>
      </visual>
      <collision name="${prefix}link5_collision">
        <origin rpy="0.0 0.0 0.0" xyz="-0.0 -0.0 -0.438"/>
        <geometry>
          <mesh filename="file://$(find openarm_v10_description/meshes/arm/v10/collision/link5_symp.stl" scale="0.001 -0.001 0.001"/>
          <!-- <mesh filename="file://$(find openarm_v10_description/meshes/arm/${arm_type}/collision/${name}.stl" scale="0.001 0.001 0.001" /> -->
        </geometry>
      </collision>
      <inertial>
        <origin rpy="0.0 0.0 0.0" xyz="-0.003049665024221911 -0.0008866902457326625 0.043079803024980934"/>
        <mass value="0.6156588026168502"/>
        <inertia ixx="0.000423" ixy="-8e-06" ixz="6e-06" iyy="0.000445" iyz="-6e-06" izz="0.000324"/>
      </inertial>
    </link>
    <joint name="${prefix}joint5" type="revolute">
      <origin rpy="0 0 0" xyz="0.0 -0.0315 0.0955"/>
      <parent link="${prefix}link4"/>
      <child link="${prefix}link5"/>
      <axis xyz="0 0 1"/>
      <limit effort="7" lower="-1.570796" upper="1.570796" velocity="20.943946"/>
    </joint>
    <link name="${prefix}link6">
      <visual name="${prefix}link6_visual">
        <origin rpy="0.0 0.0 0.0" xyz="-0.0375 -0.0 -0.5585"/>
        <geometry>
          <mesh filename="file://$(find openarm_v10_description/meshes/arm/v10/visual/link6.dae" scale="0.001 -0.001 0.001"/>
        </geometry>
      </visual>
      <collision name="${prefix}link6_collision">
        <origin rpy="0.0 0.0 0.0" xyz="-0.0375 -0.0 -0.5585"/>
        <geometry>
          <mesh filename="file://$(find openarm_v10_description/meshes/arm/v10/collision/link6_symp.stl" scale="0.001 -0.001 0.001"/>
          <!-- <mesh filename="file://$(find openarm_v10_description/meshes/arm/${arm_type}/collision/${name}.stl" scale="0.001 0.001 0.001" /> -->
        </geometry>
      </collision>
      <inertial>
        <origin rpy="0.0 0.0 0.0" xyz="-0.037136587005447405 -0.00033230528343419053 -9.498374522309838e-05"/>
        <mass value="0.475202773187987"/>
        <inertia ixx="0.000143" ixy="1e-06" ixz="1e-06" iyy="0.000157" iyz="1e-06" izz="0.000159"/>
      </inertial>
    </link>
    <joint name="${prefix}joint6" type="revolute">
      <origin rpy="0 0 0" xyz="0.0375 0.0 0.1205"/>
      <parent link="${prefix}link5"/>
      <child link="${prefix}link6"/>
      <axis xyz="1 0 0"/>
      <limit effort="7" lower="-0.785398" upper="0.785398" velocity="20.943946"/>
    </joint>
    <link name="${prefix}link7">
      <visual name="${prefix}link7_visual">
        <origin rpy="0.0 0.0 0.0" xyz="0.0 -0.0 -0.5585"/>
        <geometry>
          <mesh filename="file://$(find openarm_v10_description/meshes/arm/v10/visual/link7.dae" scale="0.001 -0.001 0.001"/>
        </geometry>
      </visual>
      <collision name="${prefix}link7_collision">
        <origin rpy="0.0 0.0 0.0" xyz="0.0 -0.0 -0.5585"/>
        <geometry>
          <mesh filename="file://$(find openarm_v10_description/meshes/arm/v10/collision/link7_symp.stl" scale="0.001 -0.001 0.001"/>
          <!-- <mesh filename="file://$(find openarm_v10_description/meshes/arm/${arm_type}/collision/${name}.stl" scale="0.001 0.001 0.001" /> -->
        </geometry>
      </collision>
      <inertial>
        <origin rpy="0.0 0.0 0.0" xyz="6.875510271106056e-05 -0.01266175250761268 0.06951945409987448"/>
        <mass value="0.4659771327380578"/>
        <inertia ixx="0.000639" ixy="1e-06" ixz="1e-06" iyy="0.000497" iyz="8.9e-05" izz="0.000342"/>
      </inertial>
    </link>
    <joint name="${prefix}joint7" type="revolute">
      <origin rpy="0 0 0" xyz="-0.0375 0.0 0.0"/>
      <parent link="${prefix}link6"/>
      <child link="${prefix}link7"/>
      <axis xyz="0 -1 0"/>
      <limit effort="7" lower="-1.570796" upper="1.570796" velocity="20.943946"/>
    </joint>
    <!-- <link name="${prefix}link8"/>

      <joint name="${prefix}joint8" type="fixed">
        <xacro:openarm-kinematics name="joint8" config="${kinematics}" />
        <parent link="${prefix}link7" />
        <child link="${prefix}link8" />
      </joint> -->
    <link name="${prefix}hand">
      <visual name="${prefix}hand_visual">
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 -0.6585"/>
        <geometry>
          <mesh filename="file://$(find openarm_v10_description/meshes/ee/openarm_hand/visual/hand.dae" scale="0.001 0.001 0.001"/>
        </geometry>
      </visual>
      <collision name="${prefix}hand_collision">
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 -0.6585"/>
        <geometry>
          <mesh filename="file://$(find openarm_v10_description/meshes/ee/openarm_hand/collision/hand.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      <inertial>
        <origin rpy="0 0 0" xyz="0.0 0.002 0.03"/>
        <mass value="0.35"/>
        <inertia ixx="0.0002473" ixy="1e-06" ixz="1e-06" iyy="1.763e-05" iyz="1e-06" izz="0.0002521"/>
      </inertial>
    </link>
    <!-- <link name="${ee_prefix}hand"/> -->
    <!-- <joint name="${ee_prefix}hand_joint" type="fixed"> -->
    <joint name="${prefix}hand_joint" type="fixed">
      <parent link="${prefix}link7"/>
      <child link="${prefix}hand"/>
      <origin rpy="0 0 0" xyz="0 -0.0 0.1001"/>
    </joint>
    <!-- Define the hand_tcp frame -->
    <link name="${prefix}hand_tcp"/>
    <joint name="${prefix}hand_tcp_joint" type="fixed">
      <origin rpy="0 0 0" xyz="0 -0.0 0.08"/>
      <parent link="${prefix}hand"/>
      <child link="${prefix}hand_tcp"/>
    </joint>
    <link name="${prefix}left_finger">
      <visual name="${prefix}left_finger_visual">
        <origin rpy="0.0 0.0 0.0" xyz="0.0 -0.05 -0.673001"/>
        <geometry>
          <mesh filename="file://$(find openarm_v10_description/meshes/ee/openarm_hand/visual/finger.dae" scale="0.001 0.001 0.001"/>
        </geometry>
      </visual>
      <collision name="${prefix}left_finger_collision">
        <origin rpy="0.0 0.0 0.0" xyz="0.0 -0.05 -0.673001"/>
        <geometry>
          <mesh filename="file://$(find openarm_v10_description/meshes/ee/openarm_hand/collision/finger.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      <inertial>
        <origin rpy="0 0 0" xyz="0.0064528 0.01702 0.0219685"/>
        <mass value="0.03602545343277134"/>
        <inertia ixx="2.3749999999999997e-06" ixy="1e-06" ixz="1e-06" iyy="2.3749999999999997e-06" iyz="1e-06" izz="7.5e-07"/>
      </inertial>
    </link>
    <link name="${prefix}right_finger">
      <visual name="${prefix}right_finger_visual">
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.05 -0.673001"/>
        <geometry>
          <mesh filename="file://$(find openarm_v10_description/meshes/ee/openarm_hand/visual/finger.dae" scale="0.001 -0.001 0.001"/>
        </geometry>
      </visual>
      <collision name="${prefix}right_finger_collision">
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.05 -0.673001"/>
        <geometry>
          <mesh filename="file://$(find openarm_v10_description/meshes/ee/openarm_hand/collision/finger.stl" scale="0.001 -0.001 0.001"/>
        </geometry>
      </collision>
      <inertial>
        <origin rpy="0 0 0" xyz="0.0064528 -0.01702 0.0219685"/>
        <mass value="0.03602545343277134"/>
        <inertia ixx="2.3749999999999997e-06" ixy="1e-06" ixz="1e-06" iyy="2.3749999999999997e-06" iyz="1e-06" izz="7.5e-07"/>
      </inertial>
    </link>
    <joint name="${prefix}finger_joint1" type="prismatic">
      <parent link="${prefix}hand"/>
      <child link="${prefix}right_finger"/>
      <origin rpy="0 0 0" xyz="0 -0.006 0.015"/>
      <axis xyz="0 -1 0"/>
      <limit effort="333" lower="0.0" upper="0.044" velocity="10.0"/>
    </joint>
    <joint name="${prefix}finger_joint2" type="prismatic">
      <parent link="${prefix}hand"/>
      <child link="${prefix}left_finger"/>
      <origin rpy="0 0 0" xyz="0 0.006 0.015"/>
      <axis xyz="0 1 0"/>
      <limit effort="333" lower="0.0" upper="0.044" velocity="10.0"/>
      <mimic joint="${prefix}finger_joint1"/>
    </joint>
  </xacro:macro>
</robot>
