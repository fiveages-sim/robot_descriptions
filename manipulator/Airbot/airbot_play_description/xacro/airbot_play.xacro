<?xml version="1.0" ?>
<robot name="airbot_play" xmlns:xacro="http://ros.org/wiki/xacro">
	<xacro:include filename="$(find airbot_play_description)/xacro/gripper.xacro"/>
	<xacro:include filename="$(find xhand1_description)/xacro/xhand1.xacro"/>
	<xacro:macro name="airbot_play" params="name collider:=convex type:='' eef_fixed_joints:=false direction:=1">
		<xacro:property name="PI" value="3.1415926535897931"/>
		<xacro:property name="prefix" value="${name + '_' if name else ''}"/>

		<link name="${prefix}base_link">
			<inertial>
				<origin xyz="-0.010729 -0.00017015 0.041712"/>
				<mass value="0.77705"/>
				<inertia ixx="0.0008454" ixy="-7.5E-06" ixz="2.06E-05" iyy="0.0011821" iyz="-6.4E-06" izz="0.0012443"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find airbot_play_description)/meshes/base.glb"/>
				</geometry>
			</visual>
			<collision>
				<geometry>
					<mesh filename="file://$(find airbot_play_description)/meshes/base.glb"/>
				</geometry>
			</collision>
		</link>

		<link name="${prefix}link1">
			<inertial>
				<origin xyz="7.9126E-05 -0.002527 -0.0041359"/>
				<mass value="0.54639"/>
				<inertia ixx="0.0003462" ixy="0" ixz="-1.4E-06" iyy="0.0002863" iyz="-1.1E-06" izz="0.0003255"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find airbot_play_description)/meshes/link1.glb"/>
				</geometry>
			</visual>
			<collision>
				<geometry>
					<mesh filename="file://$(find airbot_play_description)/meshes/link1.glb"/>
				</geometry>
			</collision>
		</link>

		<joint name="${prefix}joint1" type="revolute">
			<origin xyz="0 0 0.1172"/>
			<parent link="${prefix}base_link"/>
			<child link="${prefix}link1"/>
			<axis xyz="0 0 1"/>
			<limit lower="-3.14" upper="2.09" effort="300" velocity="3.14"/>
		</joint>

		<link name="${prefix}link2">
			<inertial>
				<origin xyz="0.22493 0.0047721 0.008023"/>
				<mass value="0.64621"/>
				<inertia ixx="0.0004901" ixy="0.0005229" ixz="-0.0002434" iyy="0.0050391" iyz="-2.95E-05"
								 izz="0.0051052"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find airbot_play_description)/meshes/link2.glb"/>
				</geometry>
			</visual>
			<collision>
				<geometry>
					<mesh filename="file://$(find airbot_play_description)/meshes/link2.glb"/>
				</geometry>
			</collision>
		</link>

		<joint name="${prefix}joint2" type="revolute">
			<origin rpy="${PI/2} -2.7549 0"/>
			<parent link="${prefix}link1"/>
			<child link="${prefix}link2"/>
			<axis xyz="0 0 1"/>
			<limit lower="-2.96" upper="0.17" effort="300" velocity="3.14"/>
		</joint>

		<link name="${prefix}link3">
			<inertial>
				<origin xyz="0.16813 -5.5576E-05 0.0031184"/>
				<mass value="0.26829"/>
				<inertia ixx="0.000245" ixy="-4E-07" ixz="-0.0001263" iyy="0.0031527" iyz="-1E-07" izz="0.0030895"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find airbot_play_description)/meshes/link3.glb"/>
				</geometry>
			</visual>
			<collision>
				<geometry>
					<mesh filename="file://$(find airbot_play_description)/meshes/link3.glb"/>
				</geometry>
			</collision>
		</link>

		<joint name="${prefix}joint3" type="revolute">
			<origin xyz="0.27009 0 0" rpy="0 0 -2.7549"/>
			<parent link="${prefix}link2"/>
			<child link="${prefix}link3"/>
			<axis xyz="0 0 1"/>
			<limit lower="-0.087" upper="3.14" effort="300" velocity="3.14"/>
		</joint>

		<link name="${prefix}link4">
			<inertial>
				<origin xyz="5.2436E-06 0.00040412 -0.03228"/>
				<mass value="0.34876"/>
				<inertia ixx="0.0004235" ixy="0" ixz="4.7E-06" iyy="0.000412" iyz="-1E-07" izz="0.0001269"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find airbot_play_description)/meshes/link4.glb"/>
				</geometry>
			</visual>
			<collision>
				<geometry>
					<mesh filename="file://$(find airbot_play_description)/meshes/link4.glb"/>
				</geometry>
			</collision>
		</link>

		<joint name="${prefix}joint4" type="revolute">
			<origin xyz="0.29015 0 0" rpy="${PI} ${-PI/2} 0"/>
			<parent link="${prefix}link3"/>
			<child link="${prefix}link4"/>
			<axis xyz="0 0 1"/>
			<limit lower="-2.96" upper="2.96" effort="300" velocity="6.28"/>
		</joint>

		<link name="${prefix}link5">
			<inertial>
				<origin xyz="8.3328E-06 0.026148 0.002525"/>
				<mass value="0.36132"/>
				<inertia ixx="0.0001825" ixy="0" ixz="-3.29E-05" iyy="0.0004677" iyz="0" izz="0.0004286"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find airbot_play_description)/meshes/link5.glb"/>
				</geometry>
			</visual>
			<collision>
				<geometry>
					<mesh filename="file://$(find airbot_play_description)/meshes/link5.glb"/>
				</geometry>
			</collision>
		</link>

		<joint name="${prefix}joint5" type="revolute">
			<origin rpy="${PI/2} 0 0"/>
			<parent link="${prefix}link4"/>
			<child link="${prefix}link5"/>
			<axis xyz="0 0 1"/>
			<limit lower="-1.74" upper="1.74" effort="300" velocity="6.28"/>
		</joint>

		<link name="${prefix}link6">
			<inertial>
				<origin xyz="0 0 0"/>
				<mass value="0"/>
				<inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find airbot_play_description)/meshes/link6.glb"/>
				</geometry>
			</visual>
			<collision>
				<geometry>
					<mesh filename="file://$(find airbot_play_description)/meshes/link6.glb"/>
				</geometry>
			</collision>
		</link>

		<joint name="${prefix}joint6" type="revolute">
			<origin xyz="0 0.0865 0" rpy="${-PI/2} ${PI/2} 0"/>
			<parent link="${prefix}link5"/>
			<child link="${prefix}link6"/>
			<axis xyz="0 0 1"/>
			<limit lower="-3.14" upper="3.14" effort="300" velocity="6.28"/>
		</joint>

		<xacro:if value="${type == 'xhand1'}">
			<xacro:property name="hand_name" value="${name + '_hand' if name else ''}"/>
			<xacro:property name="hand_prefix" value="${hand_name + '_' if hand_name else ''}"/>
			<xacro:XHand1 name="${hand_name}" direction="${float(direction)}" use_flange="false"
			             fixed_joints="${eef_fixed_joints}"/>
			<joint name="${prefix}hand_base_joint" type="fixed">
				<origin xyz="0 0 0.014"/>
				<parent link="${prefix}link6"/>
				<child link="${hand_prefix}hand_base"/>
			</joint>
			<link name="${prefix}gripper_center"/>
			<joint name="${prefix}joint_custom_end" type="fixed">
				<parent link="${hand_prefix}hand_ee_link"/>
				<child link="${prefix}gripper_center"/>
			</joint>
		</xacro:if>
		<xacro:unless value="${type == 'xhand1'}">
			<xacro:airbot_play_gripper name="${name}"/>
		</xacro:unless>

		<link name="${prefix}camera"/>

		<joint name="${prefix}camera_joint" type="fixed">
			<origin xyz="-0.109 0 0.025" rpy="0 -1.046 0"/>
			<parent link="${prefix}link6"/>
			<child link="${prefix}camera"/>
		</joint>
	</xacro:macro>
</robot>