; OCS2 Wheel Humanoid Configuration - Split Aloha
; ==============================================
; full_body → ocs2_wbc_controller (info_file_name:=task).
;
; 双臂 + Ranger Mini 全向底盘 + 升降：
;   State (3 + 13): [base x,y,yaw | lifting | left×6 | right×6]
;   Input (3 + 13): [vx, vy, omega | lifting | left×6 | right×6]
; 双臂 demo 用同包 task_arm.info + topology:=dual（见 common.yaml）。

;=============================================================================
; Model Information
;=============================================================================

model_information
{
    ; 4 = OmniWheelBasedMobileManipulator（全向底盘 vx, vy, omega）
    manipulatorModelType    4

    ; Pinocchio 根坐标系（Ranger Mini URDF root）
    baseFrame               "base_link"

    ; 双臂末端
    eeFrame                 "left_gripper_center"
    eeFrame1                "right_gripper_center"

    ; 升降平台 / 臂座
    bodyFrame               "arm_base"

    ; 物理舵轮/驱动轮仅可视化（规划 URDF 默认为 fixed）；夹爪 + mimic 不进规划
    removeJoints
    {
        [0]   "fl_steering_joint"
        [1]   "fr_steering_joint"
        [2]   "rl_steering_joint"
        [3]   "rr_steering_joint"
        [4]   "fl_wheel"
        [5]   "fr_wheel"
        [6]   "rl_wheel"
        [7]   "rr_wheel"
        [8]   "left_gripper_joint"
        [9]   "right_gripper_joint"
        [10]  "left_joint8"
        [11]  "right_joint8"
    }
}

;=============================================================================
; Model Settings
;=============================================================================

model_settings
{
    usePreComputation       true
    recompileLibraries      true
}

;=============================================================================
; Initial State
; 总维度 = 3（底盘）+ 13（lifting + 6 左臂 + 6 右臂）= 16
;=============================================================================

initialState
{
    base
    {
        omniWheelBasedMobileManipulator
        {
            (0,0)  0.0   ; x [m]
            (1,0)  0.0   ; y [m]
            (2,0)  0.0   ; yaw [rad]
        }
    }

    arm
    {
        (0,0)   0.0     ; lifting_joint [m]
        (1,0)   0.0     ; left_joint1
        (2,0)   0.255   ; left_joint2
        (3,0)  -0.2     ; left_joint3
        (4,0)   0.0     ; left_joint4
        (5,0)   0.0     ; left_joint5
        (6,0)   0.0     ; left_joint6
        (7,0)   0.0     ; right_joint1
        (8,0)   0.255   ; right_joint2
        (9,0)  -0.2     ; right_joint3
        (10,0)  0.0     ; right_joint4
        (11,0)  0.0     ; right_joint5
        (12,0)  0.0     ; right_joint6
    }
}

;=============================================================================
; Initial Mode Schedule
;=============================================================================

initialModeSchedule
{
    eventTimes
    {
    }

    ; 默认：腰部 FREE（单关节升降不锁腰）+ 双臂独立（无头）
    ; 无定位 TF 时 WBC 也会强制 baseLocked；有 TF 后再 BASE_UNLOCK
    modeSequence
    {
        [0]
        {
            bodyMode "HM_DUAL_BODY_FREE"
            headMode "HEAD_DISABLE"
        }
    }
}

;=============================================================================
; DDP Settings
;=============================================================================

ddp
{
    algorithm                       SLQ

    nThreads                        5
    threadPriority                  50

    maxNumIterations                1
    minRelCost                      0.1
    constraintTolerance             1e-3

    displayInfo                     false
    displayShortSummary             false
    checkNumericalStability         false
    debugPrintRollout               false
    debugCaching                    false

    AbsTolODE                       1e-5
    RelTolODE                       1e-3
    maxNumStepsPerSecond            100000
    timeStep                        1e-3
    backwardPassIntegratorType      ODE45

    constraintPenaltyInitialValue   20.0
    constraintPenaltyIncreaseRate   2.0

    preComputeRiccatiTerms          true

    useFeedbackPolicy               false

    strategy                        LINE_SEARCH
    lineSearch
    {
        minStepLength                   1e-2
        maxStepLength                   1.0
        hessianCorrectionStrategy       DIAGONAL_SHIFT
        hessianCorrectionMultiple       1e-3
    }
}

;=============================================================================
; MPC Settings
;=============================================================================

mpc
{
    timeHorizon                     1.0     ; [s]
    solutionTimeWindow              0.2     ; [s]
    coldStart                       false

    debugPrint                      false

    mpcDesiredFrequency             100     ; [Hz]
    mrtDesiredFrequency             500     ; [Hz]
}

;=============================================================================
; Rollout Settings
;=============================================================================

rollout
{
    AbsTolODE                       1e-5
    RelTolODE                       1e-3
    timeStep                        1e-2
    integratorType                  ODE45
    maxNumStepsPerSecond            100000
    checkNumericalStability         false
}

;=============================================================================
; Body Tracking — 升降平台（arm_base）
;=============================================================================

bodyTrackingEE
{
    activate  true
    muPosition 5.0
    muOrientation 5.0
}

;=============================================================================
; Input Cost
; 总输入维度 = 3（底盘 vx, vy, omega）+ 13（关节）= 16
;=============================================================================

inputCost
{
    R
    {
        base
        {
            omniWheelBasedMobileManipulator
            {
                scaling 1e-2

                (0,0)   5.0     ; 线速度 vx [m/s]
                (1,1)   5.0     ; 线速度 vy [m/s]
                (2,2)   5.0     ; 角速度 omega [rad/s]
            }
        }

        arm
        {
            scaling 1e-3

            (0,0)   5.0     ; lifting_joint
            (1,0)   5.0     ; left_joint1
            (2,0)   5.0     ; left_joint2
            (3,0)   5.0     ; left_joint3
            (4,0)   5.0     ; left_joint4
            (5,0)   2.5     ; left_joint5
            (6,0)   2.5     ; left_joint6
            (7,0)   5.0     ; right_joint1
            (8,0)   5.0     ; right_joint2
            (9,0)   5.0     ; right_joint3
            (10,0)  5.0     ; right_joint4
            (11,0)  2.5     ; right_joint5
            (12,0)  2.5     ; right_joint6
        }
    }
}

;=============================================================================
; End Effector Constraint
;=============================================================================

endEffector
{
    muPosition                      10.0
    muOrientation                   5.0
}

finalEndEffector
{
    muPosition                      20.0
    muOrientation                   10.0
}

;=============================================================================
; Body Relative — 关闭
;=============================================================================

bodyRelative
{
    activate                        false
}

;=============================================================================
; Bimanual Coupling Constraint
;=============================================================================

bimanualCoupling
{
    activate                        true
    muPosition                      50.0
    muOrientation                   25.0
}

;=============================================================================
; Waist Lock — 升降 1-DOF
;=============================================================================

waistLock
{
    activate                        true
    numJoints                       1       ; lifting_joint
}

;=============================================================================
; Head Coupling — 关闭
;=============================================================================

headCoupling
{
    activate                        false
}

;=============================================================================
; Custom Joint Lock — 关闭
;=============================================================================

customJointLock
{
    activate                        false
}

;=============================================================================
; Arm Lock Constraint
;=============================================================================

armLock
{
    activate                        true
    leftNumJoints                   6       ; left_joint1~6
    rightNumJoints                  6       ; right_joint1~6
}

; HOME 关节参考：打开后把未排除关节软拉向 controller HOME。
; 单关节升降 + 双臂全部纳入；activateDefault 默认开。
; excludeJointIndices 是 arm 状态索引（不含底盘 x,y,yaw）。
homeJointReference
{
    activate                        true
    activateDefault                 true
    mu                              1e-3
    excludeJointIndices
    {
    }
}

;=============================================================================
; Joint Position Limits
;=============================================================================

jointPositionLimits
{
    activate                        true
    mu                              1e-3
    delta                           1e-3
}

;=============================================================================
; Joint Velocity Limits
; 输入布局：[base(3) | lifting(1) | left(6) | right(6)]
;=============================================================================

jointVelocityLimits
{
    mu                              1e-2
    delta                           1e-3

    lowerBound
    {
        base
        {
            omniWheelBasedMobileManipulator
            {
                (0,0)  -0.1     ; vx 下界 [m/s]
                (1,0)  -0.1     ; vy 下界 [m/s]
                (2,0)  -0.1     ; omega 下界 [rad/s]
            }
        }

        arm
        {
            (0,0)  -0.3         ; lifting_joint [m/s]
            (1,0)  -1.5708       ; left_joint1 [rad/s]
            (2,0)  -1.5708       ; left_joint2 [rad/s]
            (3,0)  -1.5708       ; left_joint3 [rad/s]
            (4,0)  -1.5708       ; left_joint4 [rad/s]
            (5,0)  -1.5708       ; left_joint5 [rad/s]
            (6,0)  -1.5708       ; left_joint6 [rad/s]
            (7,0)  -1.5708       ; right_joint1 [rad/s]
            (8,0)  -1.5708       ; right_joint2 [rad/s]
            (9,0)  -1.5708       ; right_joint3 [rad/s]
            (10,0) -1.5708       ; right_joint4 [rad/s]
            (11,0) -1.5708       ; right_joint5 [rad/s]
            (12,0) -1.5708       ; right_joint6 [rad/s]
        }
    }

    upperBound
    {
        base
        {
            omniWheelBasedMobileManipulator
            {
                (0,0)   0.1     ; vx 上界 [m/s]
                (1,0)   0.1     ; vy 上界 [m/s]
                (2,0)   0.1     ; omega 上界 [rad/s]
            }
        }

        arm
        {
            (0,0)   0.3         ; lifting_joint [m/s]
            (1,0)   1.5708       ; left_joint1 [rad/s]
            (2,0)   1.5708       ; left_joint2 [rad/s]
            (3,0)   1.5708       ; left_joint3 [rad/s]
            (4,0)   1.5708       ; left_joint4 [rad/s]
            (5,0)   1.5708       ; left_joint5 [rad/s]
            (6,0)   1.5708       ; left_joint6 [rad/s]
            (7,0)   1.5708       ; right_joint1 [rad/s]
            (8,0)   1.5708       ; right_joint2 [rad/s]
            (9,0)   1.5708       ; right_joint3 [rad/s]
            (10,0)  1.5708       ; right_joint4 [rad/s]
            (11,0)  1.5708       ; right_joint5 [rad/s]
            (12,0)  1.5708       ; right_joint6 [rad/s]
        }
    }
}

;=============================================================================
; Self Collision
;=============================================================================

selfCollision
{
    activate                        false

    mu                              1e-3
    delta                           1e-2
    minimumDistance                 0.02

    collisionObjectPairs
    {
    }

    ; 臂 ↔ 箱体 / 升降台
    collisionLinkPairs
    {
        [0] "left_link6, box_link",
        [1] "right_link6, box_link",
        [2] "left_link3, box_link",
        [3] "right_link3, box_link",
        [4] "left_link3, lifting_link",
        [5] "right_link3, lifting_link",
    }
}
