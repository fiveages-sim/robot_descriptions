<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="RangerMini" params="enable_wheel_joints:=false">
    <xacro:property name="steer_joint_type" value="fixed"/>
    <xacro:property name="wheel_joint_type" value="fixed"/>
    <xacro:if value="${enable_wheel_joints}">
      <xacro:property name="steer_joint_type" value="revolute"/>
      <xacro:property name="wheel_joint_type" value="continuous"/>
    </xacro:if>

    <link name="base_link"/>
    <joint name="base_link_joint" type="fixed">
      <parent link="base_link"/>
      <child link="base"/>
      <origin xyz="0 0 0.33"/>
    </joint>

    <link name="base">
      <inertial>
        <origin xyz="-0.0242698272228022 -0.0030308024613212 0.0544267444673498"/>
        <mass value="10"/>
        <inertia ixx="0.1354" ixy="0.0" ixz="0.0" iyy="0.2417" iyz="0.0" izz="0.3085"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="file://$(find split_aloha_description)/meshes/ranger_mini/base.obj"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 -0.1"/>
        <geometry>
          <box size="0.5 0.35 0.2"/>
        </geometry>
      </collision>
    </link>

    <link name="fr_steering_wheel_link">
      <inertial>
        <origin xyz="1.8493E-05 1.2713E-06 0.043679"/>
        <mass value="1"/>
        <inertia
            ixx="0.0063625"
            ixy="-1.0581E-07"
            ixz="-4.0831E-07"
            iyy="0.006363"
            iyz="-3.4944E-08"
            izz="0.010465"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="file://$(find split_aloha_description)/meshes/ranger_mini/steering_wheel.obj"/>
        </geometry>
      </visual>
    </link>

    <joint name="fr_steering_joint" type="${steer_joint_type}">
      <origin xyz="0.241 -0.185 -0.115"/>
      <parent link="base"/>
      <child link="fr_steering_wheel_link"/>
      <axis xyz="0 0 1"/>
      <xacro:if value="${enable_wheel_joints}">
        <limit effort="5" velocity="6.28" lower="-3.14159" upper="3.14159"/>
      </xacro:if>
    </joint>

    <link name="fr_wheel_link">
      <inertial>
        <mass value="8"/>
        <inertia ixx="0.02047" ixy="0.0" ixz="0.0" iyy="0.02047" iyz="0.0" izz="0.0324"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="3.14 0 0"/>
        <geometry>
          <mesh filename="file://$(find split_aloha_description)/meshes/ranger_mini/wheel.obj"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 -0.005" rpy="1.57 0 0"/>
        <geometry>
          <cylinder length="0.08" radius="0.09"/>
        </geometry>
      </collision>
    </link>

    <joint name="fr_wheel" type="${wheel_joint_type}">
      <origin xyz="0.0 0.0 -0.12"/>
      <parent link="fr_steering_wheel_link"/>
      <child link="fr_wheel_link"/>
      <axis xyz="0 1 0"/>
    </joint>

    <link name="fl_steering_wheel_link">
      <inertial>
        <origin xyz="-0.0017956 -9.6304E-08 0.043642"/>
        <mass value="1"/>
        <inertia
            ixx="0.0063695"
            ixy="-2.1067E-08"
            ixz="-0.00016867"
            iyy="0.006363"
            iyz="-1.0301E-08"
            izz="0.010458"/>
      </inertial>
      <visual>
        <origin rpy="0 0 3.14"/>
        <geometry>
          <mesh filename="file://$(find split_aloha_description)/meshes/ranger_mini/steering_wheel.obj"/>
        </geometry>
      </visual>
    </link>

    <joint name="fl_steering_joint" type="${steer_joint_type}">
      <origin xyz="0.241 0.185 -0.115"/>
      <parent link="base"/>
      <child link="fl_steering_wheel_link"/>
      <axis xyz="0 0 1"/>
      <xacro:if value="${enable_wheel_joints}">
        <limit effort="5" velocity="6.28" lower="-3.14159" upper="3.14159"/>
      </xacro:if>
    </joint>

    <link name="fl_wheel_link">
      <inertial>
        <mass value="8"/>
        <inertia ixx="0.02047" ixy="0.0" ixz="0.0" iyy="0.02047" iyz="0.0" izz="0.0324"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="file://$(find split_aloha_description)/meshes/ranger_mini/wheel.obj"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 -0.005" rpy="1.57 0 0"/>
        <geometry>
          <cylinder length="0.08" radius="0.09"/>
        </geometry>
      </collision>
    </link>

    <joint name="fl_wheel" type="${wheel_joint_type}">
      <origin xyz="0.0 0.0 -0.12"/>
      <parent link="fl_steering_wheel_link"/>
      <child link="fl_wheel_link"/>
      <axis xyz="0 1 0"/>
    </joint>

    <link name="rl_steering_wheel_link">
      <inertial>
        <origin xyz="-0.00017093 6.1255E-08 0.043678"/>
        <mass value="1"/>
        <inertia
            ixx="0.0063627"
            ixy="-2.1069E-08"
            ixz="-1.587E-05"
            iyy="0.006363"
            iyz="9.3201E-09"
            izz="0.010465"/>
      </inertial>
      <visual>
        <origin rpy="0 0 3.14"/>
        <geometry>
          <mesh filename="file://$(find split_aloha_description)/meshes/ranger_mini/steering_wheel.obj"/>
        </geometry>
      </visual>
    </link>

    <joint name="rl_steering_joint" type="${steer_joint_type}">
      <origin xyz="-0.253 0.185 -0.115"/>
      <parent link="base"/>
      <child link="rl_steering_wheel_link"/>
      <axis xyz="0 0 1"/>
      <xacro:if value="${enable_wheel_joints}">
        <limit effort="5" velocity="6.28" lower="-3.14159" upper="3.14159"/>
      </xacro:if>
    </joint>

    <link name="rl_wheel_link">
      <inertial>
        <mass value="8"/>
        <inertia ixx="0.02047" ixy="0.0" ixz="0.0" iyy="0.02047" iyz="0.0" izz="0.0324"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="file://$(find split_aloha_description)/meshes/ranger_mini/wheel.obj"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0.00 0.00 -0.005" rpy="1.57 0 0"/>
        <geometry>
          <cylinder length="0.08" radius="0.09"/>
        </geometry>
      </collision>
    </link>

    <joint name="rl_wheel" type="${wheel_joint_type}">
      <origin xyz="0.0 0.0 -0.12"/>
      <parent link="rl_steering_wheel_link"/>
      <child link="rl_wheel_link"/>
      <axis xyz="0 1 0"/>
    </joint>

    <link name="rr_steering_wheel_link">
      <inertial>
        <origin xyz="-0.00017093 -6.1255E-08 0.043678"/>
        <mass value="1"/>
        <inertia
            ixx="0.0063627"
            ixy="-2.1069E-08"
            ixz="-1.587E-05"
            iyy="0.006363"
            iyz="9.3201E-09"
            izz="0.010465"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="file://$(find split_aloha_description)/meshes/ranger_mini/steering_wheel.obj"/>
        </geometry>
      </visual>
    </link>

    <joint name="rr_steering_joint" type="${steer_joint_type}">
      <origin xyz="-0.253 -0.185 -0.115"/>
      <parent link="base"/>
      <child link="rr_steering_wheel_link"/>
      <axis xyz="0 0 1"/>
      <xacro:if value="${enable_wheel_joints}">
        <limit effort="5" velocity="6.28" lower="-3.14159" upper="3.14159"/>
      </xacro:if>
    </joint>

    <link name="rr_wheel_link">
      <inertial>
        <mass value="8"/>
        <inertia ixx="0.02047" ixy="0.0" ixz="0.0" iyy="0.02047" iyz="0.0" izz="0.0324"/>
      </inertial>
      <visual>
        <origin rpy="3.14 0 0"/>
        <geometry>
          <mesh filename="file://$(find split_aloha_description)/meshes/ranger_mini/wheel.obj"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0.00 0 -0.005" rpy="1.57 0 0"/>
        <geometry>
          <cylinder length="0.08" radius="0.09"/>
        </geometry>
      </collision>
    </link>

    <joint name="rr_wheel" type="${wheel_joint_type}">
      <origin xyz="0.0 0.0 -0.12"/>
      <parent link="rr_steering_wheel_link"/>
      <child link="rr_wheel_link"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>
</robot>
