<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:property name="PI" value="3.1415926535897931"/>
  <xacro:macro name="Body" params="parent:=base isaac:=false">
    <!-- isaac:=true hides sensor_models camera / lidar meshes (Isaac asset import). -->
    <link name="box_link">
      <inertial>
        <origin xyz="0.10921 -0.0087718 0.52779"/>
        <mass value="27.261"/>
        <inertia
            ixx="1.8122"
            ixy="4.558E-05"
            ixz="0.014722"
            iyy="1.7779"
            iyz="-4.0693E-05"
            izz="0.28053"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="file://$(find split_aloha_description)/meshes/aloha_split/box_link.glb"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="file://$(find split_aloha_description)/meshes/aloha_split/box_link.glb"/>
        </geometry>
      </collision>
    </link>

    <joint name="box_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="box_link"/>
    </joint>

    <link name="front_camera_link">
      <inertial>
        <origin xyz="-0.011443 0.0003607 -0.0012124"/>
        <mass value="0.020053"/>
        <inertia
            ixx="1.1182E-05"
            ixy="2.589E-09"
            ixz="5.6552E-08"
            iyy="2.2729E-06"
            iyz="-6.7447E-07"
            izz="1.0081E-05"/>
      </inertial>
      <xacro:unless value="${isaac}">
        <visual>
          <geometry>
            <mesh filename="file://$(find sensor_models)/meshes/orbbec/Dabai_Agilex.glb"/>
          </geometry>
        </visual>
      </xacro:unless>
    </link>

    <joint name="front_camera_joint" type="fixed">
      <origin xyz="0.35679 0 0.15819" rpy="${-PI/2-0.6606} 0 ${-PI/2}"/>
      <parent link="box_link"/>
      <child link="front_camera_link"/>
    </joint>

    <link name="lidar_link">
      <inertial>
        <origin xyz="-0.0022133 -0.00090659 0.025996"/>
        <mass value="0.048617"/>
        <inertia
            ixx="1.0358E-05"
            ixy="9.2377E-09"
            ixz="-2.6386E-07"
            iyy="1.0387E-05"
            iyz="-2.6377E-07"
            izz="1.7919E-05"/>
      </inertial>
      <xacro:unless value="${isaac}">
        <visual>
          <geometry>
            <mesh filename="file://$(find sensor_models)/meshes/livox/mid360.glb"/>
          </geometry>
        </visual>
      </xacro:unless>
    </link>

    <joint name="lidar_joint" type="fixed">
      <origin xyz="0.31755 0 0.036188"/>
      <parent link="box_link"/>
      <child link="lidar_link"/>
    </joint>

    <link name="lifting_link">
      <inertial>
        <origin xyz="0.071327 0.00032985 0.10599"/>
        <mass value="0.47066"/>
        <inertia
            ixx="0.010952"
            ixy="-5.2124E-06"
            ixz="-0.00046317"
            iyy="0.0018329"
            iyz="-4.6428E-06"
            izz="0.010201"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="file://$(find split_aloha_description)/meshes/aloha_split/lift_link.glb"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="file://$(find split_aloha_description)/meshes/aloha_split/lift_link.glb"/>
        </geometry>
      </collision>
    </link>

    <joint name="lifting_joint" type="prismatic">
      <origin xyz="0.22448 0 0.3147"/>
      <parent link="box_link"/>
      <child link="lifting_link"/>
      <axis xyz="0 0 1"/>
      <limit lower="0.0" upper="0.8" effort="1000" velocity="10.0"/>
    </joint>

    <link name="top_camera_support">
      <visual>
        <geometry>
          <mesh filename="file://$(find split_aloha_description)/meshes/aloha_split/camera_support.glb"/>
        </geometry>
      </visual>
    </link>

    <joint name="top_camera_support_joint" type="fixed">
      <origin xyz="0.11048 0 0.29448"/>
      <parent link="lifting_link"/>
      <child link="top_camera_support"/>
    </joint>


    <link name="top_camera_link">
      <inertial>
        <origin xyz="-0.011443 2.4833E-05 -0.0012615"/>
        <mass value="0.020053"/>
        <inertia
                ixx="1.1181E-05"
                ixy="1.204E-07"
                ixz="4.9068E-08"
                iyy="2.2587E-06"
                iyz="5.7637E-07"
                izz="1.0097E-05"/>
      </inertial>
      <xacro:unless value="${isaac}">
        <visual>
          <geometry>
            <mesh filename="file://$(find sensor_models)/meshes/orbbec/Dabai_Agilex.glb"/>
          </geometry>
        </visual>
      </xacro:unless>
    </link>

    <joint name="top_camera_joint" type="fixed">
      <origin xyz="0.05158 0 0.000526" rpy="${-PI/2} 0 ${-PI/2}"/>
      <parent link="top_camera_support"/>
      <child link="top_camera_link"/>
    </joint>
  </xacro:macro>
</robot>
