<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="split_aloha">
  <xacro:arg name="ros2_control_hardware_type" default="mock_components"/>
  <xacro:arg name="gazebo" default="false"/>
  <!-- 硬件描述始终用 full 拓扑；demo 规划 dual 只影响 planning URDF。
       全向底盘由 WBC cmd_vel 驱动，轮/舵不进 ros2_control，也不进 /isaac/joint_command。 -->
  <xacro:arg name="enable_wheel_joints" default="false"/>
  <xacro:arg name="type" default=""/>
  <xacro:arg name="arms" default="piper"/>
  <xacro:include filename="$(find split_aloha_description)/xacro/robot.xacro"/>
  <xacro:include filename="$(find piper_description)/xacro/ros2_control/interfaces.xacro"/>
  <xacro:include filename="$(find piper_description)/xacro/ros2_control/end_effector_interfaces.xacro"/>

  <ros2_control name="split_aloha_unified_system" type="system">
    <hardware>
      <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'gz'}">
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </xacro:if>
      <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'mock_components'}">
        <plugin>mock_components/GenericSystem</plugin>
      </xacro:if>
      <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'isaac'}">
        <plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
        <param name="joint_commands_topic">/isaac/joint_command</param>
        <param name="joint_states_topic">/isaac/joint_states</param>
      </xacro:if>
    </hardware>

    <joint name="lifting_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <xacro:piper_interfaces name="left"/>
    <xacro:piper_interfaces name="right"/>
    <xacro:if value="${'$(arg type)' == '' or '$(arg type)' == 'gripper'}">
      <xacro:piper_gripper_interfaces name="left"/>
      <xacro:piper_gripper_interfaces name="right"/>
    </xacro:if>
    <xacro:if value="${'$(arg type)' == 'revo1'}">
      <xacro:include filename="$(find brainco_description)/xacro/ros2_control/revo1.xacro"/>
      <xacro:revo1_interfaces name="left_hand"/>
      <xacro:revo1_interfaces name="right_hand"/>
    </xacro:if>
    <xacro:if value="${'$(arg type)' == 'revo2'}">
      <xacro:include filename="$(find brainco_description)/xacro/ros2_control/revo2.xacro"/>
      <xacro:revo2_interfaces name="left_hand"/>
      <xacro:revo2_interfaces name="right_hand"/>
    </xacro:if>
  </ros2_control>

  <xacro:if value="$(arg gazebo)">
    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find split_aloha_description)/config/ros2_control/ros2_controllers.yaml</parameters>
      </plugin>
    </gazebo>
  </xacro:if>
</robot>
