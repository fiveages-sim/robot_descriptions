<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
	<xacro:property name="PI" value="3.1415926535897931"/>
	<xacro:macro name="Body" params="parent:=base_footprint isaac:=false">
		<!-- isaac:=true hides sensor_models camera / lidar meshes (Isaac asset import). -->

		<link name="body_link">
			<inertial>
				<origin xyz="0.015107 -0.027922 0.00013672"/>
				<mass value="3.736"/>
				<inertia ixx="0.097545" ixy="-9.2609E-06" ixz="0.00015366" iyy="0.045841" iyz="-0.0020459" izz="0.084773"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find cobot_magic_v1_description)/meshes/aloha_v1/body_link.glb"/>
				</geometry>
			</visual>
			<collision>
				<geometry>
					<mesh filename="file://$(find cobot_magic_v1_description)/meshes/aloha_v1/body_link.glb"/>
				</geometry>
			</collision>
		</link>

		<joint name="box2" type="fixed">
			<origin xyz="0 0 0.15"/>
			<parent link="${parent}"/>
			<child link="body_link"/>
		</joint>

		<link name="camera_base_link">
			<inertial>
				<origin xyz="-0.00862442289199344 -5.31672329634469E-08 0.170092831004467"/>
				<mass value="0.336269569361489"/>
				<inertia
						ixx="0.00580628296841397"
						ixy="3.98435937176716E-10"
						ixz="-2.42350052877161E-05"
						iyy="0.00582602200678083"
						iyz="2.9180594404216E-10"
						izz="0.000186894283496158"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find cobot_magic_v1_description)/meshes/aloha_v1/camera_support.glb"/>
				</geometry>
			</visual>
			<collision>
				<geometry>
					<mesh filename="file://$(find cobot_magic_v1_description)/meshes/aloha_v1/camera_support.glb"/>
				</geometry>
			</collision>
		</link>

		<joint name="camera_to_box1" type="fixed">
			<origin xyz="0.18 0 0.626"/>
			<parent link="body_link"/>
			<child link="camera_base_link"/>
			<axis/>
		</joint>

		<!-- 一台可调高度相机：只保留高位安装。
		     stand 原点=三安装孔中心；pitch 原点=旋转孔。低位参考：0.189667 0 0.743143 -->
		<link name="camera_stand2">
			<visual>
				<geometry>
					<mesh filename="file://$(find cobot_magic_v1_description)/meshes/aloha_v1/camera_stand_fixed.glb"/>
				</geometry>
			</visual>
		</link>
		<joint name="camera_joint2" type="fixed">
			<origin xyz="0.187901 0 1.263068"/>
			<parent link="body_link"/>
			<child link="camera_stand2"/>
		</joint>

		<link name="camera_link2">
			<inertial>
				<origin xyz="0.0207658 0.00012644 -0.00075346"/>
				<mass value="0.0877001605148491"/>
				<inertia
						ixx="7.77338961798341E-05"
						ixy="2.44922367048273E-07"
						ixz="1.80373226250749E-08"
						iyy="9.73521616927317E-06"
						iyz="-2.86130173714525E-09"
						izz="7.74953085203139E-05"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find cobot_magic_v1_description)/meshes/aloha_v1/camera_stand_pitch.glb"/>
				</geometry>
			</visual>
		</link>
		<joint name="camera_stand2_joint" type="fixed">
			<origin xyz="0.013337 0 0" rpy="0 0.270534 0"/>
			<parent link="camera_stand2"/>
			<child link="camera_link2"/>
		</joint>

		<link name="camera2">
			<xacro:unless value="${isaac}">
				<visual>
					<geometry>
						<mesh filename="file://$(find sensor_models)/meshes/realsense/d435.glb"/>
					</geometry>
				</visual>
			</xacro:unless>
		</link>
		<joint name="camera2_fixed" type="fixed">
			<origin xyz="0.0499965 0 0" rpy="${-PI/2} 0 ${-PI/2}"/>
			<parent link="camera_link2"/>
			<child link="camera2"/>
		</joint>

		<link name="lidar_link">
			<inertial>
				<origin xyz="-0.0022133 -0.00090659 0.025996"/>
				<mass value="0.048617"/>
				<inertia
						ixx="1.0358E-05"
						ixy="9.2377E-09"
						ixz="-2.6386E-07"
						iyy="1.0387E-05"
						iyz="-2.6377E-07"
						izz="1.7919E-05"/>
			</inertial>
			<xacro:unless value="${isaac}">
				<visual>
					<geometry>
						<mesh filename="file://$(find sensor_models)/meshes/livox/mid360.glb"/>
					</geometry>
				</visual>
			</xacro:unless>
		</link>

		<joint name="lidar_joint" type="fixed">
			<origin xyz="0.22937 0 0.040672"/>
			<parent link="body_link"/>
			<child link="lidar_link"/>
		</joint>
	</xacro:macro>
</robot>
