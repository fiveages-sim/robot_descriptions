<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="piper_l" params="prefix:='' camera:='none'">

        <link name="${prefix}base_link">
            <inertial>
                <origin xyz="-0.00347 -0.00012 0.04283" rpy="0 0 0"/>
                <mass value="1.07"/>
                <inertia ixx="0.00099887" ixy="0.00000194" ixz="0.00000613" iyy="0.00112771" iyz="0.00000201"
                         izz="0.00096552"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find piper_l_description)/meshes/base_link.glb"/>
                </geometry>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="file://$(find piper_l_description)/meshes/base_link.glb"/>
                </geometry>
            </collision>
        </link>

        <link name="${prefix}link1">
            <inertial>
                <origin xyz="0.00201 -0.00220 -0.02127" rpy="0 0 0"/>
                <mass value="0.11"/>
                <inertia ixx="0.00011279" ixy="0.00000011" ixz="0.00000186" iyy="0.00007274" iyz="0.00000781"
                         izz="0.00011091"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find piper_l_description)/meshes/link1.glb"/>
                </geometry>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="file://$(find piper_l_description)/meshes/link1.glb"/>
                </geometry>
            </collision>
        </link>
        <joint name="${prefix}joint1" type="revolute">
            <origin xyz="0 0 0.123" rpy="0 0 0"/>
            <parent link="${prefix}base_link"/>
            <child link="${prefix}link1"/>
            <axis xyz="0 0 1"/>
            <limit lower="-2.618" upper="2.618" effort="100" velocity="3"/>
        </joint>

        <link name="${prefix}link2">
            <inertial>
                <origin xyz="0.25986 -0.00913 0.00237" rpy="0 0 0"/>
                <mass value="1.16"/>
                <inertia ixx="0.00096865" ixy="0.00041154" ixz="0.00005836" iyy="0.01629404" iyz="0.00001694"
                         izz="0.01628996"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find piper_l_description)/meshes/link2.glb"/>
                </geometry>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="file://$(find piper_l_description)/meshes/link2.glb"/>
                </geometry>
            </collision>
        </link>
        <joint name="${prefix}joint2" type="revolute">
            <origin xyz="0 0 0" rpy="1.5708 -0.1745 3.1416"/>
            <parent link="${prefix}link1"/>
            <child link="${prefix}link2"/>
            <axis xyz="0 0 1"/>
            <limit lower="0" upper="3.14" effort="100" velocity="3"/>
        </joint>

        <link name="${prefix}link3">
            <inertial>
                <origin xyz="-0.00726 -0.19029 -0.00045" rpy="0 0 0"/>
                <mass value="0.59"/>
                <inertia ixx="0.00558278" ixy="0.00018354" ixz="0.00000254" iyy="0.00026568" iyz="0.00005267"
                         izz="0.00554212"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find piper_l_description)/meshes/link3.glb"/>
                </geometry>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="file://$(find piper_l_description)/meshes/link3.glb"/>
                </geometry>
            </collision>
        </link>
        <joint name="${prefix}joint3" type="revolute">
            <origin xyz="0.33823 0 0" rpy="0 0 -1.8325"/>
            <parent link="${prefix}link2"/>
            <child link="${prefix}link3"/>
            <axis xyz="0 0 1"/>
            <limit lower="-2.697" upper="0" effort="100" velocity="3"/>
        </joint>

        <link name="${prefix}link4">
            <inertial>
                <origin xyz="0.00054 -0.00162 -0.00399" rpy="0 0 0"/>
                <mass value="0.37"/>
                <inertia ixx="0.00017066" ixy="0.00000129" ixz="0.00000316" iyy="0.00017128" iyz="0.00000775"
                         izz="0.00014437"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find piper_l_description)/meshes/link4.glb"/>
                </geometry>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="file://$(find piper_l_description)/meshes/link4.glb"/>
                </geometry>
            </collision>
        </link>
        <joint name="${prefix}joint4" type="revolute">
            <origin xyz="0 -0.3215 0" rpy="1.5708 0 0.0"/>
            <parent link="${prefix}link3"/>
            <child link="${prefix}link4"/>
            <axis xyz="0 0 1"/>
            <limit lower="-1.832" upper="1.832" effort="100" velocity="3"/>
        </joint>

        <link name="${prefix}link5">
            <inertial>
                <origin xyz="0.0002 -0.06142 -0.00257" rpy="0 0 0"/>
                <mass value="0.38"/>
                <inertia ixx="0.00029534" ixy="0.00000167" ixz="0.00000016" iyy="0.00016988" iyz="0.00005020"
                         izz="0.00028334"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find piper_l_description)/meshes/link5.glb"/>
                </geometry>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="file://$(find piper_l_description)/meshes/link5.glb"/>
                </geometry>
            </collision>
        </link>
        <joint name="${prefix}joint5" type="revolute">
            <origin xyz="0 0 0" rpy="-1.5708 0.0 0"/>
            <parent link="${prefix}link4"/>
            <child link="${prefix}link5"/>
            <axis xyz="0 0 -1"/>
            <limit lower="-1.22" upper="1.22" effort="100" velocity="3"/>
        </joint>

        <link name="${prefix}link6">
            <inertial>
                <origin xyz="0 -3.47e-06 -0.00315" rpy="0 0 0"/>
                <mass value="0.0056"/>
                <inertia ixx="5.13e-07" ixy="0" ixz="0" iyy="5.13e-07" iyz="0" izz="9.81e-07"/>
            </inertial>
            <visual>
                <origin xyz="0.008 -0.002 0.064" rpy="-1.57 0 1.57"/>
                <geometry>
                    <mesh filename="file://$(find piper_l_description)/meshes/gripper_base_100_v3.glb"/>
                </geometry>
            </visual>
            <collision>
                <origin xyz="0.008 -0.002 0.064" rpy="-1.57 0 1.57"/>
                <geometry>
                    <mesh filename="file://$(find piper_l_description)/meshes/gripper_base_100_v3.glb"/>
                </geometry>
            </collision>
        </link>
        <joint name="${prefix}joint6" type="revolute">
            <origin xyz="0 -0.091 0" rpy="1.5708 0 0"/>
            <parent link="${prefix}link5"/>
            <child link="${prefix}link6"/>
            <axis xyz="0 0 1"/>
            <limit lower="-3.14" upper="3.14" effort="100" velocity="3"/>
        </joint>

        <link name="${prefix}link7">
            <visual>
                <geometry>
                    <mesh filename="file://$(find piper_l_description)/meshes/link7.glb"/>
                </geometry>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="file://$(find piper_l_description)/meshes/link7.glb"/>
                </geometry>
            </collision>
        </link>
        <joint name="${prefix}joint7" type="prismatic">
            <origin xyz="0 0 0.13503" rpy="1.5708 0 0"/>
            <parent link="${prefix}link6"/>
            <child link="${prefix}link7"/>
            <axis xyz="0 0 -1"/>
            <limit lower="0" upper="0.05" effort="100" velocity="1"/>
        </joint>

        <link name="${prefix}link8">
            <visual>
                <geometry>
                    <mesh filename="file://$(find piper_l_description)/meshes/link8.glb"/>
                </geometry>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="file://$(find piper_l_description)/meshes/link8.glb"/>
                </geometry>
            </collision>
        </link>
        <joint name="${prefix}joint8" type="prismatic">
            <origin xyz="0 0 0.13503" rpy="-1.5708 0 0"/>
            <parent link="${prefix}link6"/>
            <child link="${prefix}link8"/>
            <axis xyz="0 0 1"/>
            <limit lower="-0.05" upper="0" effort="100" velocity="1"/>
            <mimic joint="${prefix}joint7" multiplier="-1" offset="0"/>
        </joint>

        <xacro:if value="${camera == 'd435'}">
            <link name="${prefix}camera_stand_link">
                <visual>
                    <origin rpy="0 0 0" xyz="0 0 0"/>
                    <geometry>
                        <mesh filename="file://$(find piper_l_description)/meshes/realsense_mid_stand_v2.glb"/>
                    </geometry>
                </visual>
                <collision>
                    <origin rpy="0 0 0" xyz="0 0 0"/>
                    <geometry>
                        <mesh filename="file://$(find piper_l_description)/meshes/realsense_mid_stand_v2.glb"/>
                    </geometry>
                </collision>
            </link>
            <joint name="${prefix}camera_stand_joint" type="fixed">
                <origin xyz="-0.034 -0.002 0.023" rpy="0 0 0"/>
                <parent link="${prefix}link6"/>
                <child link="${prefix}camera_stand_link"/>
            </joint>

            <link name="${prefix}d435_camera_link">
                <visual>
                    <geometry>
                        <mesh filename="file://$(find sensor_models)/meshes/d435/d435.obj"/>
                    </geometry>
                </visual>
                <collision>
                    <origin xyz="-0.0125 0 0" rpy="0 0 0"/>
                    <geometry>
                        <box size="0.0251 0.0899 0.025"/>
                    </geometry>
                </collision>
            </link>
            <joint name="${prefix}d435_camera_joint" type="fixed">
                <origin xyz="-0.032 -0.028 0.0" rpy="0.0 -1.22 0"/>
                <parent link="${prefix}camera_stand_link"/>
                <child link="${prefix}d435_camera_link"/>
            </joint>
        </xacro:if>
        <link name="${prefix}gripper_center"/>
        <joint name="${prefix}gripper_center_fixed" type="fixed">
            <parent link="${prefix}link6"/>
            <child link="${prefix}gripper_center"/>
            <origin xyz="0 0 0.13503" rpy="0 -1.5708 0"/>
        </joint>
    </xacro:macro>
</robot>