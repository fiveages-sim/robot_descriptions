<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="piper_x" params="prefix:='' camera:='none' gripper:='true'">

        <link name="${prefix}base_link">
            <inertial>
                <origin xyz="-0.00347 -0.00012 0.04283" rpy="0 0 0"/>
                <mass value="1.07"/>
                <inertia ixx="0.00298745" ixy="0.00000369" ixz="0.00016646" iyy="0.00312688" iyz="0.00000832"
                         izz="0.00093042"/>
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="file://$(find piper_x_description)/meshes/base_link.glb"/>
                </geometry>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="file://$(find piper_x_description)/meshes/base_link.glb"/>
                </geometry>
            </collision>
        </link>

        <link name="${prefix}link1">
            <inertial>
                <origin xyz="0.00065 0.00006 -0.00325" rpy="0 0 0"/>
                <mass value="0.71"/>
                <inertia ixx="0.00051254" ixy="0.00000294" ixz="0.00001039" iyy="0.00041089" iyz="0.00000240"
                         izz="0.00045962"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find piper_x_description)/meshes/link1.glb"/>
                </geometry>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="file://$(find piper_x_description)/meshes/link1.glb"/>
                </geometry>
            </collision>
        </link>
        <joint name="${prefix}joint1" type="revolute">
            <origin xyz="0 0 0.123" rpy="0 0 0"/>
            <parent link="${prefix}base_link"/>
            <child link="${prefix}link1"/>
            <axis xyz="0 0 1"/>
            <limit lower="-2.618" upper="2.618" effort="100" velocity="10"/>
        </joint>

        <link name="${prefix}link2">
            <inertial>
                <origin xyz="0.21854 -0.00853 0.00234" rpy="0 0 0"/>
                <mass value="1.16"/>
                <inertia ixx="0.00109788" ixy="0.00180610" ixz="0.00055040" iyy="0.06763354" iyz="0.00000813"
                         izz="0.06762540"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find piper_x_description)/meshes/link2.glb"/>
                </geometry>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="file://$(find piper_x_description)/meshes/link2.glb"/>
                </geometry>
            </collision>
        </link>
        <joint name="${prefix}joint2" type="revolute">
            <origin xyz="0 0 0" rpy="1.5708 -0.13586 3.1416"/>
            <parent link="${prefix}link1"/>
            <child link="${prefix}link2"/>
            <axis xyz="0 0 1"/>
            <limit lower="0" upper="3.14" effort="100" velocity="10"/>
        </joint>

        <link name="${prefix}link3">
            <inertial>
                <origin xyz="0.20190 -0.00415 -0.00114" rpy="0 0 0"/>
                <mass value="0.67"/>
                <inertia ixx="0.00033471" ixy="0.00026891" ixz="0.00013918" iyy="0.03360411" iyz="0.00000052"
                         izz="0.03356941"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find piper_x_description)/meshes/link3.glb"/>
                </geometry>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="file://$(find piper_x_description)/meshes/link3.glb"/>
                </geometry>
            </collision>
        </link>
        <joint name="${prefix}joint3" type="revolute">
            <origin xyz="0.28503 0 0" rpy="0 0 2.8377"/>
            <parent link="${prefix}link2"/>
            <child link="${prefix}link3"/>
            <axis xyz="0 0 1"/>
            <limit lower="-2.9671" upper="0" effort="100" velocity="10"/>
        </joint>

        <link name="${prefix}link4">
            <inertial>
                <origin xyz="0.06593 -0.04751 -0.00274" rpy="0 0 0"/>
                <mass value="0.4"/>
                <inertia ixx="0.00120173" ixy="0.00138165" ixz="0.00001187" iyy="0.00209324" iyz="0.00000217"
                         izz="0.00307814"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find piper_x_description)/meshes/link4.glb"/>
                </geometry>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="file://$(find piper_x_description)/meshes/link4.glb"/>
                </geometry>
            </collision>
        </link>
        <joint name="${prefix}joint4" type="revolute">
            <origin xyz="0.27264 0 0" rpy="0 0 0.075129"/>
            <parent link="${prefix}link3"/>
            <child link="${prefix}link4"/>
            <axis xyz="0 0 1"/>
            <limit lower="-1.57" upper="1.57" effort="100" velocity="10"/>
        </joint>

        <link name="${prefix}link5">
            <inertial>
                <origin xyz="0.00005 0.0 -0.00417" rpy="0 0 0"/>
                <mass value="0.35"/>
                <inertia ixx="0.00022660" ixy="0.00000019" ixz="0.00000005" iyy="0.00017740" iyz="0.00000085"
                         izz="0.00019425"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find piper_x_description)/meshes/link5.glb"/>
                </geometry>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="file://$(find piper_x_description)/meshes/link5.glb"/>
                </geometry>
            </collision>
        </link>
        <joint name="${prefix}joint5" type="revolute">
            <origin xyz="0.076857 0.00062395 0" rpy="-1.5708 0 0"/>
            <parent link="${prefix}link4"/>
            <child link="${prefix}link5"/>
            <axis xyz="0 0 1"/>
            <limit lower="-1.57" upper="1.57" effort="100" velocity="10"/>
        </joint>

        <link name="${prefix}link6">
            <inertial>
                <origin xyz="0 0 -0.00351" rpy="0 0 0"/>
                <mass value="0.007"/>
                <inertia ixx="0.00000064" ixy="0" ixz="0" iyy="0.00000064" iyz="0" izz="0.00000106"/>
            </inertial>
            <visual>
                <origin xyz="0 0 -0.035" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="file://$(find piper_x_description)/meshes/link6.glb"/>
                </geometry>
            </visual>
            <collision>
                <origin xyz="0 0 -0.035" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="file://$(find piper_x_description)/meshes/link6.glb"/>
                </geometry>
            </collision>
        </link>
        <joint name="${prefix}joint6" type="revolute">
            <origin xyz="0.035 0 0" rpy="1.5708 0 1.5708"/>
            <parent link="${prefix}link5"/>
            <child link="${prefix}link6"/>
            <axis xyz="0 0 1"/>
            <limit lower="-3.14" upper="3.14" effort="100" velocity="10"/>
        </joint>

        <link name="${prefix}gripper_base">
            <inertial>
                <origin xyz="-0.00006 -0.00003 0.0321436689908876" rpy="0 0 0"/>
                <mass value="0.52"/>
                <inertia ixx="0.00151445" ixy="0.00000048" ixz="0.00000003" iyy="0.00162326" iyz="0.00000277"
                         izz="0.00030728"/>
            </inertial>
            <visual>
                <origin xyz="0.002 0.0078 0.06" rpy="-1.57 0 3.14"/>
                <geometry>
                    <mesh filename="file://$(find piper_x_description)/meshes/gripper_base_100_v2.glb"
                          scale="0.8 0.8 0.8"/>
                </geometry>
            </visual>
            <collision>
                <origin xyz="0.002 0.0078 0.06" rpy="-1.57 0 3.14"/>
                <geometry>
                    <mesh filename="file://$(find piper_x_description)/meshes/gripper_base_100_v2.glb"
                          scale="0.8 0.8 0.8"/>
                </geometry>
            </collision>
        </link>
        <joint name="${prefix}joint6_to_gripper_base" type="fixed">
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <parent link="${prefix}link6"/>
            <child link="${prefix}gripper_base"/>
        </joint>

        <link name="${prefix}link7">
            <inertial>
                <origin xyz="0.000277816920932317 -0.0467673824063769 -0.00921030054508036" rpy="0 0 0"/>
                <mass value="0.0264822021416248"/>
                <inertia ixx="9.99779119357223E-06" ixy="-1.57542283433504E-07" ixz="2.71367446701359E-08"
                         iyy="6.17952441557932E-06" iyz="1.58939319453383E-06" izz="1.4210192754512E-05"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find piper_x_description)/meshes/link7.glb"/>
                </geometry>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="file://$(find piper_x_description)/meshes/link7.glb"/>
                </geometry>
            </collision>
        </link>
        <joint name="${prefix}joint7" type="prismatic">
            <origin xyz="0 0 0.13503" rpy="1.5708 0 1.5708"/>
            <parent link="${prefix}gripper_base"/>
            <child link="${prefix}link7"/>
            <axis xyz="0 0 -1"/>
            <limit lower="0" upper="0.05" effort="100" velocity="1"/>
        </joint>

        <link name="${prefix}link8">
            <inertial>
                <origin xyz="0.000277816920932317 0.0467673824063769 -0.00921030054508036" rpy="0 0 0"/>
                <mass value="0.0264822021416248"/>
                <inertia ixx="9.99779119357223E-06" ixy="-1.57542283433504E-07" ixz="2.71367446701359E-08"
                         iyy="6.17952441557932E-06" iyz="1.58939319453383E-06" izz="1.4210192754512E-05"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find piper_x_description)/meshes/link8.glb"/>
                </geometry>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="file://$(find piper_x_description)/meshes/link8.glb"/>
                </geometry>
            </collision>
        </link>
        <joint name="${prefix}joint8" type="prismatic">
            <origin xyz="0 0 0.13503" rpy="-1.5708 0 1.5708"/>
            <parent link="${prefix}gripper_base"/>
            <child link="${prefix}link8"/>
            <axis xyz="0 0 1"/>
            <limit lower="-0.05" upper="0" effort="100" velocity="1"/>
            <mimic joint="${prefix}joint7" multiplier="-1" offset="0"/>
        </joint>
        <link name="${prefix}gripper_center"/>
        <joint name="${prefix}gripper_center_fixed" type="fixed">
            <parent link="${prefix}link6"/>
            <child link="${prefix}gripper_center"/>
            <origin xyz="0 0 0.13503" rpy="1.5708 -1.5708 0"/>
        </joint>

        <xacro:if value="${camera == 'd435'}">
            <link name="${prefix}camera_stand_link">
                <inertial>
                    <origin rpy="0 0 0" xyz="0 0 0"/>
                    <mass value="0.0"/>
                    <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
                </inertial>
                <visual name="">
                    <origin rpy="0 0 0" xyz="0 0 0"/>
                    <geometry>
                        <mesh filename="file://$(find piper_x_description)/meshes/realsense_mid_stand.glb"/>
                    </geometry>
                </visual>
                <collision>
                    <origin rpy="0 0 0" xyz="0 0 0"/>
                    <geometry>
                        <mesh filename="file://$(find piper_x_description)/meshes/realsense_mid_stand.glb"/>
                    </geometry>
                </collision>
            </link>
            <joint name="${prefix}camera_stand_joint" type="fixed">
                <origin rpy="1.57 3.14 0.0" xyz="0.001 -0.036 0.022"/>
                <parent link="${prefix}gripper_base"/>
                <child link="${prefix}camera_stand_link"/>
            </joint>

            <link name="${prefix}camera">
                <visual>
                    <geometry>
                        <mesh filename="file://$(find sensor_models)/meshes/d435/d435.obj"/>
                    </geometry>
                </visual>
                <collision name="simple_d435camera">
                    <origin xyz="-0.0125 0 0" rpy="0 0 0"/>
                    <geometry>
                        <box size="0.0251 0.0899 0.025"/>
                    </geometry>
                </collision>
            </link>
            <joint name="${prefix}camera_fixed" type="fixed">
                <origin rpy="0.0 -1.22 1.57" xyz="0.029 -0.069 0.022"/>
                <parent link="${prefix}gripper_base"/>
                <child link="${prefix}camera"/>
            </joint>

        </xacro:if>

    </xacro:macro>
</robot>