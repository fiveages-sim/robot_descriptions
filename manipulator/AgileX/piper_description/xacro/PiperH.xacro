<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="PiperH" params="name">
        <xacro:property name="prefix" value="${name + '_' if name else ''}"/>

        <link name="${prefix}base_link">
            <inertial>
                <origin xyz="-0.00473641164191482 2.56829134630247E-05 0.041451518036016"/>
                <mass value="1.02"/>
                <inertia ixx="0.00267433" ixy="-0.00000073" ixz="-0.00017389" iyy="0.00282612" iyz="0.0000004"
                         izz="0.00089624"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find piper_description)/meshes/visual/base_link.glb"/>
                </geometry>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="file://$(find piper_description)/meshes/visual/base_link.glb"/>
                </geometry>
            </collision>
        </link>
        <link name="${prefix}link1">
            <inertial>
                <origin xyz="0.00032 -0.00041 -0.00348"/>
                <mass value="0.71"/>
                <inertia ixx="0.00050027" ixy="0.00000078" ixz="0.00000626" iyy="0.00040879" iyz="0.00000462"
                         izz="0.00045802"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find piper_description)/meshes/visual/link1.glb"/>
                </geometry>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="file://$(find piper_description)/meshes/visual/link1.glb"/>
                </geometry>
            </collision>
        </link>
        <joint name="${prefix}joint1" type="revolute">
            <origin xyz="0 0 0.123"/>
            <parent link="${prefix}base_link"/>
            <child link="${prefix}link1"/>
            <axis xyz="0 0 1"/>
            <limit lower="-2.6179938" upper="2.6179938" effort="100" velocity="5"/>
        </joint>
        <link name="${prefix}link2">
            <inertial>
                <origin xyz="0.21852 -0.00861 0.00126"/>
                <mass value="1.16"/>
                <inertia ixx="0.00111915" ixy="0.00182916" ixz="0.00019233" iyy="0.06763251" iyz="0.00000767"
                         izz="0.067559"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find piper_description)/meshes/visual/link2.glb"/>
                </geometry>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="file://$(find piper_description)/meshes/visual/link2.glb"/>
                </geometry>
            </collision>
        </link>
        <joint name="${prefix}joint2" type="revolute">
            <origin xyz="0 0 0" rpy="1.5707963 -0.1357866 -3.1415926"/>
            <parent link="${prefix}link1"/>
            <child link="${prefix}link2"/>
            <axis xyz="0 0 1"/>
            <limit lower="0" upper="3.1415926" effort="100" velocity="5"/>
        </joint>
        <link name="${prefix}link3">
            <inertial>
                <origin xyz="-0.01999 -0.14808 -0.00053"/>
                <mass value="0.5"/>
                <inertia ixx="0.01347608" ixy="0.00161034" ixz="0.00000066" iyy="0.00046377" iyz="0.00000162"
                         izz="0.01363321"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find piper_description)/meshes/piper_h/link3.glb"/>
                </geometry>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="file://$(find piper_description)/meshes/piper_h/link3.glb"/>
                </geometry>
            </collision>
        </link>
        <joint name="${prefix}joint3" type="revolute">
            <origin xyz="0.28503 0 0" rpy="0 0 -1.7938494"/>
            <parent link="${prefix}link2"/>
            <child link="${prefix}link3"/>
            <axis xyz="0 0 1"/>
            <limit lower="-2.9670597" upper="0" effort="100" velocity="5"/>
        </joint>
        <link name="${prefix}link4">
            <inertial>
                <origin xyz="0.00013 -0.00076 -0.00394"/>
                <mass value="0.38"/>
                <inertia ixx="0.00017844" ixy="0.00000062" ixz="0.00000067" iyy="0.00018914" iyz="0.00000408"
                         izz="0.00014613"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find piper_description)/meshes/piper_h/link4.glb"/>
                </geometry>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="file://$(find piper_description)/meshes/piper_h/link4.glb"/>
                </geometry>
            </collision>
        </link>
        <joint name="${prefix}joint4" type="revolute">
            <origin xyz="-0.02198 -0.25575 0" rpy="1.5707963 0 0"/>
            <parent link="${prefix}link3"/>
            <child link="${prefix}link4"/>
            <axis xyz="0 0 1"/>
            <limit lower="-2.3561944" upper="2.3561944" effort="100" velocity="5"/>
        </joint>
        <link name="${prefix}link5">
            <inertial>
                <origin xyz="0.00018 -0.06104 -0.00227"/>
                <mass value="0.39"/>
                <inertia ixx="0.00172318" ixy="0.00000259" ixz="0.00000010" iyy="0.00017936" iyz="0.00000990"
                         izz="0.00171172"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find piper_description)/meshes/piper_h/link5.glb"/>
                </geometry>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="file://$(find piper_description)/meshes/piper_h/link5.glb"/>
                </geometry>
            </collision>
        </link>
        <joint name="${prefix}joint5" type="revolute">
            <origin xyz="0 0 0" rpy="-1.5707963 0 0"/>
            <parent link="${prefix}link4"/>
            <child link="${prefix}link5"/>
            <axis xyz="0 0 1"/>
            <limit lower="-1.5620696" upper="1.5620696" effort="100" velocity="5"/>
        </joint>
        <link name="${prefix}link6">
            <inertial>
                <origin xyz="-0.00003 0.00006 -0.002"/>
                <mass value="0.007"/>
                <inertia ixx="0.00152112" ixy="0.00000202" ixz="0.00000261" iyy="0.00138626" iyz="0.00000002"
                         izz="0.00031152"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find piper_description)/meshes/visual/link6.glb"/>
                </geometry>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="file://$(find piper_description)/meshes/visual/link6.glb"/>
                </geometry>
            </collision>
        </link>
        <joint name="${prefix}joint6" type="revolute">
            <origin xyz="0 -0.0963 0" rpy="1.5707963 0 0"/>
            <parent link="${prefix}link5"/>
            <child link="${prefix}link6"/>
            <axis xyz="0 0 1"/>
            <limit lower="-2.0943951" upper="2.0943951" effort="100" velocity="5"/>
        </joint>

        <link name="${prefix}tcp"/>
        <joint name="${prefix}tcp_joint" type="fixed">
            <parent link="${prefix}link6"/>
            <child link="${prefix}tcp"/>
        </joint>
    </xacro:macro>
</robot>
