<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:arg name="collider" default="convex"/>
    <xacro:property name="PI" value="3.1415926535897931"/>
    <xacro:property name="collider_type" value="$(arg collider)"/>
    <xacro:include filename="$(find piper_description)/xacro/components/gripper_l.xacro"/>
    <xacro:macro name="piper_l_arm" params="name collider:=convex camera:=d435 with_gripper:='true'">
        <xacro:property name="prefix" value="${name + '_' if name else ''}"/>
        <link name="${prefix}base_link">
            <inertial>
                <origin xyz="-0.00347 -0.00012 0.04283" rpy="0 0 0"/>
                <mass value="1.07"/>
                <inertia ixx="0.00099887" ixy="0.00000194" ixz="0.00000613" iyy="0.00112771" iyz="0.00000201"
                         izz="0.00096552"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find piper_description)/meshes/base/base_link.glb"/>
                </geometry>
            </visual>
            <xacro:if value="${collider == 'convex'}">
                <collision>
                    <geometry>
                        <mesh filename="file://$(find piper_description)/meshes/base/base_link.glb"/>
                    </geometry>
                </collision>
            </xacro:if>
        </link>

        <link name="${prefix}link1">
            <inertial>
                <origin xyz="0.00201 -0.00220 -0.02127" rpy="0 0 0"/>
                <mass value="0.11"/>
                <inertia ixx="0.00011279" ixy="0.00000011" ixz="0.00000186" iyy="0.00007274" iyz="0.00000781"
                         izz="0.00011091"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find piper_description)/meshes/base/link1.glb"/>
                </geometry>
            </visual>
            <xacro:if value="${collider == 'convex'}">
                <collision>
                    <geometry>
                        <mesh filename="file://$(find piper_description)/meshes/base/link1.glb"/>
                    </geometry>
                </collision>
            </xacro:if>
        </link>
        <joint name="${prefix}joint1" type="revolute">
            <origin xyz="0 0 0.123" rpy="0 0 0"/>
            <parent link="${prefix}base_link"/>
            <child link="${prefix}link1"/>
            <axis xyz="0 0 1"/>
            <limit lower="-2.618" upper="2.618" effort="100" velocity="3"/>
        </joint>

        <link name="${prefix}link2">
            <inertial>
                <origin xyz="0.25986 -0.00913 0.00237" rpy="0 0 0"/>
                <mass value="1.16"/>
                <inertia ixx="0.00096865" ixy="0.00041154" ixz="0.00005836" iyy="0.01629404" iyz="0.00001694"
                         izz="0.01628996"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find piper_description)/meshes/piper_l/link2.glb"/>
                </geometry>
            </visual>
            <xacro:if value="${collider == 'convex'}">
                <collision>
                    <geometry>
                        <mesh filename="file://$(find piper_description)/meshes/piper_l/link2.glb"/>
                    </geometry>
                </collision>
            </xacro:if>
        </link>
        <joint name="${prefix}joint2" type="revolute">
            <origin xyz="0 0 0" rpy="1.5708 -0.1745 3.1416"/>
            <parent link="${prefix}link1"/>
            <child link="${prefix}link2"/>
            <axis xyz="0 0 1"/>
            <limit lower="0" upper="3.14" effort="100" velocity="3"/>
        </joint>

        <link name="${prefix}link3">
            <inertial>
                <origin xyz="-0.00726 -0.19029 -0.00045" rpy="0 0 0"/>
                <mass value="0.59"/>
                <inertia ixx="0.00558278" ixy="0.00018354" ixz="0.00000254" iyy="0.00026568" iyz="0.00005267"
                         izz="0.00554212"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find piper_description)/meshes/piper_l/link3.glb"/>
                </geometry>
            </visual>
            <xacro:if value="${collider == 'convex'}">
                <collision>
                    <geometry>
                        <mesh filename="file://$(find piper_description)/meshes/piper_l/link3.glb"/>
                    </geometry>
                </collision>
            </xacro:if>
        </link>
        <joint name="${prefix}joint3" type="revolute">
            <origin xyz="0.33823 0 0" rpy="0 0 -1.8325"/>
            <parent link="${prefix}link2"/>
            <child link="${prefix}link3"/>
            <axis xyz="0 0 1"/>
            <limit lower="-2.697" upper="0" effort="100" velocity="3"/>
        </joint>

        <link name="${prefix}link4">
            <inertial>
                <origin xyz="0.00054 -0.00162 -0.00399" rpy="0 0 0"/>
                <mass value="0.37"/>
                <inertia ixx="0.00017066" ixy="0.00000129" ixz="0.00000316" iyy="0.00017128" iyz="0.00000775"
                         izz="0.00014437"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find piper_description)/meshes/piper_l/link4.glb"/>
                </geometry>
            </visual>
            <xacro:if value="${collider == 'convex'}">
                <collision>
                    <geometry>
                        <mesh filename="file://$(find piper_description)/meshes/piper_l/link4.glb"/>
                    </geometry>
                </collision>
            </xacro:if>
        </link>
        <joint name="${prefix}joint4" type="revolute">
            <origin xyz="0 -0.3215 0" rpy="1.5708 0 0.0"/>
            <parent link="${prefix}link3"/>
            <child link="${prefix}link4"/>
            <axis xyz="0 0 1"/>
            <limit lower="-1.832" upper="1.832" effort="100" velocity="3"/>
        </joint>

        <link name="${prefix}link5">
            <inertial>
                <origin xyz="0.0002 -0.06142 -0.00257" rpy="0 0 0"/>
                <mass value="0.38"/>
                <inertia ixx="0.00029534" ixy="0.00000167" ixz="0.00000016" iyy="0.00016988" iyz="0.00005020"
                         izz="0.00028334"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find piper_description)/meshes/piper_l/link5.glb"/>
                </geometry>
            </visual>
            <xacro:if value="${collider == 'convex'}">
                <collision>
                    <geometry>
                        <mesh filename="file://$(find piper_description)/meshes/piper_l/link5.glb"/>
                    </geometry>
                </collision>
            </xacro:if>
        </link>
        <joint name="${prefix}joint5" type="revolute">
            <origin xyz="0 0 0" rpy="-1.5708 0.0 0"/>
            <parent link="${prefix}link4"/>
            <child link="${prefix}link5"/>
            <axis xyz="0 0 -1"/>
            <limit lower="-1.22" upper="1.22" effort="100" velocity="3"/>
        </joint>

        <xacro:if value="${str(with_gripper).lower() in ['1', 'true', 'yes', 'on']}">
            <xacro:piper_gripper_l
                    prefix="${prefix}"
                    parent_link="${prefix}link5"
                    collider="${collider}"
                    camera="${camera}"/>
        </xacro:if>
    </xacro:macro>
</robot>