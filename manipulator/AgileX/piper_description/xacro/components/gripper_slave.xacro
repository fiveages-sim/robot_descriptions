<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find piper_description)/xacro/components/camera.xacro"/>
    <xacro:macro name="piper_gripper_slave" params="prefix parent_link collider:=simple camera:=d435">
        <xacro:property name="prefix" value="${name + '_' if name else ''}"/>

        <link name="${prefix}link6">
            <inertial>
                <origin xyz="-0.000183807162235591 8.05033155577911E-05 0.0321436689908876"/>
                <mass value="0.657"/>
                <inertia ixx="0.00092934" ixy="0.00000034" ixz="-0.00000738" iyy="0.00071447" iyz="0.00000005"
                         izz="0.00039442"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find piper_description)/meshes/piper/link6.glb"/>
                </geometry>
            </visual>
            <xacro:if value="${collider == 'convex'}">
                <collision>
                    <geometry>
                        <mesh filename="file://$(find piper_description)/meshes/piper/link6.glb"/>
                    </geometry>
                </collision>
            </xacro:if>
            <xacro:if value="${collider == 'simple'}">
                <collision name="simple_link6_1">
                    <origin xyz="0 0 0.025" rpy="0 0 0"/>
                    <geometry>
                        <cylinder length="0.04" radius="0.03015"/>
                    </geometry>
                </collision>
                <collision name="simple_link6_2">
                    <origin xyz="0 0 0.06" rpy="0 ${PI/2} 0"/>
                    <geometry>
                        <box size="0.01 0.178 0.015"/>
                    </geometry>
                </collision>
            </xacro:if>
        </link>

        <joint name="${prefix}joint6" type="revolute">
            <origin xyz="0 -0.091 0" rpy="1.5708 0 0"/>
            <parent link="${parent_link}"/>
            <child link="${prefix}link6"/>
            <axis xyz="0 0 1"/>
            <limit lower="-2.0944" upper="2.0944" effort="100" velocity="3"/>
        </joint>

        <link name="${prefix}link7">
            <inertial>
                <origin xyz="0.00065123185041968 -0.0491929869131989 0.00972258769184025"/>
                <mass value="0.025"/>
                <inertia ixx="0.00007371" ixy="-0.00000113" ixz="0.00000021" iyy="0.00000781" iyz="-0.00001372"
                         izz="0.0000747"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find piper_description)/meshes/gripper/gripper.glb"/>
                </geometry>
            </visual>
            <xacro:if value="${collider == 'simple'}">
                <collision>
                    <geometry>
                        <mesh filename="file://$(find piper_description)/meshes/gripper/gripper.glb"/>
                    </geometry>
                </collision>
            </xacro:if>
            <xacro:if value="${collider == 'simple'}">
                <collision name="simple_link7">
                    <origin xyz="0 -0.0125 -0.03" rpy="${PI/2} 0 ${PI/2}"/>
                    <geometry>
                        <box size="0.0231 0.07 0.037"/>
                    </geometry>
                </collision>
            </xacro:if>
        </link>

        <joint name="${prefix}gripper_joint" type="prismatic">
            <origin xyz="0 0 0.1358"/>
            <parent link="${prefix}link6"/>
            <child link="${prefix}link7"/>
            <axis xyz="0 -1 0"/>
            <limit lower="0" upper="0.035" effort="10" velocity="1"/>
        </joint>

        <link name="${prefix}link8">
            <inertial>
                <origin xyz="0.000651231850419722 -0.0491929869131991 0.00972258769184024"/>
                <mass value="0.025"/>
                <inertia ixx="0.00007371" ixy="-0.00000113" ixz="0.00000021" iyy="0.00000781" iyz="-0.00001372"
                         izz="0.0000747"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find piper_description)/meshes/gripper/gripper.glb" scale="1 -1 1"/>
                </geometry>
            </visual>
            <xacro:if value="${collider == 'convex'}">
                <collision>
                    <geometry>
                        <mesh filename="file://$(find piper_description)/meshes/gripper/gripper.glb" scale="1 -1 1"/>
                    </geometry>
                </collision>
            </xacro:if>
            <xacro:if value="${collider == 'simple'}">
                <collision name="simple_link8">
                    <origin xyz="0 0.0125 -0.03" rpy="${PI/2} 0 ${PI/2}"/>
                    <geometry>
                        <box size="0.0231 0.07 0.037"/>
                    </geometry>
                </collision>
            </xacro:if>
        </link>

        <joint name="${prefix}joint8" type="prismatic">
            <origin xyz="0 0 0.1358"/>
            <parent link="${prefix}link6"/>
            <child link="${prefix}link8"/>
            <mimic joint="${prefix}gripper_joint" multiplier="1" offset="0"/>
            <axis xyz="0 1 0"/>
            <limit lower="0" upper="0.035" effort="10" velocity="1"/>
        </joint>

        <link name="${prefix}gripper_center"/>
        <joint name="${prefix}gripper_center_fixed" type="fixed">
            <parent link="${prefix}link6"/>
            <child link="${prefix}gripper_center"/>
            <origin xyz="0 0 0.1358" rpy="0 -1.57 0"/>
        </joint>

        <xacro:piper_camera prefix="${prefix}" parent_link="${prefix}link6" camera="${camera}" collider="${collider}" arm_type="piper"/>
    </xacro:macro>
</robot>