<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find piper_description)/xacro/components/camera.xacro"/>
    <xacro:macro name="piper_gripper_l" params="prefix parent_link collider:=simple camera:=d435">
        <link name="${prefix}link6">
            <inertial>
                <origin xyz="0 -3.47e-06 -0.00315" rpy="0 0 0"/>
                <mass value="0.0056"/>
                <inertia ixx="5.13e-07" ixy="0" ixz="0" iyy="5.13e-07" iyz="0" izz="9.81e-07"/>
            </inertial>
            <visual>
                <origin xyz="0.008 -0.002 0.064" rpy="-1.57 0 1.57"/>
                <geometry>
                    <mesh filename="file://$(find piper_description)/meshes/gripper/gripper_base_100_v3.glb"/>
                </geometry>
            </visual>
            <xacro:if value="${collider == 'convex'}">
                <collision>
                    <origin xyz="0.008 -0.002 0.064" rpy="-1.57 0 1.57"/>
                    <geometry>
                        <mesh filename="file://$(find piper_description)/meshes/gripper/gripper_base_100_v3.glb"/>
                    </geometry>
                </collision>
            </xacro:if>
        </link>

        <joint name="${prefix}joint6" type="revolute">
            <origin xyz="0 -0.091 0" rpy="1.5708 0 0"/>
            <parent link="${parent_link}"/>
            <child link="${prefix}link6"/>
            <axis xyz="0 0 1"/>
            <limit lower="-3.14" upper="3.14" effort="100" velocity="3"/>
        </joint>

        <link name="${prefix}link7">
            <visual>
                <geometry>
                    <mesh filename="file://$(find piper_description)/meshes/gripper/link7.glb"/>
                </geometry>
            </visual>
            <xacro:if value="${collider == 'convex'}">
                <collision>
                    <geometry>
                        <mesh filename="file://$(find piper_description)/meshes/gripper/link7.glb"/>
                    </geometry>
                </collision>
            </xacro:if>
        </link>
        <joint name="${prefix}joint7" type="prismatic">
            <origin xyz="0 0 0.13503" rpy="1.5708 0 0"/>
            <parent link="${prefix}link6"/>
            <child link="${prefix}link7"/>
            <axis xyz="0 0 -1"/>
            <limit lower="0" upper="0.05" effort="100" velocity="1"/>
        </joint>

        <link name="${prefix}link8">
            <visual>
                <geometry>
                    <mesh filename="file://$(find piper_description)/meshes/gripper/link8.glb"/>
                </geometry>
            </visual>
            <xacro:if value="${collider == 'convex'}">
                <collision>
                    <geometry>
                        <mesh filename="file://$(find piper_description)/meshes/gripper/link8.glb"/>
                    </geometry>
                </collision>
            </xacro:if>
        </link>
        <joint name="${prefix}joint8" type="prismatic">
            <origin xyz="0 0 0.13503" rpy="-1.5708 0 0"/>
            <parent link="${prefix}link6"/>
            <child link="${prefix}link8"/>
            <axis xyz="0 0 1"/>
            <limit lower="-0.05" upper="0" effort="100" velocity="1"/>
            <mimic joint="${prefix}joint7" multiplier="-1" offset="0"/>
        </joint>

        <link name="${prefix}gripper_center"/>
        <joint name="${prefix}gripper_center_fixed" type="fixed">
            <parent link="${prefix}link6"/>
            <child link="${prefix}gripper_center"/>
            <origin xyz="0 0 0.13503" rpy="0 -1.5708 0"/>
        </joint>

        <xacro:piper_camera prefix="${prefix}" parent_link="${prefix}link6" camera="${camera}" collider="${collider}" arm_type="piper_l"/>

    </xacro:macro>
</robot>
