<?xml version="1.0"?>
<robot name="piper_system" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="ros2_control_hardware_type" default="mock_components" />
  <xacro:arg name="gazebo" default="false" />
  <xacro:arg name="type" default="piper" />
  <xacro:arg name="collider" default="convex" />

  <link name="world"/>
  <joint name="world_fixed" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
  </joint>

  <xacro:include filename="$(find piper_description)/xacro/robot.xacro"/>

  <xacro:include filename="$(find piper_description)/xacro/ros2_control/interfaces.xacro"/>

  <ros2_control name="piper_system" type="system">
    <hardware>
      <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'gz'}">
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </xacro:if>
      <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'mock_components'}">
        <plugin>mock_components/GenericSystem</plugin>
      </xacro:if>
      <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'isaac'}">
        <plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
        <param name="joint_commands_topic">/isaac/joint_command</param>
        <param name="joint_states_topic">/isaac/joint_states</param>
      </xacro:if>
      <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'real'}">
      </xacro:if>
    </hardware>

    <xacro:piper_interfaces name="" type="$(arg type)"/>
  </ros2_control>

  <xacro:if value="$(arg gazebo)">
    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <xacro:if value="${'$(arg type)' == 'l'}">
          <parameters>$(find piper_description)/config/ros2_control/piper_l_controllers.yaml</parameters>
        </xacro:if>
        <xacro:if value="${'$(arg type)' == 'x'}">
          <parameters>$(find piper_description)/config/ros2_control/piper_x_controllers.yaml</parameters>
        </xacro:if>
        <xacro:if value="${'$(arg type)' == 'piper'}">
          <parameters>$(find piper_description)/config/ros2_control/ros2_controllers.yaml</parameters>
        </xacro:if>
      </plugin>
    </gazebo>
  </xacro:if>

</robot>