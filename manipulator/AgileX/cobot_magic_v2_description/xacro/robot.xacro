<?xml version="1.0"?>
<robot name="Cobot Magic V2" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- topology:
       full (default) = Tracer 底盘 + 固定躯干 + 双臂（全身 / 真机 / 可视化）
       dual           = 仅双臂，根在 arm_base（demo OCS2 规划；arm_base ≡ body_Link）
       全身 Pinocchio / WBC 关节序须为：left×6 | right×6（无升降、无头） -->
  <xacro:arg name="topology" default="full"/>
  <xacro:arg name="chassis" default="tracer_v2"/>
  <xacro:arg name="arms" default="piper"/>
  <xacro:arg name="type" default=""/>
  <xacro:arg name="camera" default=""/>
  <xacro:arg name="enable_wheel_joints" default="false"/>
  <xacro:arg name="eef_fixed_joints" default="false"/>
  <xacro:arg name="isaac" default="false"/>

  <xacro:property name="topology_arg" value="$(arg topology)"/>
  <xacro:property name="chassis_arg" value="$(arg chassis)"/>
  <xacro:property name="arms_arg" value="$(arg arms)"/>
  <xacro:property name="type_arg" value="$(arg type)"/>
  <xacro:property name="camera_arg" value="$(arg camera)"/>
  <xacro:property name="ee_type" value="${type_arg if type_arg else 'gripper'}"/>
  <xacro:property name="camera_key" value="${camera_arg if camera_arg != '' else ('true' if (arms_arg == 'piper' and ee_type == 'gripper') else 'none')}"/>
  <xacro:property name="left_arm_xyz" value="0.23875 0.3 0.607"/>
  <xacro:property name="right_arm_xyz" value="0.23875 -0.3 0.607"/>

  <xacro:if value="${arms_arg == 'piper'}">
    <xacro:include filename="$(find piper_description)/xacro/Piper.xacro"/>
  </xacro:if>
  <xacro:if value="${arms_arg == 'h'}">
    <xacro:include filename="$(find piper_description)/xacro/PiperH.xacro"/>
  </xacro:if>
  <xacro:if value="${arms_arg == 'l'}">
    <xacro:include filename="$(find piper_description)/xacro/PiperL.xacro"/>
  </xacro:if>
  <xacro:if value="${arms_arg == 'x'}">
    <xacro:include filename="$(find piper_description)/xacro/PiperX.xacro"/>
  </xacro:if>

  <xacro:include filename="$(find piper_description)/xacro/eefs.xacro"/>
  <xacro:if value="${ee_type == 'revo1'}">
    <xacro:include filename="$(find brainco_description)/xacro/revo1.xacro"/>
  </xacro:if>
  <xacro:if value="${ee_type == 'revo2'}">
    <xacro:include filename="$(find brainco_description)/xacro/revo2.xacro"/>
  </xacro:if>

  <xacro:macro name="CobotMagicV2Arm" params="name">
    <xacro:if value="${arms_arg == 'piper'}">
      <xacro:Piper name="${name}"/>
    </xacro:if>
    <xacro:if value="${arms_arg == 'h'}">
      <xacro:PiperH name="${name}"/>
    </xacro:if>
    <xacro:if value="${arms_arg == 'l'}">
      <xacro:PiperL name="${name}"/>
    </xacro:if>
    <xacro:if value="${arms_arg == 'x'}">
      <xacro:PiperX name="${name}"/>
    </xacro:if>
  </xacro:macro>

  <xacro:macro name="CobotMagicV2ArmsAndEefs">
    <xacro:CobotMagicV2Arm name="left"/>
    <xacro:PiperEndEffectors
        name="left"
        type="${ee_type}"
        camera_type="${camera_key}"
        arms="${arms_arg}"
        direction="1"
        fixed_joints="$(arg eef_fixed_joints)"/>
    <xacro:CobotMagicV2Arm name="right"/>
    <xacro:PiperEndEffectors
        name="right"
        type="${ee_type}"
        camera_type="${camera_key}"
        arms="${arms_arg}"
        direction="-1"
        fixed_joints="$(arg eef_fixed_joints)"/>

    <joint name="arm_left_fixed" type="fixed">
      <parent link="arm_base"/>
      <child link="left_base_link"/>
      <origin xyz="${left_arm_xyz}"/>
    </joint>
    <joint name="arm_right_fixed" type="fixed">
      <parent link="arm_base"/>
      <child link="right_base_link"/>
      <origin xyz="${right_arm_xyz}"/>
    </joint>
  </xacro:macro>

  <!-- ===== dual：仅双臂（demo 规划，根 = arm_base ≡ body_Link） ===== -->
  <xacro:if value="${topology_arg == 'dual'}">
    <link name="arm_base"/>
    <link name="body_link"/>
    <joint name="arm_base_body" type="fixed">
      <parent link="arm_base"/>
      <child link="body_link"/>
      <origin xyz="0 0 0"/>
    </joint>

    <xacro:CobotMagicV2ArmsAndEefs/>
  </xacro:if>

  <!-- ===== full：整机（底盘 → 固定躯干 → 双臂） ===== -->
  <xacro:unless value="${topology_arg == 'dual'}">
    <xacro:if value="${chassis_arg == 'tracer'}">
      <xacro:include filename="$(find cobot_magic_v2_description)/xacro/base/tracer.xacro"/>
      <xacro:Tracer enable_wheel_joints="$(arg enable_wheel_joints)"/>
    </xacro:if>
    <xacro:if value="${chassis_arg == 'tracer_v2'}">
      <xacro:include filename="$(find cobot_magic_v2_description)/xacro/base/tracer_v2.xacro"/>
      <xacro:TracerV2 enable_wheel_joints="$(arg enable_wheel_joints)"/>
    </xacro:if>
    <xacro:include filename="$(find cobot_magic_v2_description)/xacro/body/v2.xacro"/>
    <xacro:Body parent="base_footprint" isaac="$(arg isaac)"/>

    <link name="arm_base"/>
    <joint name="arm_base_joint" type="fixed">
      <parent link="body_Link"/>
      <child link="arm_base"/>
      <origin xyz="0 0 0"/>
    </joint>

    <xacro:CobotMagicV2ArmsAndEefs/>
  </xacro:unless>
</robot>
