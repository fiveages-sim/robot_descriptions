<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
	<xacro:macro name="TracerV2" params="enable_wheel_joints:=false">
	<link name="base_footprint"/>
	<xacro:property name="PI" value="3.1415926535897931"/>
	<xacro:property name="wheel_joint_type" value="fixed"/>
	<xacro:if value="${enable_wheel_joints}">
		<xacro:property name="wheel_joint_type" value="continuous"/>
	</xacro:if>

	<joint name="base_joint" type="fixed">
		<origin xyz="0 0 0.15"/>
		<parent link="base_footprint"/>
		<child link="base_link"/>
		<axis/>
	</joint>

	<link name="base_link">
		<inertial>
			<origin xyz="-0.037979422359657 -0.00314478249004299 -0.0259198905321653"/>
			<mass value="2.4239552885625"/>
			<inertia
					ixx="0.0691541872284658"
					ixy="0.000423483205221006"
					ixz="-0.000201466160013829"
					iyy="0.0588857794520233"
					iyz="0.000250049528136794"
					izz="0.125132015686105"/>
		</inertial>
		<visual>
			<geometry>
				<mesh filename="file://$(find cobot_magic_v2_description)/meshes/tracer_v2/base.glb"/>
			</geometry>
		</visual>
		<collision>
			<geometry>
				<mesh filename="file://$(find cobot_magic_v2_description)/meshes/tracer_v2/base.glb"/>
			</geometry>
		</collision>
	</link>

	<link name="right_link">
		<inertial>
			<origin xyz="4.7341E-15 1.5543E-15 -0.005"/>
			<mass value="0.14836"/>
			<inertia
					ixx="0.00013099"
					ixy="3.4159E-20"
					ixz="-4.7556E-20"
					iyy="0.00013099"
					iyz="1.0561E-21"
					izz="0.00023781"/>
		</inertial>
		<visual>
			<geometry>
				<mesh filename="file://$(find cobot_magic_v2_description)/meshes/tracer_v2/drive_wheel.glb"/>
			</geometry>
		</visual>
		<collision>
			<origin xyz="0 0 -0.0048"/>
			<geometry>
				<cylinder radius="0.0628" length="0.04"/>
			</geometry>
		</collision>
	</link>

	<joint name="right_joint" type="${wheel_joint_type}">
		<origin xyz="-0.018818 -0.2537 -0.0905" rpy="-1.5708 0 0"/>
		<parent link="base_link"/>
		<child link="right_link"/>
		<axis xyz="0 0 1"/>
	</joint>

	<link name="left_Link">
		<inertial>
			<origin xyz="-8.2507E-18 0 -0.005"/>
			<mass value="0.14836"/>
			<inertia
					ixx="0.00013099"
					ixy="6.6936E-21"
					ixz="1.4318E-19"
					iyy="0.00013099"
					iyz="-5.3812E-21"
					izz="0.00023781"/>
		</inertial>
		<visual>
			<geometry>
				<mesh filename="file://$(find cobot_magic_v2_description)/meshes/tracer_v2/drive_wheel.glb"/>
			</geometry>
		</visual>
		<collision>
			<origin xyz="0 0 -0.0048" />
			<geometry>
				<cylinder radius="0.0628" length="0.04"/>
			</geometry>
		</collision>
	</link>

	<joint name="left_joint" type="${wheel_joint_type}">
		<origin xyz="-0.018818 0.2537 -0.0905" rpy="1.5708 0 0"/>
		<parent link="base_link"/>
		<child link="left_Link"/>
		<axis xyz="0 0 -1"/>
	</joint>

	<link name="right_front_link">
		<inertial>
			<origin xyz="-0.013166 2.7397E-05 0.04181"/>
			<mass value="0.2864"/>
			<inertia
					ixx="0.00029479"
					ixy="5.5901E-08"
					ixz="5.9543E-05"
					iyy="0.00032696"
					iyz="-1.5316E-07"
					izz="0.00020885"/>
		</inertial>
		<visual>
			<geometry>
				<mesh filename="file://$(find cobot_magic_v2_description)/meshes/tracer_v2/support_wheel.glb"/>
			</geometry>
		</visual>
	</link>

	<joint name="right_front_joint" type="${wheel_joint_type}">
		<origin xyz="0.23918 -0.1977 -0.058"/>
		<parent link="base_link"/>
		<child link="right_front_link"/>
		<axis xyz="0 0 1"/>
	</joint>

	<link name="right_front_wheel">
		<collision>
			<geometry>
				<cylinder radius="0.0375" length="0.048"/>
			</geometry>
		</collision>
	</link>

	<joint name="right_front_wheel_joint" type="${wheel_joint_type}">
		<origin xyz="-0.02 0 -0.0575" rpy="${PI/2} 0 0"/>
		<parent link="right_front_link"/>
		<child link="right_front_wheel"/>
		<axis xyz="0 0 1"/>
	</joint>

	<link name="right_rear_link">
		<inertial>
			<origin xyz="-0.013166 2.7397E-05 0.04181"/>
			<mass value="0.2864"/>
			<inertia
					ixx="0.00029479"
					ixy="5.5901E-08"
					ixz="5.9543E-05"
					iyy="0.00032696"
					iyz="-1.5316E-07"
					izz="0.00020885"/>
		</inertial>
		<visual>
			<geometry>
				<mesh filename="file://$(find cobot_magic_v2_description)/meshes/tracer_v2/support_wheel.glb"/>
			</geometry>
		</visual>
	</link>

	<joint name="right_rear_joint" type="${wheel_joint_type}">
		<origin xyz="-0.27082 -0.183 -0.058"/>
		<parent link="base_link"/>
		<child link="right_rear_link"/>
		<axis xyz="0 0 1"/>
	</joint>

	<link name="right_rear_wheel">
		<collision>
			<geometry>
				<cylinder radius="0.0375" length="0.048"/>
			</geometry>
		</collision>
	</link>

	<joint name="right_rear_wheel_joint" type="${wheel_joint_type}">
		<origin xyz="-0.02 0 -0.0575" rpy="${PI/2} 0 0"/>
		<parent link="right_rear_link"/>
		<child link="right_rear_wheel"/>
		<axis xyz="0 0 1"/>
	</joint>

	<link name="left_front_link">
		<inertial>
			<origin xyz="-0.013166 -2.7397E-05 -0.04181"/>
			<mass value="0.2864"/>
			<inertia
					ixx="0.00029479"
					ixy="-5.5901E-08"
					ixz="-5.9543E-05"
					iyy="0.00032696"
					iyz="-1.5316E-07"
					izz="0.00020885"/>
		</inertial>
		<visual>
			<geometry>
				<mesh filename="file://$(find cobot_magic_v2_description)/meshes/tracer_v2/support_wheel.glb"/>
			</geometry>
		</visual>
	</link>

	<joint name="left_front_joint" type="${wheel_joint_type}">
		<origin xyz="0.23918 0.1977 -0.058"/>
		<parent link="base_link"/>
		<child link="left_front_link"/>
		<axis xyz="0 0 1"/>
	</joint>

	<link name="left_front_wheel">
		<collision>
			<geometry>
				<cylinder radius="0.0375" length="0.048"/>
			</geometry>
		</collision>
	</link>

	<joint name="left_front_wheel_joint" type="${wheel_joint_type}">
		<origin xyz="-0.02 0 -0.0575" rpy="${PI/2} 0 0"/>
		<parent link="left_front_link"/>
		<child link="left_front_wheel"/>
		<axis xyz="0 0 1"/>
	</joint>

	<link name="left_rear_link">
		<inertial>
			<mass value="0.2864"/>
			<inertia
					ixx="0.00029479"
					ixy="-5.5901E-08"
					ixz="-5.9543E-05"
					iyy="0.00032696"
					iyz="-1.5316E-07"
					izz="0.00020885"/>
		</inertial>
		<visual>
			<geometry>
				<mesh filename="file://$(find cobot_magic_v2_description)/meshes/tracer_v2/support_wheel.glb"/>
			</geometry>
		</visual>
	</link>

	<joint name="left_rear_joint" type="${wheel_joint_type}">
		<origin xyz="-0.27077 0.18305 -0.058"/>
		<parent link="base_link"/>
		<child link="left_rear_link"/>
		<axis xyz="0 0 1"/>
	</joint>

	<link name="left_rear_wheel">
		<collision>
			<geometry>
				<cylinder radius="0.0375" length="0.048"/>
			</geometry>
		</collision>
	</link>

	<joint name="left_rear_wheel_joint" type="${wheel_joint_type}">
		<origin xyz="-0.02 0 -0.0575" rpy="${PI/2} 0 0"/>
		<parent link="left_rear_link"/>
		<child link="left_rear_wheel"/>
		<axis xyz="0 0 1"/>
	</joint>
	</xacro:macro>
</robot>