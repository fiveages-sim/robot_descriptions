<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="base.xacro" />

  <!-- isaac:=true hides sensor_models camera meshes (Isaac asset import). -->
  <xacro:macro name="Tron2BDachBody" params="isaac:=false">
    <link name="base_link">
      <inertial>
        <origin xyz="0.00241 -0.00022 0.11116" />
        <mass value="13.4" />
        <inertia ixx="0.11544842" ixy="-6.32e-06" ixz="0.00636327" iyy="0.13779136" iyz="-2.76e-05" izz="0.10571445" />
      </inertial>
      <visual>
        <geometry>
          <mesh filename="file://$(find tron2b_dach_description)/meshes/body/base.glb" />
        </geometry>
      </visual>
      <collision>
        <origin xyz="0.0089611 0.0000767 0.1218166" />
        <geometry>
          <box size="0.3061613 0.2184998 0.2800915" />
        </geometry>
      </collision>
    </link>
    <link name="base_imu">
      <inertial>
        <mass value="0.001" />
        <inertia ixx="1e-08" ixy="0.0" ixz="0.0" iyy="1e-08" iyz="0.0" izz="1e-08" />
      </inertial>
    </link>
    <joint name="base_imu_Joint" type="fixed">
      <parent link="base_link" />
      <child link="base_imu" />
    </joint>
    <xacro:Tron2BDachBase />
    <!-- ROS optical (+Z forward, +X right, +Y down). Joint = former d435_Link
         (xyz 0.0968 0.01759 -0.00409, rpy 0 2.7227136331 0) × optical (rpy -π/2 0 -π/2).
         Visual origin restores the old base_link mesh pose into this optical frame
         (d435.glb was never optical-aligned on this robot). -->
    <link name="body_camera">
      <inertial>
        <mass value="0.001" />
        <inertia ixx="1e-07" ixy="0.0" ixz="0.0" iyy="1e-07" iyz="0.0" izz="1e-07" />
      </inertial>
      <xacro:unless value="${isaac}">
        <visual>
          <origin xyz="0.01747339 -0.00403439 -0.00030151" rpy="1.58707864278 0 0" />
          <geometry>
            <mesh filename="file://$(find sensor_models)/meshes/realsense/d435.glb" />
          </geometry>
        </visual>
      </xacro:unless>
    </link>
    <joint name="body_camera_joint" type="fixed">
      <origin xyz="0.0968 0.01759 -0.00409" rpy="${19*pi/30} 0 ${-pi/2}" />
      <parent link="base_link" />
      <child link="body_camera" />
    </joint>
  </xacro:macro>
</robot>