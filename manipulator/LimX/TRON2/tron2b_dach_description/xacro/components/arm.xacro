<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Shared left/right arm (Taku/G1 style): name + direction:=±1 → prefix="${name}_". -->
  <xacro:macro name="Tron2BDachArm" params="name parent direction:=1">
    <xacro:property name="prefix" value="${name + '_' if name else ''}" />

    <link name="${prefix}proximal_pitch_Link">
      <inertial>
        <origin xyz="0.0033 ${0.06714 * direction} -0.00603" />
        <mass value="2.05" />
        <inertia ixx="0.00389778" ixy="${-0.00013725 * direction}" ixz="4.62e-05"
                 iyy="0.00320014" iyz="${5.272e-05 * direction}" izz="0.00357523" />
      </inertial>
      <visual>
        <geometry>
          <mesh filename="file://$(find tron2b_dach_description)/meshes/arm/proximal_pitch.glb" scale="1 ${direction} 1" />
        </geometry>
      </visual>
      <collision>
        <origin xyz="0.0006538 ${0.0608031 * direction} -0.0061907" rpy="${pi/2} 0 0" />
        <geometry>
          <cylinder radius="0.0678046" length="0.1355752" />
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}proximal_pitch_Joint" type="revolute">
      <origin xyz="-0.00044 ${0.09497 * direction} 0.05446" />
      <parent link="${parent}" />
      <child link="${prefix}proximal_pitch_Link" />
      <axis xyz="0.0 0.9961947268929313 ${-0.0871554135479712 * direction}" />
      <limit lower="${-pi}" upper="${149*pi/180}" effort="200.0" velocity="17.0693" />
    </joint>

    <link name="${prefix}proximal_roll_Link">
      <inertial>
        <origin xyz="0.03623 ${0.00056 * direction} -0.08095" />
        <mass value="1.75" />
        <inertia ixx="0.00438693" ixy="${-1.167e-05 * direction}" ixz="-5.518e-05"
                 iyy="0.00508428" iyz="${-3.078e-05 * direction}" izz="0.00295723" />
      </inertial>
      <visual>
        <geometry>
          <mesh filename="file://$(find tron2b_dach_description)/meshes/arm/proximal_roll.glb" scale="1 ${direction} 1" />
        </geometry>
      </visual>
      <collision>
        <origin xyz="0.0352017 ${0.0005560 * direction} -0.0372384" />
        <geometry>
          <cylinder radius="0.0670365" length="0.1607246" />
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}proximal_roll_Joint" type="revolute">
      <origin xyz="-0.0352 ${0.07261 * direction} -0.00635" />
      <parent link="${prefix}proximal_pitch_Link" />
      <child link="${prefix}proximal_roll_Link" />
      <axis xyz="1.0 0.0 0.0" />
      <limit lower="${-pi/12 if direction == 1 else -61*pi/60}"
             upper="${61*pi/60 if direction == 1 else pi/12}"
             effort="200.0" velocity="17.0693" />
    </joint>

    <link name="${prefix}proximal_yaw_Link">
      <inertial>
        <origin xyz="-0.00376 ${0.00165 * direction} -0.09017" />
        <mass value="1.21" />
        <inertia ixx="0.01030809" ixy="${6.59e-06 * direction}" ixz="-2.892e-05"
                 iyy="0.00994508" iyz="${0.000235 * direction}" izz="0.00236156" />
      </inertial>
      <visual>
        <geometry>
          <mesh filename="file://$(find tron2b_dach_description)/meshes/arm/proximal_yaw.glb" scale="1 ${direction} 1" />
        </geometry>
      </visual>
      <collision>
        <origin xyz="0.0000062 ${0.0000144 * direction} -0.0051494" rpy="${pi/2} 0 0" />
        <geometry>
          <cylinder radius="0.0578355" length="0.1022271" />
        </geometry>
      </collision>
      <collision>
        <origin xyz="0 0 -0.1155" />
        <geometry>
          <cylinder radius="0.055" length="0.215" />
        </geometry>
      </collision>
      <collision>
        <origin xyz="0.004 0 -0.2152" rpy="${pi/2} 0 0" />
        <geometry>
          <cylinder radius="0.05" length="0.106" />
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}proximal_yaw_Joint" type="revolute">
      <origin xyz="0.0352 0.0 -0.1348" />
      <parent link="${prefix}proximal_roll_Link" />
      <child link="${prefix}proximal_yaw_Link" />
      <axis xyz="0.0 0.0 1.0" />
      <limit lower="${-7*pi/6 if direction == 1 else -17*pi/36}"
             upper="${17*pi/36 if direction == 1 else 7*pi/6}"
             effort="70.0" velocity="16.3363" />
    </joint>

    <link name="${prefix}elbow_Link">
      <inertial>
        <origin xyz="-0.00057 ${-0.03166 * direction} -0.00438" />
        <mass value="1.05" />
        <inertia ixx="0.00104316" ixy="${1.61e-06 * direction}" ixz="-2.728e-05"
                 iyy="0.00133093" iyz="${3.19e-06 * direction}" izz="0.0009075" />
      </inertial>
      <visual>
        <geometry>
          <mesh filename="file://$(find tron2b_dach_description)/meshes/arm/elbow.glb" scale="1 ${direction} 1" />
        </geometry>
      </visual>
      <collision>
        <origin xyz="-0.0000163 ${-0.0347779 * direction} -0.0102690" />
        <geometry>
          <cylinder radius="0.0542627" length="0.1190621" />
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}elbow_Joint" type="revolute">
      <origin xyz="0.004 ${0.0348 * direction} -0.2152" />
      <parent link="${prefix}proximal_yaw_Link" />
      <child link="${prefix}elbow_Link" />
      <axis xyz="0.0 1.0 0.0" />
      <limit lower="${-5*pi/6}" upper="0" effort="70.0" velocity="16.3363" />
    </joint>

    <link name="${prefix}wrist_yaw_Link">
      <inertial>
        <origin xyz="-0.00013 ${0.00206 * direction} -0.06635" />
        <mass value="1.15" />
        <inertia ixx="0.00312783" ixy="${-1.87e-06 * direction}" ixz="-5.07e-06"
                 iyy="0.00297221" iyz="${6.903e-05 * direction}" izz="0.00104146" />
      </inertial>
      <visual>
        <geometry>
          <mesh filename="file://$(find tron2b_dach_description)/meshes/arm/wrist_yaw.glb" />
        </geometry>
        <xacro:if value="${direction == -1}">
          <origin rpy="0 0 ${pi}" />
        </xacro:if>
      </visual>
      <collision>
        <origin xyz="${0.0000042 * direction} 0.0 -0.0914912" />
        <geometry>
          <cylinder radius="0.0492449" length="0.2057825" />
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}wrist_yaw_Joint" type="revolute">
      <origin xyz="-0.00367 ${-0.03481 * direction} -0.0685" />
      <parent link="${prefix}elbow_Link" />
      <child link="${prefix}wrist_yaw_Link" />
      <axis xyz="0.0 0.0 1.0" />
      <limit lower="${-5*pi/9 if direction == 1 else -4*pi/9}"
             upper="${4*pi/9 if direction == 1 else 5*pi/9}"
             effort="15.0" velocity="14.4513" />
    </joint>

    <link name="${prefix}wrist_pitch_Link">
      <inertial>
        <origin xyz="0.00426 ${-0.0363 * direction} 0.00013" />
        <mass value="0.44" />
        <inertia ixx="0.00022755" ixy="${2.85e-06 * direction}" ixz="-2.38e-06"
                 iyy="0.00025709" iyz="${-3e-08 * direction}" izz="0.00025502" />
      </inertial>
      <visual>
        <geometry>
          <mesh filename="file://$(find tron2b_dach_description)/meshes/arm/wrist_pitch.glb" scale="1 ${direction} 1" />
        </geometry>
      </visual>
      <collision>
        <origin xyz="0.0023000 ${-0.0346000 * direction} -0.0000000" rpy="${pi/2} 0 0" />
        <geometry>
          <cylinder radius="0.0439288" length="0.0770000" />
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}wrist_pitch_Joint" type="revolute">
      <origin xyz="0.0 ${0.0367 * direction} -0.1743" />
      <parent link="${prefix}wrist_yaw_Link" />
      <child link="${prefix}wrist_pitch_Link" />
      <axis xyz="0.0 1.0 0.0" />
      <limit lower="${-pi/4}" upper="${pi/4}" effort="15.0" velocity="14.4513" />
    </joint>

    <link name="${prefix}wrist_roll_Link">
      <inertial>
        <origin xyz="-0.02867 ${-0.00014 * direction} -0.04311" />
        <mass value="0.24" />
        <inertia ixx="0.00025857" ixy="${5e-07 * direction}" ixz="-8.01e-06"
                 iyy="0.00036517" iyz="${-4.6e-07 * direction}" izz="0.00026664" />
      </inertial>
      <visual>
        <geometry>
          <mesh filename="file://$(find tron2b_dach_description)/meshes/arm/wrist_roll.glb" />
        </geometry>
      </visual>
      <collision>
        <origin xyz="-0.0317026 0.0000000 -0.0646000" rpy="0 ${pi/2} 0" />
        <geometry>
          <cylinder radius="0.0346824" length="0.0802985" />
        </geometry>
      </collision>
      <collision>
        <origin xyz="-0.0317 0 -0.0195" />
        <geometry>
          <box size="0.084 0.068 0.097" />
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}wrist_roll_Joint" type="revolute">
      <origin xyz="0.0317 ${-0.0367 * direction} 0.0" />
      <parent link="${prefix}wrist_pitch_Link" />
      <child link="${prefix}wrist_roll_Link" />
      <axis xyz="1.0 0.0 0.0" />
      <limit lower="${-pi/2}" upper="${pi/2}" effort="15.0" velocity="14.4513" />
    </joint>
  </xacro:macro>
</robot>
