<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="Tron2BDachGripper" params="side parent">
    <link name="grasper_base_${side}_Link">
      <inertial>
        <origin xyz="${'-3.3414980e-04 5.3895572e-05 -5.9247964e-02' if side == 'L' else '-3.3414980e-04 -5.3895554e-05 -5.9247964e-02'}" />
        <mass value="0.49169168" />
        <inertia ixx="7.7058390e-04" ixy="${'-7.3989581e-07' if side == 'L' else '7.4138413e-07'}" ixz="9.9598059e-07" iyy="6.8423130e-04" iyz="${'-1.8328860e-06' if side == 'L' else '1.8328861e-06'}" izz="3.2638770e-04" />
      </inertial>
      <visual>
        <geometry>
          <mesh filename="file://$(find tron2b_dach_description)/meshes/gripper/base.glb" />
        </geometry>
      </visual>
      <collision>
        <origin xyz="0.0000000 0.0000000 -0.0434500" />
        <geometry>
          <box size="0.0612001 0.0966027 0.1011000" />
        </geometry>
      </collision>
    </link>
    <joint name="grasper_base_${side}_Joint" type="fixed">
      <origin xyz="-0.0317 0 -0.0812" />
      <parent link="${parent}" />
      <child link="grasper_base_${side}_Link" />
    </joint>
    <link name="grasper_${side}_crank_left_Link">
      <inertial>
        <origin xyz="4.7600073e-06 -0.0055481701 -0.019012995" />
        <mass value="0.0028716751" />
        <inertia ixx="8.4974068e-07" ixy="-8.1619392e-11" ixz="-2.8305318e-10" iyy="1.0893102e-06" iyz="-2.2248284e-07" izz="3.9176962e-07" />
      </inertial>
      <visual>
        <geometry>
          <mesh filename="file://$(find tron2b_dach_description)/meshes/gripper/crank.glb" />
        </geometry>
      </visual>
    </link>
    <joint name="grasper_${side}_drive_Joint" type="revolute">
      <origin xyz="0 0.0275 -0.0689" />
      <parent link="grasper_base_${side}_Link" />
      <child link="grasper_${side}_crank_left_Link" />
      <axis xyz="1 0 0" />
      <limit lower="-0.09522" upper="0.77302" effort="2" velocity="10" />
    </joint>
    <link name="grasper_${side}_jaw_left_Link">
      <inertial>
        <origin xyz="1.392162e-07 -0.0012691085 -0.023147552" />
        <mass value="0.011059233" />
        <inertia ixx="3.8418984e-06" ixy="3.6462472e-12" ixz="-3.5054283e-11" iyy="4.2033876e-06" iyz="-5.2696422e-07" izz="1.006352e-06" />
      </inertial>
      <visual>
        <geometry>
          <mesh filename="file://$(find tron2b_dach_description)/meshes/gripper/jaw.glb" />
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="file://$(find tron2b_dach_description)/meshes/gripper/jaw.glb" />
        </geometry>
      </collision>
    </link>
    <joint name="grasper_${side}_tip_left_Joint" type="revolute">
      <origin xyz="0 -0.01401 -0.048" />
      <parent link="grasper_${side}_crank_left_Link" />
      <child link="grasper_${side}_jaw_left_Link" />
      <axis xyz="1 0 0" />
      <limit lower="-0.77302" upper="0.09522" effort="2" velocity="10" />
      <mimic joint="grasper_${side}_drive_Joint" multiplier="-1" offset="0" />
    </joint>
    <link name="grasper_${side}_bar_left_Link">
      <inertial>
        <origin xyz="-2.9205723e-07 -0.0062299561 -0.013666476" />
        <mass value="0.0036449843" />
        <inertia ixx="1.4160278e-06" ixy="-4.0833729e-12" ixz="2.3404541e-11" iyy="1.6580051e-06" iyz="-1.8301211e-07" izz="4.4120395e-07" />
      </inertial>
      <visual>
        <geometry>
          <mesh filename="file://$(find tron2b_dach_description)/meshes/gripper/bar.glb" />
        </geometry>
      </visual>
    </link>
    <joint name="grasper_${side}_bar_left_Joint" type="revolute">
      <origin xyz="0 0.04136 -0.0609" />
      <parent link="grasper_base_${side}_Link" />
      <child link="grasper_${side}_bar_left_Link" />
      <axis xyz="1 0 0" />
      <limit lower="-0.09522" upper="0.77302" effort="2" velocity="10" />
      <mimic joint="grasper_${side}_drive_Joint" multiplier="1" offset="0" />
    </joint>
    <link name="grasper_${side}_crank_right_Link">
      <inertial>
        <origin xyz="-4.8119616e-06 0.0055481697 -0.019012993" />
        <mass value="0.0028716752" />
        <inertia ixx="8.4974076e-07" ixy="-8.1479958e-11" ixz="2.8278323e-10" iyy="1.0893103e-06" iyz="2.2248286e-07" izz="3.9176964e-07" />
      </inertial>
      <visual>
        <origin rpy="0 0 3.141592653589793" />
        <geometry>
          <mesh filename="file://$(find tron2b_dach_description)/meshes/gripper/crank.glb" />
        </geometry>
      </visual>
    </link>
    <joint name="grasper_${side}_crank_right_Joint" type="revolute">
      <origin xyz="0 -0.0275 -0.0689" />
      <parent link="grasper_base_${side}_Link" />
      <child link="grasper_${side}_crank_right_Link" />
      <axis xyz="-1 0 0" />
      <limit lower="-0.09522" upper="0.77302" effort="2" velocity="10" />
      <mimic joint="grasper_${side}_drive_Joint" multiplier="1" offset="0" />
    </joint>
    <link name="grasper_${side}_jaw_right_Link">
      <inertial>
        <origin xyz="-2.2359754e-07 0.0012691084 -0.023147552" />
        <mass value="0.011059233" />
        <inertia ixx="3.8418985e-06" ixy="3.9560488e-12" ixz="3.3441013e-11" iyy="4.2033877e-06" iyz="5.2696424e-07" izz="1.006352e-06" />
      </inertial>
      <visual>
        <origin rpy="0 0 3.141592653589793" />
        <geometry>
          <mesh filename="file://$(find tron2b_dach_description)/meshes/gripper/jaw.glb" />
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 0 3.141592653589793" />
        <geometry>
          <mesh filename="file://$(find tron2b_dach_description)/meshes/gripper/jaw.glb" />
        </geometry>
      </collision>
    </link>
    <joint name="grasper_${side}_tip_right_Joint" type="revolute">
      <origin xyz="0 0.01401 -0.048" />
      <parent link="grasper_${side}_crank_right_Link" />
      <child link="grasper_${side}_jaw_right_Link" />
      <axis xyz="-1 0 0" />
      <limit lower="-0.77302" upper="0.09522" effort="2" velocity="10" />
      <mimic joint="grasper_${side}_drive_Joint" multiplier="-1" offset="0" />
    </joint>
    <link name="grasper_${side}_bar_right_Link">
      <inertial>
        <origin xyz="2.4766637e-07 0.0062299561 -0.013666476" />
        <mass value="0.0036449843" />
        <inertia ixx="1.4160279e-06" ixy="-3.9635664e-12" ixz="-2.3989416e-11" iyy="1.6580051e-06" iyz="1.8301211e-07" izz="4.4120396e-07" />
      </inertial>
      <visual>
        <origin rpy="0 0 3.141592653589793" />
        <geometry>
          <mesh filename="file://$(find tron2b_dach_description)/meshes/gripper/bar.glb" />
        </geometry>
      </visual>
    </link>
    <joint name="grasper_${side}_bar_right_Joint" type="revolute">
      <origin xyz="0 -0.04136 -0.0609" />
      <parent link="grasper_base_${side}_Link" />
      <child link="grasper_${side}_bar_right_Link" />
      <axis xyz="-1 0 0" />
      <limit lower="-0.09522" upper="0.77302" effort="2" velocity="10" />
      <mimic joint="grasper_${side}_drive_Joint" multiplier="1" offset="0" />
    </joint>
    <link name="grasper_${side}_nut_Link">
      <inertial>
        <origin xyz="-2.7416387e-08 -4.6963269e-12 -0.089912512" />
        <mass value="0.0029565354" />
        <inertia ixx="3.2809364e-07" ixy="2.710444e-12" ixz="4.8523164e-14" iyy="2.3847151e-07" iyz="-1.5187541e-16" izz="5.2186569e-07" />
      </inertial>
      <visual>
        <geometry>
          <mesh filename="file://$(find tron2b_dach_description)/meshes/gripper/nut.glb" />
        </geometry>
        <xacro:if value="${side == 'R'}">
          <origin rpy="0 0 3.141592653589793" />
        </xacro:if>
      </visual>
    </link>
    <joint name="grasper_${side}_nut_Joint" type="prismatic">
      <parent link="grasper_base_${side}_Link" />
      <child link="grasper_${side}_nut_Link" />
      <axis xyz="0 0 1" />
      <limit lower="-0.0019044" upper="0.0154604" effort="10" velocity="0.5" />
      <mimic joint="grasper_${side}_drive_Joint" multiplier="0.02" offset="0" />
    </joint>
    <link name="grasper_${side}_jaw_left_ref_Link">
      <inertial>
        <mass value="0.0001" />
        <inertia ixx="1e-08" ixy="0" ixz="0" iyy="1e-08" iyz="0" izz="1e-08" />
      </inertial>
    </link>
    <joint name="grasper_${side}_jaw_left_Joint" type="prismatic">
      <parent link="grasper_base_${side}_Link" />
      <child link="grasper_${side}_jaw_left_ref_Link" />
      <axis xyz="0 1 0" />
      <limit lower="-0.0045" upper="0.0375" effort="20" velocity="0.5" />
      <mimic joint="grasper_${side}_drive_Joint" multiplier="0.048992" offset="0" />
    </joint>
    <link name="grasper_${side}_jaw_right_ref_Link">
      <inertial>
        <mass value="0.0001" />
        <inertia ixx="1e-08" ixy="0" ixz="0" iyy="1e-08" iyz="0" izz="1e-08" />
      </inertial>
    </link>
    <joint name="grasper_${side}_jaw_right_Joint" type="prismatic">
      <parent link="grasper_base_${side}_Link" />
      <child link="grasper_${side}_jaw_right_ref_Link" />
      <axis xyz="0 -1 0" />
      <limit lower="-0.0045" upper="0.0375" effort="20" velocity="0.5" />
      <mimic joint="grasper_${side}_drive_Joint" multiplier="0.048992" offset="0" />
    </joint>
    <!-- The gripper base coincides with LimX's flange frame. -->
    <link name="${side}_ee_link"/>
    <joint name="${side}_ee_Joint" type="fixed">
      <parent link="grasper_base_${side}_Link"/>
      <child link="${side}_ee_link"/>
      <origin xyz="-0.0021 0.0 -0.1313"/>
    </joint>
  </xacro:macro>
</robot>