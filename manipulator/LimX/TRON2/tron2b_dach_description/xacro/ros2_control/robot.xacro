<?xml version="1.0"?>
<robot name="tron2b_dach" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="ros2_control_hardware_type" default="mock_components"/>
  <xacro:include filename="$(find tron2b_dach_description)/xacro/robot.xacro"/>
  <xacro:include filename="$(find robot_common_launch)/xacro/ros2_control/simulation_hardware.xacro"/>

  <xacro:include filename="interfaces.xacro"/>

  <ros2_control name="Tron2BDach" type="system">
    <hardware>
      <xacro:simulation_hardware_plugin hardware_type="$(arg ros2_control_hardware_type)"/>
    </hardware>
    <xacro:Tron2BDachArmInterfaces name="left"/>
    <xacro:Tron2BDachArmInterfaces name="right"/>
    <xacro:position_joint name="head_yaw_Joint"/>
    <xacro:position_joint name="head_pitch_Joint"/>
    <xacro:Tron2BDachGripperInterfaces name="left"/>
    <xacro:Tron2BDachGripperInterfaces name="right"/>
  </ros2_control>
</robot>
