<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="position_joint" params="name initial:=0.0">
    <joint name="${name}">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">${initial}</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="Tron2BDachArmInterfaces" params="name">
    <xacro:property name="prefix" value="${name + '_' if name else ''}"/>
    <xacro:position_joint name="${prefix}proximal_pitch_Joint"/>
    <xacro:position_joint name="${prefix}proximal_roll_Joint"/>
    <xacro:position_joint name="${prefix}proximal_yaw_Joint"/>
    <xacro:position_joint name="${prefix}elbow_Joint"/>
    <xacro:position_joint name="${prefix}wrist_yaw_Joint"/>
    <xacro:position_joint name="${prefix}wrist_pitch_Joint"/>
    <xacro:position_joint name="${prefix}wrist_roll_Joint"/>
  </xacro:macro>

  <xacro:macro name="Tron2BDachGripperInterfaces" params="name">
    <xacro:property name="prefix" value="${name + '_' if name else ''}"/>
    <xacro:position_joint name="${prefix}gripper_joint" initial="-0.09522"/>
    <!-- TopicBasedSystem expects one position per name in the command message.
         The Isaac articulation supplies mimic states through its own linkage. -->
    <xacro:unless value="${'$(arg ros2_control_hardware_type)' == 'isaac'}">
      <joint name="${prefix}grasper_tip_left_Joint">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="${prefix}grasper_bar_left_Joint">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="${prefix}grasper_crank_right_Joint">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="${prefix}grasper_tip_right_Joint">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="${prefix}grasper_bar_right_Joint">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="${prefix}grasper_nut_Joint">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="${prefix}grasper_jaw_left_Joint">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="${prefix}grasper_jaw_right_Joint">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </xacro:unless>
  </xacro:macro>
</robot>
