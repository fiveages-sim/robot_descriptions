; TRON2B_DACH — full-body WBC (ocs2_wbc_controller / full_body.launch.py)
; =====================================================================
; Fixed stand (no mobile chassis DOFs in MPC). No waist/lift — torso is rigid.
; Identity arm_base mounts both arms so Pinocchio 4 orders left|right|head
; (avoids head-first under left_/right_ siblings, where headInputStart 0 is
; treated as unset). State / input (16): [left×7 | right×7 | head×2].
; headInputStart 14. No waist: HM_DUAL_BODY_FREE + HEAD_GAZE
; (manipulatorModelType 0 still forces baseLocked).

model_information
{
    manipulatorModelType    0

    baseFrame               "base_link"
    eeFrame                 "left_ee_link"
    eeFrame1                "right_ee_link"
    bodyFrame               "base_link"
    headFrame               "head_pitch_Link"

    ; Planning URDF freezes grippers via eef_fixed_joints:=true; keep empty for xacro path.
    removeJoints
    {
    }
}

model_settings
{
    usePreComputation       true
    recompileLibraries      true
}

initialState
{
    arm
    {
        (0,0)   0.0     ; left_proximal_pitch
        (1,0)   0.0
        (2,0)   0.0
        (3,0)   0.0
        (4,0)   0.0
        (5,0)   0.0
        (6,0)   0.0
        (7,0)   0.0     ; right_proximal_pitch
        (8,0)   0.0
        (9,0)   0.0
        (10,0)  0.0
        (11,0)  0.0
        (12,0)  0.0
        (13,0)  0.0
        (14,0)  0.0     ; head_yaw
        (15,0)  0.0     ; head_pitch
    }
}

initialModeSchedule
{
    eventTimes
    {
    }

    ; No waist DOFs → body FREE (cobot_magic). HEAD_GAZE: D455 looks at hands midpoint.
    modeSequence
    {
        [0]
        {
            bodyMode "HM_DUAL_BODY_FREE"
            headMode "HEAD_GAZE"
        }
    }
}

ddp
{
    algorithm                       SLQ
    nThreads                        5
    threadPriority                  50
    maxNumIterations                1
    minRelCost                      0.1
    constraintTolerance             1e-3
    displayInfo                     false
    displayShortSummary             false
    checkNumericalStability         false
    debugPrintRollout               false
    debugCaching                    false
    AbsTolODE                       1e-5
    RelTolODE                       1e-3
    maxNumStepsPerSecond            100000
    timeStep                        1e-3
    backwardPassIntegratorType      ODE45
    constraintPenaltyInitialValue   20.0
    constraintPenaltyIncreaseRate   2.0
    preComputeRiccatiTerms          true
    useFeedbackPolicy               false
    strategy                        LINE_SEARCH
    lineSearch
    {
        minStepLength                   1e-2
        maxStepLength                   1.0
        hessianCorrectionStrategy       DIAGONAL_SHIFT
        hessianCorrectionMultiple       1e-3
    }
}

mpc
{
    timeHorizon                     1.0
    solutionTimeWindow              0.2
    coldStart                       false
    debugPrint                      false
    mpcDesiredFrequency             100
    mrtDesiredFrequency             500
}

rollout
{
    AbsTolODE                       1e-5
    RelTolODE                       1e-3
    timeStep                        1e-2
    integratorType                  ODE45
    maxNumStepsPerSecond            100000
    checkNumericalStability         false
}

bodyTrackingEE
{
    activate  false
    muPosition 5.0
    muOrientation 5.0
}

headTrackingEE
{
    activate  true
    muPosition 5.0
    muOrientation 5.0
}

; Input dim = 16 (no virtual SE(2) base)
inputCost
{
    R
    {
        arm
        {
            scaling 1e-3
            (0,0)   1.5     ; left proximal
            (1,1)   1.5
            (2,2)   1.5
            (3,3)   1.1
            (4,4)   1.1
            (5,5)   1.1
            (6,6)   1.1
            (7,7)   1.5     ; right proximal
            (8,8)   1.5
            (9,9)   1.5
            (10,10) 1.1
            (11,11) 1.1
            (12,12) 1.1
            (13,13) 1.1
            (14,14) 0.1     ; head_yaw
            (15,15) 0.1     ; head_pitch
        }
    }
}

endEffector
{
    muPosition                      10.0
    muOrientation                   5.0
}

finalEndEffector
{
    muPosition                      20.0
    muOrientation                   10.0
}

; Rigid torso — no body-relative band
bodyRelative
{
    activate                        false
}

bimanualCoupling
{
    activate                        true
    muPosition                      50.0
    muOrientation                   25.0
}

; [left(7) | right(7) | head(2)] via arm_base → head starts at 14
headInputStart                          14

waistLock
{
    activate                        false
    numJoints                       0
}

headCoupling
{
    activate                        false
}

; Head gaze: head_camera = ROS optical (+Z forward, +X right, +Y down).
; 2-DoF head → no muUpright. Intrinsics nominal D455 RGB 1280x720.
headMidpointGaze
{
    activate                    true
    cameraFrame                 "head_camera"
    fx                          644.0
    fy                          644.0
    cx                          640.0
    cy                          360.0
    width                       1280
    height                      720
    horizontalDeadbandDeg       10.0
    verticalDeadbandDeg         10.0
    muAlignmentHorizontal       1.0
    muAlignmentVertical         1.0
    muFront                     1.0
    minDepth                    0.3
}

homeJointReference
{
    activate                        true
    activateDefault                 true
    mu                              1e-3
    excludeJointIndices
    {
    }
}

armLock
{
    activate                        true
    leftNumJoints                   7
    rightNumJoints                  7
}

jointPositionLimits
{
    activate                        true
    mu                              1e-3
    delta                           1e-3
}

jointVelocityLimits
{
    mu                              1e-2
    delta                           1e-3
    lowerBound
    {
        arm
        {
            (0,0)  -3.14
            (1,0)  -3.14
            (2,0)  -3.14
            (3,0)  -3.14
            (4,0)  -3.14
            (5,0)  -3.14
            (6,0)  -3.14
            (7,0)  -3.14
            (8,0)  -3.14
            (9,0)  -3.14
            (10,0) -3.14
            (11,0) -3.14
            (12,0) -3.14
            (13,0) -3.14
            (14,0) -1.57    ; head_yaw
            (15,0) -1.0     ; head_pitch
        }
    }
    upperBound
    {
        arm
        {
            (0,0)  3.14
            (1,0)  3.14
            (2,0)  3.14
            (3,0)  3.14
            (4,0)  3.14
            (5,0)  3.14
            (6,0)  3.14
            (7,0)  3.14
            (8,0)  3.14
            (9,0)  3.14
            (10,0) 3.14
            (11,0) 3.14
            (12,0) 3.14
            (13,0) 3.14
            (14,0) 1.57     ; head_yaw
            (15,0) 1.0      ; head_pitch
        }
    }
}

selfCollision
{
    activate                        true
    mu                              1e-3
    delta                           1e-2
    minimumDistance                 0.01
    collisionObjectPairs
    {
    }
    collisionLinkPairs
    {
        [0] "base_link, left_elbow_Link",
        [1] "base_link, right_elbow_Link",
        [2] "base_2_Link, left_wrist_yaw_Link",
        [3] "base_2_Link, right_wrist_yaw_Link",
        [4] "left_wrist_yaw_Link, right_wrist_yaw_Link",
        [5] "left_grasper_base_Link, right_grasper_base_Link",
        [6] "base_2_Link, left_grasper_base_Link",
        [7] "base_2_Link, right_grasper_base_Link",
        [8] "base_2_Link, left_wrist_roll_Link",
        [9] "base_2_Link, right_wrist_roll_Link",
        [10] "base_link, left_wrist_yaw_Link",
        [11] "base_link, right_wrist_yaw_Link",
        [12] "base_2_Link, left_elbow_Link",
        [13] "base_2_Link, right_elbow_Link",
    }
}
