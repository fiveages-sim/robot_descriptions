        [5] "left_grasper_base_Link, right_grasper_base_Link",
        [6] "base_2_Link, left_grasper_base_Link",
        [7] "base_2_Link, right_grasper_base_Link",
        [8] "base_2_Link, left_wrist_roll_Link",
        [9] "base_2_Link, right_wrist_roll_Link",
        [10] "base_Link, left_wrist_yaw_Link",
        [11] "base_Link, right_wrist_yaw_Link",
