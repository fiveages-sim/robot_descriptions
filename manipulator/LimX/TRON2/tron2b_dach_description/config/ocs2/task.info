            (11,0)   -3.14
            (12,0)   -3.14
            (13,0)   -3.14
        }
    }
    upperBound
    {
        arm
        {
            (0,0)    3.14
            (1,0)    3.14
            (2,0)    3.14
            (3,0)    3.14
