#!/usr/bin/env python3
"""Apply the configured gripper positions while the arm controller is in HOME."""
from time import monotonic

import rclpy
import yaml
from ament_index_python.packages import get_package_share_path
from rclpy.impl.implementation_singleton import rclpy_implementation
from rclpy.executors import ExternalShutdownException
from rclpy.node import Node
from rclpy.qos import DurabilityPolicy, QoSProfile
from sensor_msgs.msg import JointState
from std_msgs.msg import Float64, Int32


class HomeGrippers(Node):
    def __init__(self):
        super().__init__("dach_tron2b_home_grippers")
        config = (get_package_share_path("dach_tron2b_description")
                  / "config/ros2_control/ros2_controllers.yaml")
        self.targets = yaml.safe_load(config.read_text())[
            "ocs2_arm_controller"]["ros__parameters"]["home_grippers"]
        self.commands = {
            name: self.create_publisher(Float64, f"/{name}/position_command", 10)
            for name in self.targets
        }
        self.feedback = {}
        self.in_home = False
        self.started = None
        self.create_subscription(Int32, "/fsm_state", self.on_mode,
                                 QoSProfile(depth=1, durability=DurabilityPolicy.TRANSIENT_LOCAL))
        self.create_subscription(JointState, "/joint_states", self.on_joints, 1)
        self.create_timer(0.04, self.update)

    def on_mode(self, msg):
        in_home = msg.data == 1
        if in_home != self.in_home:
            self.started = None
            self.in_home = in_home

    def on_joints(self, msg):
        now = monotonic()
        for name, position in zip(msg.name, msg.position):
            if name in self.targets:
                self.feedback[name] = (position, now)

    def update(self):
        now = monotonic()
        if not self.in_home or not all(
            name in self.feedback and now - self.feedback[name][1] < 1.5
            and publisher.get_subscription_count()
            for name, publisher in self.commands.items()
        ):
            return
        if self.started is None:
            self.initial = {name: self.feedback[name][0] for name in self.targets}
            self.started = now
        u = min(1.0, (now - self.started) / 1.5)
        weight = u**3 * (10.0 + u * (-15.0 + 6.0 * u))
        for name, publisher in self.commands.items():
            position = self.initial[name] + weight * (self.targets[name] - self.initial[name])
            publisher.publish(Float64(data=position))


def main():
    rclpy.init()
    node = HomeGrippers()
    try:
        rclpy.spin(node)
    except (KeyboardInterrupt, ExternalShutdownException):
        pass
    except rclpy_implementation.RCLError:
        if rclpy.ok():
            raise
    finally:
        node.destroy_node()
        rclpy.try_shutdown()


if __name__ == "__main__":
    main()
