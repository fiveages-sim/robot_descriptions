<?xml version="1.0"?>
<robot name="dach_tron2b_component" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="isaac" default="false"/>
  <xacro:property name="visual_ext" value="${'stl' if '$(arg isaac)' == 'true' else 'glb'}"/>
  <xacro:arg name="type" default="body"/>
  <xacro:arg name="side" default="L"/>

  <xacro:if value="${'$(arg type)' == 'body'}">
    <xacro:include filename="components/body.xacro"/>
    <xacro:DachTron2BBody visual_ext="${visual_ext}"/>
  </xacro:if>

  <xacro:if value="${'$(arg type)' == 'head'}">
    <xacro:include filename="components/head.xacro"/>
    <link name="base_Link"/>
    <xacro:DachTron2BHead parent="base_Link" visual_ext="${visual_ext}"/>
  </xacro:if>

  <xacro:if value="${'$(arg type)' == 'arm'}">
    <xacro:include filename="components/arm.xacro"/>
    <link name="base_Link"/>
    <xacro:DachTron2BArm side="$(arg side)" parent="base_Link" visual_ext="${visual_ext}"/>
  </xacro:if>

  <xacro:if value="${'$(arg type)' == 'gripper'}">
    <xacro:include filename="components/gripper.xacro"/>
    <link name="wrist_roll_$(arg side)_Link"/>
    <xacro:DachTron2BGripper side="$(arg side)" parent="wrist_roll_$(arg side)_Link" visual_ext="${visual_ext}"/>
  </xacro:if>
</robot>
