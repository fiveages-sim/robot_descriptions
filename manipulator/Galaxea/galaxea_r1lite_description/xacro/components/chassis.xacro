<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:property name="PI" value="3.1415926535897931"/>

    <xacro:macro name="Chassis" params="enable_wheel_joints:='true'">
        <xacro:property name="wheel_joints_enabled"
                        value="${str(enable_wheel_joints).lower() in ['true', '1', 'yes', 'on']}"/>
        <xacro:property name="steering_joint_type" value="${'revolute' if wheel_joints_enabled else 'fixed'}"/>
        <xacro:property name="driving_joint_type" value="${'continuous' if wheel_joints_enabled else 'fixed'}"/>

        <link name="base_link">
            <inertial>
                <origin xyz="0.0718033657159837 -0.0016279349766449 0.128750850965126"/>
                <mass value="25.114"/>
                <inertia
                        ixx="0.190993086908409"
                        ixy="7.01153963312701E-05"
                        ixz="-0.00785937977791519"
                        iyy="0.152035922355254"
                        iyz="-0.000494758898409346"
                        izz="0.29121889848538"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find galaxea_r1lite_description)/meshes/visual/base.glb"/>
                </geometry>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="file://$(find galaxea_r1lite_description)/meshes/collision/base.stl"/>
                </geometry>
            </collision>
        </link>

        <link name="steer_motor_link1">
            <inertial>
                <origin xyz="-1.76196610579549E-07 -7.75116053202478E-05 -0.0852489956386505"/>
                <mass value="1.5"/>
                <inertia
                        ixx="0.000338657650556839"
                        ixy="6.14197589167664E-09"
                        ixz="6.6056392682533E-09"
                        iyy="0.000503900951850049"
                        iyz="3.6051622873431E-08"
                        izz="0.000211486748436409"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find galaxea_r1lite_description)/meshes/visual/steer.glb"/>
                </geometry>
            </visual>
        </link>

        <joint name="steer_joint1" type="${steering_joint_type}">
            <origin xyz="0.29183 0 0.18165"/>
            <parent link="base_link"/>
            <child link="steer_motor_link1"/>
            <xacro:if value="${wheel_joints_enabled}">
                <axis xyz="0 0 1"/>
                <limit lower="${-PI}" upper="${PI}" effort="20" velocity="20"/>
            </xacro:if>
        </joint>

        <link name="wheel_motor_link1">
            <inertial>
                <origin xyz="0 -9.99250577455509E-13 -2.34534613952064E-15"/>
                <mass value="1.5"/>
                <inertia ixx="0.00104702497304016" ixy="2.02186210571336E-18" ixz="-8.67361737988254E-20" iyy="0.00181031135070458" iyz="3.54126040189266E-17" izz="0.00104702497304016"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find galaxea_r1lite_description)/meshes/visual/wheel.glb"/>
                </geometry>
            </visual>
            <collision>
                <origin rpy="${PI/2} 0 0"/>
                <geometry>
                    <cylinder length="0.0485" radius="0.07"/>
                </geometry>
            </collision>
        </link>

        <joint name="wheel_joint1" type="${driving_joint_type}">
            <origin xyz="0 0 -0.11165"/>
            <parent link="steer_motor_link1"/>
            <child link="wheel_motor_link1"/>
            <xacro:if value="${wheel_joints_enabled}">
                <axis xyz="0 1 0"/>
            </xacro:if>
        </joint>

        <link name="steer_motor_link2">
            <inertial>
                <origin xyz="1.76196610607304E-07 7.75116053202962E-05 -0.0852489956386505"/>
                <mass value="1.5"/>
                <inertia ixx="0.000338657650556839" ixy="6.1419758916829E-09" ixz="-6.6056392682485E-09" iyy="0.000503900951850049" iyz="-3.60516228734399E-08" izz="0.000211486748436408"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find galaxea_r1lite_description)/meshes/visual/steer.glb"/>
                </geometry>
            </visual>
        </link>

        <joint name="steer_joint2" type="${steering_joint_type}">
            <origin xyz="-0.16817 0.24 0.18165"/>
            <parent link="base_link"/>
            <child link="steer_motor_link2"/>
            <xacro:if value="${wheel_joints_enabled}">
                <axis xyz="0 0 1"/>
                <limit lower="${-PI}" upper="${PI}" effort="20" velocity="20"/>
            </xacro:if>
        </joint>

        <link name="wheel_motor_link2">
            <inertial>
                <origin xyz="2.77555756156289E-17 -1.94289029309402E-16 -2.34621350125863E-15"/>
                <mass value="1.5"/>
                <inertia ixx="0.00104702497304016" ixy="2.01102008398851E-18" ixz="-8.67361737988254E-20" iyy="0.00181031135070458" iyz="3.54092952964764E-17" izz="0.00104702497304016"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find galaxea_r1lite_description)/meshes/visual/wheel.glb"/>
                </geometry>
            </visual>
            <collision>
                <origin rpy="${PI/2} 0 0"/>
                <geometry>
                    <cylinder length="0.0485" radius="0.07"/>
                </geometry>
            </collision>
        </link>

        <joint name="wheel_joint2" type="${driving_joint_type}">
            <origin xyz="0 0 -0.11165"/>
            <parent link="steer_motor_link2"/>
            <child link="wheel_motor_link2"/>
            <xacro:if value="${wheel_joints_enabled}">
                <axis xyz="0 1 0"/>
            </xacro:if>
        </joint>

        <link name="steer_motor_link3">
            <inertial>
                <origin xyz="1.76196610579549E-07 7.75116053202407E-05 -0.0852489956386505"/>
                <mass value="1.5"/>
                <inertia ixx="0.000338657650556839" ixy="6.14197589167356E-09" ixz="-6.60563926825079E-09" iyy="0.000503900951850049" iyz="-3.60516228734413E-08" izz="0.000211486748436408"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find galaxea_r1lite_description)/meshes/visual/steer.glb"/>
                </geometry>
            </visual>
        </link>

        <joint name="steer_joint3" type="${steering_joint_type}">
            <origin xyz="-0.16817 -0.24 0.18165"/>
            <parent link="base_link"/>
            <child link="steer_motor_link3"/>
            <xacro:if value="${wheel_joints_enabled}">
                <axis xyz="0 0 1"/>
                <limit lower="${-PI}" upper="${PI}" effort="20" velocity="20"/>
            </xacro:if>
        </joint>

        <link name="wheel_motor_link3">
            <inertial>
                <origin xyz="0 -1.94289029309402E-16 -2.34274405430668E-15"/>
                <mass value="1.5"/>
                <inertia ixx="0.00104702497304016" ixy="2.00017806226365E-18" ixz="-8.67361737988255E-20" iyy="0.00181031135070458" iyz="3.53868224535946E-17" izz="0.00104702497304016"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find galaxea_r1lite_description)/meshes/visual/wheel.glb"/>
                </geometry>
            </visual>
            <collision>
                <origin rpy="${PI/2} 0 0"/>
                <geometry>
                    <cylinder length="0.0485" radius="0.07"/>
                </geometry>
            </collision>
        </link>

        <joint name="wheel_joint3" type="${driving_joint_type}">
            <origin xyz="0 0 -0.11165"/>
            <parent link="steer_motor_link3"/>
            <child link="wheel_motor_link3"/>
            <xacro:if value="${wheel_joints_enabled}">
                <axis xyz="0 1 0"/>
            </xacro:if>
        </joint>

    </xacro:macro>
</robot>
